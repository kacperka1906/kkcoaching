---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'pl';
  path?: string;
  altPath?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  lang = 'en',
  path = '/',
  altPath,
  structuredData,
  noindex = false,
  socialImage = '/images/kacper.png',
  socialImageAlt = 'KK Coaching - Kacper Kaszowski, Personal Trainer in Cwmbran'
} = Astro.props;

const siteUrl = 'https://kkcoaching.fit';
const canonical = `${siteUrl}${path}`;
const enPath = lang === 'en' ? path : (altPath ?? '/');
const plPath = lang === 'pl' ? path : (altPath ?? '/pl');
const enUrl = `${siteUrl}${enPath}`;
const plUrl = `${siteUrl}${plPath}`;
const xDefaultUrl = enUrl;
const socialImageUrl = socialImage.startsWith('http') ? socialImage : `${siteUrl}${socialImage}`;
const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <link rel="canonical" href={canonical} />

  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="pl" href={plUrl} />
  <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="KK Coaching" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImageUrl} />
  <meta property="og:image:alt" content={socialImageAlt} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pl_PL'} />
  <meta property="og:locale:alternate" content={lang === 'en' ? 'pl_PL' : 'en_GB'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageUrl} />
  <meta name="twitter:image:alt" content={socialImageAlt} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
</head>
<body>
  <a href="#main" class="skip-link">{lang === 'pl' ? 'Przejdź do treści głównej' : 'Skip to main content'}</a>
  <Header lang={lang} altPath={altPath} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <CookieBanner lang={lang} />
  <Analytics />

  <script is:inline>
    const identityHash = window.location.hash;
    const needsIdentityWidget = /(?:invite|recovery|confirmation)_token=/.test(identityHash);
    if (needsIdentityWidget) {
      const identityScript = document.createElement('script');
      identityScript.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
      identityScript.onload = () => {
        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('login', () => {
            window.location.href = '/admin/';
          });
        }
      };
      document.head.appendChild(identityScript);
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --graphite: #17191D;
    --red: #A51F2E;
    --red-hover: #8a1a27;
    --off-white: #F3F4F6;
    --steel: #454A52;
    --white: #FFFFFF;
    --radius: 4px;
    --max-width: 1160px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
  body {
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: var(--graphite);
    background: var(--off-white);
    line-height: 1.6;
    overflow-wrap: break-word;
    overflow-x: clip;
  }
  main { min-width: 0; }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  p, li { text-wrap: pretty; }
  section[id] { scroll-margin-top: 88px; }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    min-width: 0;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--red);
    color: var(--white);
    padding: 10px 16px;
    z-index: 100;
  }
  .skip-link:focus { left: 12px; top: 12px; }

  .btn {
    display: inline-block;
    padding: 14px 28px;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.25;
    letter-spacing: 0.02em;
    border: 2px solid transparent;
    cursor: pointer;
    text-align: center;
  }
  .btn-primary { background: var(--red); color: var(--white); }
  .btn-primary:hover { background: var(--red-hover); }
  .btn-secondary { background: transparent; color: var(--white); border-color: var(--white); }
  .btn-secondary:hover { background: rgba(255,255,255,0.1); }
  .btn-outline-dark { background: transparent; color: var(--graphite); border-color: var(--graphite); }
  .btn-outline-dark:hover { background: var(--graphite); color: var(--white); }

  section { padding: 88px 0; }
  section.tight { padding: 64px 0; }
  section.on-dark { background: var(--graphite); color: var(--white); }
  section.on-white { background: var(--white); }

  .section-head { max-width: 640px; margin-bottom: 48px; }
  .section-head.centered { margin-left: auto; margin-right: auto; text-align: center; }
  .eyebrow {
    color: var(--red);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: block;
  }
  h1, h2, h3 { line-height: 1.25; text-wrap: balance; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 14px; }
  .section-head p { color: var(--steel); font-size: 1.05rem; }
  section.on-dark .section-head p { color: #B7BBC1; }

  .transform-card img {
    width: 100%;
    height: auto !important;
    aspect-ratio: auto !important;
    object-fit: contain !important;
    background: var(--graphite);
  }

  /* Internal replacement labels stay out of the public-facing UI. */
  .image-note { display: none !important; }

  @media (max-width: 620px) {
    .container { padding-left: 18px; padding-right: 18px; }
    section { padding: 58px 0; }
    section.tight { padding: 46px 0; }
    .section-head { margin-bottom: 30px; }
    .section-head p { font-size: 0.98rem; }
    .eyebrow { font-size: 0.74rem; letter-spacing: 0.1em; }
    h2 { font-size: clamp(1.5rem, 7vw, 1.95rem); }
    .btn { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; }
    .center-cta .btn,
    .final-cta .btn { width: 100%; max-width: 420px; }
    .center-cta { display: flex; justify-content: center; }
    .faq-item summary { min-height: 48px; display: flex; align-items: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>

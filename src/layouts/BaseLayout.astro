---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'pl';
  path?: string;
  altPath?: string;
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
}

const {
  title,
  description,
  lang = 'en',
  path = '/',
  altPath,
  structuredData,
  noindex = false,
  socialImage,
  socialImageAlt,
  ogType,
  articlePublishedTime,
  articleModifiedTime
} = Astro.props;

const siteUrl = 'https://kkcoaching.fit';
const normalizedPath = path.replace(/\/+$/, '') || '/';
const canonical = `${siteUrl}${path}`;
const hasLocalizedAlternate = Boolean(altPath);
const enPath = lang === 'en' ? path : (altPath ?? path);
const plPath = lang === 'pl' ? path : (altPath ?? path);
const enUrl = `${siteUrl}${enPath}`;
const plUrl = `${siteUrl}${plPath}`;
const xDefaultUrl = enUrl;
const isResourceArticle = normalizedPath.startsWith('/resources/') || normalizedPath.startsWith('/pl/resources/');
const resolvedOgType = ogType ?? (isResourceArticle ? 'article' : 'website');

const preferredSocialImages: Record<string, string> = {
  '/personal-training-cwmbran': '/images/kacper.jpg',
  '/pl/personal-training-cwmbran': '/images/kacper.jpg',
  '/online-coaching': '/images/kacper.jpg',
  '/pl/online-coaching': '/images/kacper.jpg',
  '/hybrid-coaching': '/images/kacper.jpg',
  '/pl/hybrid-coaching': '/images/kacper.jpg',
  '/transformations': '/images/photo-collage-source.png',
  '/pl/transformations': '/images/photo-collage-source.png',
  '/about': '/images/kacper-gym-physique.webp',
  '/pl/about': '/images/kacper-gym-physique.webp',
  '/resources': '/images/kacper.jpg',
  '/pl/resources': '/images/kacper.jpg',
  '/resources/choosing-personal-trainer-cwmbran': '/images/kacper.jpg',
  '/pl/resources/jak-wybrac-trenera-personalnego-cwmbran': '/images/kacper.jpg',
  '/resources/online-personal-training-uk': '/images/kacper.jpg',
  '/pl/resources/trener-personalny-online-uk-jak-to-dziala': '/images/kacper.jpg'
};

const preferredSocialAlts: Record<string, string> = {
  '/personal-training-cwmbran': 'Kacper Kaszowski, personal trainer in Cwmbran and founder of KK Coaching',
  '/pl/personal-training-cwmbran': 'Kacper Kaszowski, trener personalny w Cwmbran i założyciel KK Coaching',
  '/online-coaching': 'Kacper Kaszowski, founder of KK Coaching and online fitness coach',
  '/pl/online-coaching': 'Kacper Kaszowski, trener personalny online i założyciel KK Coaching',
  '/hybrid-coaching': 'Kacper Kaszowski, KK Coaching personal trainer in Cwmbran and online coach',
  '/pl/hybrid-coaching': 'Kacper Kaszowski, treningi 1:1 w Cwmbran i prowadzenie online',
  '/transformations': 'KK Coaching client transformations and progress',
  '/pl/transformations': 'Przemiany i efekty podopiecznych KK Coaching',
  '/about': 'Kacper Kaszowski, founder of KK Coaching',
  '/pl/about': 'Kacper Kaszowski, założyciel KK Coaching',
  '/resources': 'Kacper Kaszowski, KK Coaching fitness and personal training guides',
  '/pl/resources': 'Kacper Kaszowski, poradniki treningowe KK Coaching',
  '/resources/choosing-personal-trainer-cwmbran': 'Kacper Kaszowski, author of the KK Coaching guide to choosing a personal trainer in Cwmbran',
  '/pl/resources/jak-wybrac-trenera-personalnego-cwmbran': 'Kacper Kaszowski, autor poradnika o wyborze trenera personalnego w Cwmbran',
  '/resources/online-personal-training-uk': 'Kacper Kaszowski, author of the KK Coaching guide to online personal training in the UK',
  '/pl/resources/trener-personalny-online-uk-jak-to-dziala': 'Kacper Kaszowski, autor poradnika o trenerze personalnym online w UK'
};

const resolvedSocialImage = socialImage ?? preferredSocialImages[normalizedPath] ?? '/images/kacper.jpg';
const resolvedSocialImageAlt = socialImageAlt ?? preferredSocialAlts[normalizedPath] ?? 'KK Coaching - Kacper Kaszowski, Personal Trainer in Cwmbran';
const socialImageUrl = resolvedSocialImage.startsWith('http') ? resolvedSocialImage : `${siteUrl}${resolvedSocialImage}`;

const breadcrumbMap: Record<string, Array<{ name: string; href?: string }>> = {
  '/services': [
    { name: 'Home', href: '/' },
    { name: 'Coaching Options' }
  ],
  '/personal-training-cwmbran': [
    { name: 'Home', href: '/' },
    { name: 'Coaching Options', href: '/services' },
    { name: 'Personal Training Cwmbran' }
  ],
  '/online-coaching': [
    { name: 'Home', href: '/' },
    { name: 'Coaching Options', href: '/services' },
    { name: 'Online Coaching' }
  ],
  '/hybrid-coaching': [
    { name: 'Home', href: '/' },
    { name: 'Coaching Options', href: '/services' },
    { name: 'Hybrid Coaching' }
  ],
  '/transformations': [
    { name: 'Home', href: '/' },
    { name: 'Client Results' }
  ],
  '/resources': [
    { name: 'Home', href: '/' },
    { name: 'Fitness Guides' }
  ],
  '/resources/choosing-personal-trainer-cwmbran': [
    { name: 'Home', href: '/' },
    { name: 'Fitness Guides', href: '/resources' },
    { name: 'Choosing a Personal Trainer in Cwmbran' }
  ],
  '/resources/online-personal-training-uk': [
    { name: 'Home', href: '/' },
    { name: 'Fitness Guides', href: '/resources' },
    { name: 'Online Personal Training in the UK' }
  ],
  '/about': [
    { name: 'Home', href: '/' },
    { name: 'About' }
  ],
  '/contact': [
    { name: 'Home', href: '/' },
    { name: 'Contact' }
  ],
  '/pl/services': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Współpraca' }
  ],
  '/pl/personal-training-cwmbran': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Współpraca', href: '/pl/services' },
    { name: 'Trener personalny Cwmbran' }
  ],
  '/pl/online-coaching': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Współpraca', href: '/pl/services' },
    { name: 'Trener personalny online' }
  ],
  '/pl/hybrid-coaching': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Współpraca', href: '/pl/services' },
    { name: 'Treningi 1:1 + prowadzenie online' }
  ],
  '/pl/transformations': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Przemiany' }
  ],
  '/pl/resources': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Poradniki' }
  ],
  '/pl/resources/jak-wybrac-trenera-personalnego-cwmbran': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Poradniki', href: '/pl/resources' },
    { name: 'Jak wybrać trenera personalnego w Cwmbran' }
  ],
  '/pl/resources/trener-personalny-online-uk-jak-to-dziala': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Poradniki', href: '/pl/resources' },
    { name: 'Trener personalny online w UK' }
  ],
  '/pl/about': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'O mnie' }
  ],
  '/pl/contact': [
    { name: 'Strona główna', href: '/pl' },
    { name: 'Kontakt' }
  ]
};

const breadcrumbs = breadcrumbMap[normalizedPath] ?? [];
const pageProvidesBreadcrumbSchema =
  normalizedPath === '/resources' ||
  normalizedPath.startsWith('/resources/') ||
  normalizedPath === '/pl/resources' ||
  normalizedPath.startsWith('/pl/resources/');
const breadcrumbStructuredData = breadcrumbs.length >= 2 && !pageProvidesBreadcrumbSchema
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        ...(item.href ? { item: `${siteUrl}${item.href}` } : {})
      }))
    }
  : null;

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#17191D" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robotsContent} />
  <link rel="canonical" href={canonical} />

  {hasLocalizedAlternate && (
    <>
      <link rel="alternate" hreflang="en" href={enUrl} />
      <link rel="alternate" hreflang="pl" href={plUrl} />
      <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    </>
  )}

  <meta property="og:type" content={resolvedOgType} />
  <meta property="og:site_name" content="KK Coaching" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={socialImageUrl} />
  <meta property="og:image:alt" content={resolvedSocialImageAlt} />
  <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'pl_PL'} />
  <meta property="og:locale:alternate" content={lang === 'en' ? 'pl_PL' : 'en_GB'} />
  {resolvedOgType === 'article' && articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
  {resolvedOgType === 'article' && articleModifiedTime && <meta property="article:modified_time" content={articleModifiedTime} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={socialImageUrl} />
  <meta name="twitter:image:alt" content={resolvedSocialImageAlt} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}
  {breadcrumbStructuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructuredData)} />
  )}
</head>
<body>
  <a href="#main" class="skip-link">{lang === 'pl' ? 'Przejdź do treści głównej' : 'Skip to main content'}</a>
  <Header lang={lang} altPath={altPath} />
  <main id="main">
    {breadcrumbs.length >= 2 && (
      <nav class="breadcrumb-bar" aria-label={lang === 'pl' ? 'Ścieżka nawigacji' : 'Breadcrumb'}>
        <div class="container breadcrumb-inner">
          {breadcrumbs.map((item, index) => (
            <>
              {index > 0 && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
              {item.href
                ? <a href={item.href}>{item.name}</a>
                : <span aria-current="page">{item.name}</span>}
            </>
          ))}
        </div>
      </nav>
    )}
    <slot />
  </main>
  <Footer lang={lang} />
  <CookieBanner lang={lang} />
  <Analytics />

  <script is:inline>
    const identityHash = window.location.hash;
    const needsIdentityWidget = /(?:invite|recovery|confirmation)_token=/.test(identityHash);
    if (needsIdentityWidget) {
      const identityScript = document.createElement('script');
      identityScript.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
      identityScript.onload = () => {
        if (window.netlifyIdentity) {
          window.netlifyIdentity.on('login', () => {
            window.location.href = '/admin/';
          });
        }
      };
      document.head.appendChild(identityScript);
    }
  </script>
</body>
</html>

<style is:global>
  :root {
    --graphite: #17191D;
    --red: #A51F2E;
    --red-hover: #8a1a27;
    --off-white: #F3F4F6;
    --steel: #454A52;
    --white: #FFFFFF;
    --radius: 4px;
    --max-width: 1160px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
  body {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    color: var(--graphite);
    background: var(--off-white);
    line-height: 1.6;
    overflow-wrap: break-word;
    overflow-x: hidden;
  }
  main {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: hidden;
  }
  main *, .site-header *, footer * { min-width: 0; }
  img, svg, video, canvas, iframe { max-width: 100%; display: block; }
  img { height: auto; }
  a { color: inherit; }
  h1, h2, h3, p, li, a, button, span, strong { overflow-wrap: anywhere; }
  p, li { text-wrap: pretty; }
  section[id] { scroll-margin-top: 88px; }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    min-width: 0;
  }

  .breadcrumb-bar {
    max-width: 100%;
    background: #111317;
    color: #AEB3BA;
    border-top: 1px solid #24282E;
    border-bottom: 1px solid #24282E;
  }
  .breadcrumb-inner {
    max-width: 100%;
    min-height: 42px;
    display: flex;
    align-items: center;
    gap: 9px;
    overflow-x: auto;
    white-space: nowrap;
    font-size: 0.76rem;
  }
  .breadcrumb-inner a {
    color: #CDD1D6;
    text-decoration: none;
  }
  .breadcrumb-inner a:hover { color: var(--white); }
  .breadcrumb-inner [aria-current="page"] { color: #8F959D; }
  .breadcrumb-separator { color: #5C626B; }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--red);
    color: var(--white);
    padding: 10px 16px;
    z-index: 100;
  }
  .skip-link:focus { left: 12px; top: 12px; }

  .btn {
    display: inline-block;
    max-width: 100%;
    padding: 14px 28px;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.25;
    letter-spacing: 0.02em;
    border: 2px solid transparent;
    cursor: pointer;
    text-align: center;
  }
  .btn-primary { background: var(--red); color: var(--white); }
  .btn-primary:hover { background: var(--red-hover); }
  .btn-secondary { background: transparent; color: var(--white); border-color: var(--white); }
  .btn-secondary:hover { background: rgba(255,255,255,0.1); }
  .btn-outline-dark { background: transparent; color: var(--graphite); border-color: var(--graphite); }
  .btn-outline-dark:hover { background: var(--graphite); color: var(--white); }

  section { width: 100%; max-width: 100%; padding: 88px 0; }
  section.tight { padding: 64px 0; }
  section.on-dark { background: var(--graphite); color: var(--white); }
  section.on-white { background: var(--white); }

  .section-head { max-width: 640px; margin-bottom: 48px; }
  .section-head.centered { margin-left: auto; margin-right: auto; text-align: center; }
  .eyebrow {
    color: var(--red);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 10px;
    display: block;
  }
  h1, h2, h3 { line-height: 1.25; text-wrap: balance; }
  h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 14px; }
  .section-head p { color: var(--steel); font-size: 1.05rem; }
  section.on-dark .section-head p { color: #B7BBC1; }

  .transform-card img {
    width: 100%;
    height: auto !important;
    aspect-ratio: auto !important;
    object-fit: contain !important;
    background: var(--graphite);
  }

  /* Internal replacement labels stay out of the public-facing UI. */
  .image-note { display: none !important; }

  @media (max-width: 620px) {
    .container { padding-left: 18px; padding-right: 18px; }
    .breadcrumb-inner { min-height: 38px; font-size: 0.7rem; gap: 7px; }
    section { padding: 58px 0; }
    section.tight { padding: 46px 0; }
    .section-head { margin-bottom: 30px; }
    .section-head p { font-size: 0.98rem; }
    .eyebrow { font-size: 0.74rem; letter-spacing: 0.1em; }
    h2 { font-size: clamp(1.5rem, 7vw, 1.95rem); }
    .btn { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; }
    .center-cta .btn,
    .final-cta .btn { width: 100%; max-width: 420px; }
    .center-cta { display: flex; justify-content: center; }
    .faq-item summary { min-height: 48px; display: flex; align-items: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>

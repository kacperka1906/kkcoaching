---
import pricing from '../data/pricing.json';

interface Props {
  title: string;
  tagline: string;
  bullets: string[];
  ctaLabel: string;
  ctaTarget: string;
  image: string;
  imageAlt: string;
  minor?: boolean;
  serviceKey?: string;
  lang?: 'en' | 'pl';
}

const {
  title,
  tagline,
  bullets,
  ctaLabel,
  ctaTarget,
  image,
  imageAlt,
  minor = false,
  serviceKey = '',
  lang = 'en'
} = Astro.props;

const isPl = lang === 'pl';
const identity = `${serviceKey} ${ctaTarget} ${image} ${title}`;
const fallbackHybrid = /hybrid|hybryd|1:1.*online|online.*1:1/i.test(identity);
const fallbackOnline = !fallbackHybrid && /online-coaching|online/i.test(identity);
const fallbackTrainingPlan = !fallbackHybrid && !fallbackOnline && /training-plan|personalised-training-plan|training plan|plan treningowy/i.test(identity);
const fallbackPersonal = !fallbackHybrid && !fallbackOnline && !fallbackTrainingPlan && /personal-training|personal|trening personalny/i.test(identity);

const type = serviceKey === 'hybrid-coaching' || fallbackHybrid
  ? 'hybrid'
  : serviceKey === 'online-coaching' || fallbackOnline
    ? 'online'
    : serviceKey === 'training-plan' || fallbackTrainingPlan
      ? 'trainingPlan'
      : serviceKey === 'personal-training' || fallbackPersonal
        ? 'personal'
        : 'other';

const currency = pricing.currency;
const money = (value: number) => `${currency}${Number.isInteger(value) ? value.toFixed(0) : value.toFixed(2)}`;
const activePersonal = pricing.personal.packages.filter(plan => plan.enabled && plan.sessions > 0);
const activeHybrid = pricing.hybrid.packages.filter(plan => plan.enabled);
const lowestPersonalRate = activePersonal.length
  ? Math.min(...activePersonal.map(plan => plan.price / plan.sessions))
  : null;
const lowestHybrid = activeHybrid.length
  ? activeHybrid.reduce((lowest, plan) => plan.price < lowest.price ? plan : lowest)
  : null;

const badgeEnabled = type === 'hybrid' && pricing.hybrid.homeBadgeEnabled;
const badgeLabel = badgeEnabled ? pricing.hybrid.homeBadge[lang] : '';
const fromLabel = pricing.labels.from[lang];
const oneOffLabel = pricing.labels.oneOff[lang];
const priceLabel = type === 'hybrid' && lowestHybrid
  ? (isPl ? `${fromLabel} ${money(lowestHybrid.price)} / ${lowestHybrid.weeks} tygodnie` : `${fromLabel} ${money(lowestHybrid.price)} / ${lowestHybrid.weeks} weeks`)
  : type === 'online' && pricing.online.enabled
    ? (isPl ? `${money(pricing.online.price)} / ${pricing.online.billingWeeks} tygodnie` : `${money(pricing.online.price)} / ${pricing.online.billingWeeks} weeks`)
    : type === 'personal' && lowestPersonalRate !== null
      ? (isPl ? `${fromLabel} ${money(lowestPersonalRate)} / trening` : `${fromLabel} ${money(lowestPersonalRate)} / session`)
      : type === 'trainingPlan' && pricing.trainingPlan.enabled
        ? `${money(pricing.trainingPlan.price)} · ${oneOffLabel}`
        : '';
---
<article class:list={['service-card', { minor, featured: badgeEnabled }]}>
  <div class="media-wrap">
    <img src={image} alt={imageAlt} width="400" height="250" loading="lazy" decoding="async" />
    {badgeEnabled && <span class="service-badge">{badgeLabel}</span>}
  </div>
  <div class="service-body">
    <h3>{title}</h3>
    {priceLabel && <p class="service-price">{priceLabel}</p>}
    <p>{tagline}</p>
    <ul>
      {bullets.map(b => <li>{b}</li>)}
    </ul>
    <a href={ctaTarget} class:list={['btn', minor ? 'btn-outline-dark' : 'btn-primary']}>{ctaLabel}</a>
  </div>
</article>

<style>
  .service-card {
    background: var(--white);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid #E3E5E8;
    display: flex;
    flex-direction: column;
    min-width: 0;
    position: relative;
  }
  .service-card.featured {
    border: 2px solid var(--red);
    box-shadow: 0 12px 30px rgba(23, 25, 29, 0.1);
  }
  .media-wrap { position: relative; overflow: hidden; background: #111317; }
  .service-card img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .service-badge {
    position: absolute;
    left: 14px;
    top: 14px;
    background: var(--red);
    color: var(--white);
    border-radius: 999px;
    padding: 7px 11px;
    font-size: 0.68rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(0,0,0,0.22);
  }
  .service-body { padding: 24px; display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .service-body h3 { font-size: 1.2rem; margin-bottom: 8px; }
  .featured .service-body h3 { color: var(--red); }
  .service-price {
    color: var(--red) !important;
    font-size: 1.04rem !important;
    line-height: 1.25;
    font-weight: 800;
    margin-bottom: 10px;
  }
  .service-body p { color: var(--steel); font-size: 0.95rem; }
  .service-body ul { list-style: none; margin: 14px 0 22px; font-size: 0.9rem; color: var(--steel); }
  .service-body ul li { padding-left: 18px; position: relative; margin-bottom: 6px; }
  .service-body ul li::before {
    content: ""; position: absolute; left: 0; top: 9px;
    width: 6px; height: 6px; background: var(--red); border-radius: 50%;
  }
  .service-body .btn { margin-top: auto; align-self: flex-start; }
  .service-card.minor { opacity: 0.92; }

  @media (max-width: 620px) {
    .service-body { padding: 22px 18px; }
    .service-body h3 { font-size: 1.12rem; }
    .service-price { font-size: 1rem !important; }
    .service-body p { font-size: 0.92rem; }
    .service-body ul { font-size: 0.88rem; }
    .service-body .btn { width: 100%; align-self: stretch; }
    .service-badge { left: 12px; top: 12px; font-size: 0.64rem; }
    .service-card.featured { box-shadow: 0 8px 22px rgba(23, 25, 29, 0.08); }
  }
</style>

<style is:global>
  main .service-grid.service-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    main .service-grid.service-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

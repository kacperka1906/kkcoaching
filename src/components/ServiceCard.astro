---
interface Props {
  title: string;
  tagline: string;
  bullets: string[];
  ctaLabel: string;
  ctaTarget: string;
  image: string;
  imageAlt: string;
  minor?: boolean;
}
const { title, tagline, bullets, ctaLabel, ctaTarget, image, imageAlt, minor = false } = Astro.props;
---
<article class:list={["service-card", { minor }] }>
  <img class="service-image" src={image} alt={imageAlt} width="640" height="420" loading="lazy" />
  <div class="service-body">
    <h3>{title}</h3>
    <p class="tagline">{tagline}</p>
    <ul>
      {bullets.map(item => <li>{item}</li>)}
    </ul>
    <a href={ctaTarget} class="btn btn-primary service-cta">{ctaLabel}</a>
  </div>
</article>

<style>
  .service-card {
    background: #202329;
    border: 1px solid #333840;
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .service-card.minor { opacity: 0.94; }
  .service-image { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #17191D; }
  .service-body { padding: 26px; display: flex; flex-direction: column; flex: 1; }
  .service-body h3 { color: var(--white); font-size: 1.18rem; margin-bottom: 10px; }
  .tagline { color: #C3C7CD; font-size: 0.94rem; margin-bottom: 18px; }
  ul { list-style: none; display: grid; gap: 9px; margin-bottom: 24px; }
  li { color: #E7E9EC; font-size: 0.9rem; padding-left: 19px; position: relative; }
  li::before { content: '✓'; color: #E25766; font-weight: 800; position: absolute; left: 0; }
  .service-cta { margin-top: auto; align-self: flex-start; }

  @media (max-width: 620px) {
    .service-body { padding: 22px 18px; }
    .service-body h3 { font-size: 1.12rem; }
    .tagline { font-size: 0.92rem; }
    li { font-size: 0.88rem; }
    .service-cta { width: 100%; align-self: stretch; }
  }
</style>

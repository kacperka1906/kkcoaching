---
interface Props {
  lang: 'en' | 'pl';
  pathname: string;
}

const { lang, pathname } = Astro.props;

const labels = {
  en: {
    eyebrow: 'More ways to work together',
    heading: 'Explore other coaching options',
    body: 'Not sure this is the right level of support? Compare the other ways I can help you train with a clear plan and measurable progression.',
    guides: 'Read practical fitness & coaching guides →'
  },
  pl: {
    eyebrow: 'Inne formy współpracy',
    heading: 'Zobacz pozostałe opcje coachingu',
    body: 'Nie wiesz, czy ta opcja jest dla Ciebie? Porównaj pozostałe formy współpracy i wybierz poziom wsparcia dopasowany do Twojego celu i tygodnia.',
    guides: 'Przeczytaj praktyczne poradniki treningowe →'
  }
};

const options = lang === 'pl'
  ? [
      { href: '/pl/personal-training-cwmbran', title: 'Trening personalny 1:1 w Cwmbran', body: 'Sesje na żywo w JD Gyms Cwmbran, technika, plan i progresja.' },
      { href: '/pl/online-coaching', title: 'Coaching online', body: 'Plan treningowy, żywienie, raporty, analiza postępów i stałe wsparcie.' },
      { href: '/pl/hybrid-coaching', title: 'Coaching hybrydowy', body: 'Pełne prowadzenie online połączone z regularnymi treningami 1:1.' },
      { href: '/pl/training-plan', title: 'Indywidualny plan treningowy', body: 'Jednorazowy plan dopasowany do celu, doświadczenia, sprzętu i grafiku.' }
    ]
  : [
      { href: '/personal-training-cwmbran', title: '1:1 Personal Training in Cwmbran', body: 'Face-to-face sessions at JD Gyms Cwmbran with technique coaching, programming and progression.' },
      { href: '/online-coaching', title: 'Online Coaching', body: 'Individual training, nutrition targets, check-ins, progress analysis and ongoing support.' },
      { href: '/hybrid-coaching', title: 'Hybrid Coaching', body: 'Full online coaching combined with regular 1:1 personal training sessions.' },
      { href: '/training-plan', title: 'Personalised Training Plan', body: 'A one-off programme built around your goal, experience, equipment and weekly schedule.' }
    ];

const current = pathname.replace(/\/+$/, '') || '/';
const visibleOptions = options.filter(option => option.href !== current);
const canRender = options.some(option => option.href === current);
const resourcesHref = lang === 'pl' ? '/pl/resources' : '/resources';
---
{canRender && (
  <aside class="related-coaching on-white" aria-labelledby={`related-coaching-${lang}`}>
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">{labels[lang].eyebrow}</span>
        <h2 id={`related-coaching-${lang}`}>{labels[lang].heading}</h2>
        <p>{labels[lang].body}</p>
      </div>
      <div class="related-grid">
        {visibleOptions.map(option => (
          <a class="related-card" href={option.href}>
            <h3>{option.title}</h3>
            <p>{option.body}</p>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
      <div class="related-guides"><a href={resourcesHref}>{labels[lang].guides}</a></div>
    </div>
  </aside>
)}

<style>
  .related-coaching { border-top: 1px solid #E3E5E8; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .related-card { position: relative; display: block; min-width: 0; padding: 24px 52px 24px 22px; border: 1px solid #E1E4E8; border-top: 3px solid var(--red); border-radius: var(--radius); background: var(--white); color: inherit; text-decoration: none; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .related-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(20,22,26,.07); border-color: #D5D8DC; }
  .related-card h3 { margin-bottom: 9px; font-size: 1rem; }
  .related-card p { color: var(--steel); font-size: .9rem; line-height: 1.55; }
  .related-card > span { position: absolute; top: 22px; right: 20px; color: var(--red); font-size: 1.25rem; font-weight: 800; }
  .related-guides { text-align: center; margin-top: 24px; }
  .related-guides a { color: var(--red); font-weight: 800; text-decoration: none; }
  @media (max-width: 820px) { .related-grid { grid-template-columns: 1fr; } }
</style>

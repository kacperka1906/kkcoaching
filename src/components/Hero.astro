---
interface Props {
  heading: string;
  lead: string;
  ctaPrimary: string;
  ctaPrimaryHref: string;
  ctaSecondary: string;
  ctaSecondaryHref: string;
  trustLine: string;
  image: string;
  imageAlt: string;
}
const { heading, lead, ctaPrimary, ctaPrimaryHref, ctaSecondary, ctaSecondaryHref, trustLine, image, imageAlt } = Astro.props;
---
<section class="hero" aria-labelledby="hero-heading">
  <img class="hero-photo" src={image} alt={imageAlt} width="768" height="1024" />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <h1 id="hero-heading">{heading}</h1>
      <p class="lead">{lead}</p>
      <div class="hero-ctas">
        <a href={ctaPrimaryHref} class="btn btn-primary">{ctaPrimary}</a>
        <a href={ctaSecondaryHref} class="btn btn-secondary">{ctaSecondary}</a>
      </div>
      <p class="trust-line">{trustLine}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    background: var(--graphite); /* fallback if the photo fails to load */
  }

  /* Mobile-first: photo fills the entire section as a background. */
  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    z-index: 0;
  }

  /* Dark gradient overlay so hero-copy stays legible on top of the photo on mobile. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(23, 25, 29, 0) 0%,
      rgba(23, 25, 29, 0.25) 35%,
      rgba(23, 25, 29, 0.92) 75%,
      var(--graphite) 100%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 40vh;
    padding-bottom: 48px;
  }

  .hero-copy { max-width: 560px; }
  .hero h1 { font-size: clamp(2rem, 4.2vw, 3.1rem); line-height: 1.15; margin-bottom: 20px; color: var(--white); }
  .hero p.lead { color: #C7CBD1; font-size: 1.1rem; max-width: 46ch; margin-bottom: 32px; }
  .hero-ctas { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 28px; }
  .trust-line { color: #9CA1A8; font-size: 0.85rem; letter-spacing: 0.02em; }

  /* Desktop: photo shrinks to its own portrait proportions and anchors to the right
     edge of the section (full-bleed, not the .container). A dark-to-red gradient
     fills the rest of the section behind the text, and the photo's left edge blends
     into that gradient via a mask instead of ending in a hard vertical line. */
  @media (min-width: 861px) {
    .hero {
      min-height: 760px;
      align-items: center;
    }

    .hero-photo {
      inset: 0 0 0 auto;
      left: auto;
      width: auto;
      height: 100%;
      aspect-ratio: 3 / 4;
      z-index: 1;
      mask-image: linear-gradient(to left, black 55%, transparent 100%);
      -webkit-mask-image: linear-gradient(to left, black 55%, transparent 100%);
    }

    .hero-scrim {
      z-index: 0;
      background: linear-gradient(100deg, var(--graphite) 0%, var(--graphite) 30%, var(--red) 100%);
    }

    .hero-inner { padding-top: 72px; padding-bottom: 72px; }
  }
</style>

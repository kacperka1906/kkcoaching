---
interface Props {
  heading: string;
  lead: string;
  ctaPrimary: string;
  ctaPrimaryHref: string;
  ctaSecondary: string;
  ctaSecondaryHref: string;
  trustLine: string;
  image: string;
  imageAlt: string;
  campaign?: { eyebrow: string; title: string; description: string; href: string; buttonLabel: string };
}
const { heading, lead, ctaPrimary, ctaPrimaryHref, ctaSecondary, ctaSecondaryHref, trustLine, image, imageAlt, campaign } = Astro.props;
---
<section class="hero" aria-labelledby="hero-heading">
  <img class="hero-photo" src={image} alt={imageAlt} width="768" height="1024" loading="eager" fetchpriority="high" decoding="async" />
  <div class="hero-scrim" aria-hidden="true"></div>
  {campaign && (
    <a class="campaign-mobile-banner" href={campaign.href} aria-label="MOJA KOLEJ 2027 — zapisy otwarte, poznaj program">
      <strong>{campaign.title}</strong><span>Zapisy otwarte <span aria-hidden="true">↗</span></span>
    </a>
  )}
  <div class="container hero-inner">
    <div class="hero-copy">
      {campaign && (
        <aside class="campaign-spotlight" aria-label="Nowość w KK Coaching">
          <div class="campaign-spotlight-copy">
            <span class="campaign-eyebrow"><span class="campaign-pulse" aria-hidden="true"></span>{campaign.eyebrow}</span>
            <strong>{campaign.title}</strong>
            <p>{campaign.description}</p>
          </div>
          <a class="campaign-spotlight-link" href={campaign.href}>{campaign.buttonLabel}<span aria-hidden="true">↗</span></a>
        </aside>
      )}
      <h1 id="hero-heading">{heading}</h1>
      <p class="lead">{lead}</p>
      <div class="hero-ctas">
        <a href={ctaPrimaryHref} class="btn btn-primary">{ctaPrimary}</a>
        <a href={ctaSecondaryHref} class="btn btn-secondary">{ctaSecondary}</a>
      </div>
      <p class="trust-line">{trustLine}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: min(100svh, 860px);
    background: var(--graphite);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    z-index: 0;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgba(23, 25, 29, 0.02) 0%,
      rgba(23, 25, 29, 0.20) 31%,
      rgba(23, 25, 29, 0.78) 62%,
      rgba(23, 25, 29, 0.97) 86%,
      var(--graphite) 100%
    );
  }

  .campaign-mobile-banner {display:none;}
  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-top: 38vh;
    padding-bottom: 42px;
  }

  .hero-copy { max-width: 560px; }
  .hero h1 { font-size: clamp(2rem, 4.2vw, 3.1rem); line-height: 1.12; margin-bottom: 18px; color: var(--white); }
  .hero p.lead { color: #D3D6DA; font-size: 1.05rem; max-width: 46ch; margin-bottom: 26px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 22px; }
  .trust-line { color: #AEB3BA; font-size: 0.82rem; line-height: 1.5; letter-spacing: 0.01em; }
  .campaign-spotlight {display:flex;align-items:center;justify-content:space-between;gap:22px;max-width:660px;margin:0 0 28px;padding:17px 20px;background:rgba(20,21,24,.9);border:1px solid rgba(252,119,135,.63);border-left:4px solid #ee4057;box-shadow:0 12px 32px rgba(0,0,0,.18);border-radius:5px;}
  .campaign-spotlight-copy {min-width:0;}
  .campaign-eyebrow {display:flex;align-items:center;gap:8px;color:#ffc6cf;font-size:.65rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;margin-bottom:5px;}
  .campaign-pulse {width:7px;height:7px;border-radius:50%;background:#fa7081;flex:0 0 7px;}
  .campaign-spotlight strong {display:block;color:#fff;font-size:1.35rem;letter-spacing:-.02em;line-height:1.15;}
  .campaign-spotlight p {font-size:.83rem;color:#f1dfe1;line-height:1.5;margin:7px 0 0;}
  .campaign-spotlight-link {flex:0 0 auto;display:flex;align-items:center;justify-content:center;gap:10px;text-align:center;text-decoration:none;color:#fff;background:#ad2135;font-size:.83rem;font-weight:800;border-radius:4px;padding:13px 15px;min-height:46px;}
  .campaign-spotlight-link:hover {color:#fff;background:#c22c44;}
  .campaign-spotlight-link:focus-visible {outline:3px solid #fff;outline-offset:3px;}


  @media (max-width: 620px) {
    .campaign-mobile-banner {display:flex;align-items:center;justify-content:space-between;gap:12px;position:absolute;z-index:3;top:16px;left:18px;right:18px;min-height:54px;padding:12px 14px;background:rgba(20,21,25,.95);border:1px solid #ef6177;border-left:4px solid #eb4158;border-radius:4px;text-decoration:none;color:#fff;box-shadow:0 8px 26px rgba(0,0,0,.36);}
    .campaign-mobile-banner strong {font-size:.86rem;letter-spacing:.025em;white-space:nowrap;}
    .campaign-mobile-banner span {font-size:.73rem;color:#ffc3cd;font-weight:750;text-align:right;white-space:nowrap;}
    .campaign-mobile-banner:focus-visible {outline:3px solid #fff;outline-offset:4px;}
    .hero { min-height: max(720px, calc(100svh - 72px)); }
    .hero-photo { object-position: 52% top; }
    .hero-inner { padding-top: clamp(330px, 48vh, 390px); padding-bottom: 32px; }
    .hero h1 { font-size: clamp(1.95rem, 9vw, 2.55rem); }
    .hero p.lead { font-size: 0.98rem; line-height: 1.55; }
    .hero-ctas { display: grid; grid-template-columns: 1fr; gap: 10px; }
    .hero-ctas .btn { width: 100%; }
    .trust-line { text-align: center; font-size: 0.76rem; max-width: 42ch; margin: 0 auto; }
    .campaign-spotlight {display:none;}
    .campaign-spotlight-link {width:100%;font-size:.92rem;}
    .campaign-spotlight strong {font-size:1.4rem;}
  }

  @media (min-width: 861px) {
    .hero {
      min-height: 760px;
      align-items: center;
    }

    .hero-photo {
      inset: 0 0 0 auto;
      left: auto;
      width: auto;
      height: 100%;
      aspect-ratio: 3 / 4;
      z-index: 1;
      mask-image: linear-gradient(to left, black 55%, transparent 100%);
      -webkit-mask-image: linear-gradient(to left, black 55%, transparent 100%);
    }

    .hero-scrim {
      z-index: 0;
      background: linear-gradient(100deg, var(--graphite) 0%, var(--graphite) 30%, var(--red) 100%);
    }

    .hero-inner { padding-top: 72px; padding-bottom: 72px; }
  }
</style>

---
import resources from '../data/resources-v1.json';

interface Props {
  lang: 'en' | 'pl';
  article: any;
}

const { lang, article } = Astro.props;
const root = lang === 'pl' ? '/pl/resources' : '/resources';
const homeHref = lang === 'pl' ? '/pl' : '/';
const homeLabel = lang === 'pl' ? 'Strona główna' : 'Home';
const guidesLabel = lang === 'pl' ? 'Poradniki' : 'Guides';
const updatedLabel = lang === 'pl' ? 'Aktualizacja' : 'Updated';
const authorLabel = lang === 'pl' ? 'Kacper Kaszowski · Personal Trainer' : 'Kacper Kaszowski · Personal Trainer';
const authorHref = lang === 'pl' ? '/pl/about' : '/about';
const otherArticles = resources.articles.filter(item => item.enabled && item.id !== article.id);
const continueLabel = lang === 'pl' ? 'Czytaj również' : 'Read next';
---
<article class="resource-article">
  <header class="article-hero on-dark">
    <div class="container article-width">
      <nav class="article-breadcrumbs" aria-label={lang === 'pl' ? 'Okruszki nawigacji' : 'Breadcrumb'}>
        <a href={homeHref}>{homeLabel}</a><span>›</span><a href={root}>{guidesLabel}</a>
      </nav>
      <h1>{article.title[lang]}</h1>
      <p class="article-intro">{article.intro[lang]}</p>
      <div class="article-meta"><a class="article-author" href={authorHref}>{authorLabel}</a><span>{updatedLabel}: {article.updated}</span></div>
    </div>
  </header>

  <div class="container article-width article-media-wrap">
    <img class="article-image" src={article.image} alt={article.imageAlt[lang]} width="960" height="630" loading="eager" fetchpriority="high" />
  </div>

  <div class="container article-width article-content">
    {article.sections.map((section: any) => (
      <section class="article-section">
        <h2>{section.heading[lang]}</h2>
        {section.paragraphs?.map((paragraph: any) => <p>{paragraph[lang]}</p>)}
        {section.bullets?.length > 0 && (
          <ul>
            {section.bullets.map((bullet: any) => <li>{bullet[lang]}</li>)}
          </ul>
        )}
      </section>
    ))}
  </div>

  <section class="article-cta on-white">
    <div class="container article-width cta-box">
      <h2>{article.cta.heading[lang]}</h2>
      <p>{article.cta.body[lang]}</p>
      <a href={article.cta.href[lang]} class="btn btn-primary">{article.cta.label[lang]}</a>
    </div>
  </section>

  {otherArticles.length > 0 && (
    <aside class="article-next" aria-label={continueLabel}>
      <div class="container article-width">
        <span class="eyebrow">{continueLabel}</span>
        <div class="next-grid">
          {otherArticles.map(item => (
            <a href={`${root}/${item.slug[lang]}`} class="next-card">
              <strong>{item.title[lang]}</strong>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  )}
</article>

<style>
  .article-width { max-width: 900px; }
  .article-hero { padding: 58px 0 118px; }
  .article-breadcrumbs { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 28px; color: #B9BEC5; font-size: .82rem; }
  .article-breadcrumbs a { color: inherit; text-decoration: none; }
  .article-breadcrumbs a:hover { color: var(--white); }
  .article-hero h1 { color: var(--white); max-width: 19ch; font-size: clamp(2.1rem, 5vw, 3.9rem); margin-bottom: 20px; }
  .article-intro { color: #D3D6DA; max-width: 72ch; font-size: 1.08rem; line-height: 1.75; }
  .article-meta { display: flex; gap: 12px 24px; flex-wrap: wrap; margin-top: 24px; color: #AEB4BC; font-size: .78rem; font-weight: 700; }
  .article-author { color: inherit; text-decoration: none; text-underline-offset: 3px; }
  .article-author:hover { color: var(--white); text-decoration: underline; }
  .article-media-wrap { margin-top: -74px; position: relative; z-index: 1; }
  .article-image { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: center top; border-radius: var(--radius); border: 1px solid #DADDE1; background: #ECEEF0; }
  .article-content { padding-top: 54px; padding-bottom: 34px; }
  .article-section { padding: 0 0 36px; }
  .article-section h2 { font-size: clamp(1.45rem, 3vw, 2rem); margin-bottom: 16px; }
  .article-section p { color: #4D535B; font-size: 1rem; line-height: 1.78; margin-bottom: 16px; }
  .article-section ul { margin: 6px 0 0 1.25rem; display: grid; gap: 10px; }
  .article-section li { color: #40464E; line-height: 1.65; padding-left: 4px; }
  .article-section li::marker { color: var(--red); }
  .article-cta { padding-top: 22px; }
  .cta-box { border: 1px solid #E1E4E8; border-top: 4px solid var(--red); border-radius: var(--radius); padding: 34px; }
  .cta-box h2 { margin-bottom: 10px; }
  .cta-box p { color: var(--steel); max-width: 66ch; margin-bottom: 22px; }
  .article-next { padding: 44px 0 76px; background: #F6F7F8; }
  .next-grid { display: grid; gap: 12px; margin-top: 13px; }
  .next-card { display: flex; justify-content: space-between; gap: 18px; align-items: center; padding: 18px 20px; background: var(--white); border: 1px solid #E1E4E8; border-radius: var(--radius); color: inherit; text-decoration: none; }
  .next-card span { color: var(--red); font-size: 1.2rem; font-weight: 800; }
  .next-card:hover { border-color: #C9CDD2; }
  @media (max-width: 640px) {
    .article-hero { padding: 44px 0 96px; }
    .article-media-wrap { margin-top: -58px; }
    .article-content { padding-top: 42px; }
    .cta-box { padding: 26px 20px; }
    .cta-box .btn { width: 100%; }
  }
</style>

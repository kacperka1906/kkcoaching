---
import { getCollection } from 'astro:content';

interface Props {
  lang: 'en' | 'pl';
  pathname: string;
}

const { lang, pathname } = Astro.props;
const type = pathname.includes('hybrid-coaching')
  ? 'hybrid-coaching'
  : pathname.includes('online-coaching')
    ? 'online-coaching'
    : pathname.includes('personal-training-cwmbran')
      ? 'personal-training'
      : null;

const selectors = {
  'personal-training': '.local-hero .hero-media img',
  'online-coaching': '.online-hero .hero-media img',
  'hybrid-coaching': '.hybrid-hero .hero-media img'
};

const services = type ? await getCollection('services') : [];
const service = type
  ? services.find(entry => entry.id === `${lang}/${type}`)
  : undefined;
const selector = type ? selectors[type] : '';
const heroImage = service?.data.detailImage || service?.data.image || '';
const heroAlt = service?.data.detailImageAlt || service?.data.imageAlt || '';
const script = service && heroImage
  ? `(() => {
      const image = document.querySelector(${JSON.stringify(selector)});
      if (!image) return;
      image.src = ${JSON.stringify(heroImage)};
      image.alt = ${JSON.stringify(heroAlt)};
    })();`
  : '';
---
{script && <script is:inline set:html={script}></script>}

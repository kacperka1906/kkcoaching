---
import servicePages from '../data/service-pages.json';

interface Props {
  lang: 'en' | 'pl';
  pathname: string;
}

const { lang, pathname } = Astro.props;
const type = pathname.includes('hybrid-coaching')
  ? 'hybrid'
  : pathname.includes('online-coaching')
    ? 'online'
    : pathname.includes('personal-training-cwmbran')
      ? 'personal'
      : null;

const selectors = {
  personal: '.local-hero .hero-media img',
  online: '.online-hero .hero-media img',
  hybrid: '.hybrid-hero .hero-media img'
};

const visual = type ? servicePages[type] : null;
const selector = type ? selectors[type] : '';
const heroImage = visual?.heroImage ?? '';
const heroAlt = visual?.heroAlt?.[lang] ?? '';
const script = visual && heroImage
  ? `(() => {
      const image = document.querySelector(${JSON.stringify(selector)});
      if (!image) return;
      image.src = ${JSON.stringify(heroImage)};
      image.alt = ${JSON.stringify(heroAlt)};
    })();`
  : '';
---
{script && <script is:inline set:html={script}></script>}

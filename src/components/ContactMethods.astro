---
interface Props {
  lang: 'en' | 'pl';
  whatsappNumber: string;
  contactEmail: string;
  instagramUrl: string;
}

const { lang, whatsappNumber, contactEmail, instagramUrl } = Astro.props;
const whatsappDigits = whatsappNumber.replace(/\D/g, '');
const whatsappDisplay = whatsappNumber.startsWith('+44')
  ? whatsappNumber.replace('+44', '+44 ').replace(/(\+44 )(\d{4})(\d{6})/, '$1$2 $3').replace(/(\d{3})(\d{3})$/, '$1 $2')
  : whatsappNumber;
const instagramHandle = '@kkcoaching.fit';

const copy = lang === 'pl'
  ? {
      heading: 'Wolisz napisać bezpośrednio?',
      intro: 'Wybierz najwygodniejszą opcję. Najszybciej zwykle odpowiadam na WhatsApp.',
      whatsapp: 'WhatsApp',
      whatsappHint: 'Napisz wiadomość',
      email: 'E-mail',
      emailHint: 'Wyślij e-mail',
      instagram: 'Instagram',
      instagramHint: 'Otwórz profil',
      response: 'Zwykle odpowiadam w ciągu 24 godzin.'
    }
  : {
      heading: 'Prefer to message directly?',
      intro: 'Choose whichever option is easiest. WhatsApp is usually the quickest.',
      whatsapp: 'WhatsApp',
      whatsappHint: 'Send a message',
      email: 'Email',
      emailHint: 'Send an email',
      instagram: 'Instagram',
      instagramHint: 'View profile',
      response: 'I usually reply within 24 hours.'
    };
---

<aside class="contact-side" aria-labelledby="direct-contact-heading">
  <h2 id="direct-contact-heading">{copy.heading}</h2>
  <p class="contact-intro">{copy.intro}</p>

  <div class="contact-methods">
    <a class="contact-method" href={`https://wa.me/${whatsappDigits}`} target="_blank" rel="noopener">
      <span class="contact-icon whatsapp" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.4L3.5 20.5l1.4-4.3A8.5 8.5 0 1 1 20.5 11.7Z" />
          <path d="M8.2 7.7c.2-.4.4-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.7c.1.3.1.5-.1.7l-.6.7c-.2.2-.2.4 0 .7.6 1.1 1.5 2 2.6 2.6.3.2.5.2.7 0l.8-1c.2-.2.4-.3.7-.2l1.8.9c.3.1.4.3.4.5 0 .3-.1 1.4-.8 2-.6.6-1.5.9-2.4.7-1.5-.3-3.4-1-5.1-2.7-1.4-1.4-2.4-3.1-2.7-4.4-.2-.8 0-1.6.5-2.2Z" />
        </svg>
      </span>
      <span class="contact-copy">
        <strong>{copy.whatsapp}</strong>
        <span class="contact-value">{whatsappDisplay}</span>
        <small>{copy.whatsappHint}</small>
      </span>
      <span class="contact-arrow" aria-hidden="true">→</span>
    </a>

    <a class="contact-method" href={`mailto:${contactEmail}`}>
      <span class="contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <path d="m4 7 8 6 8-6" />
        </svg>
      </span>
      <span class="contact-copy">
        <strong>{copy.email}</strong>
        <span class="contact-value email-value">{contactEmail}</span>
        <small>{copy.emailHint}</small>
      </span>
      <span class="contact-arrow" aria-hidden="true">→</span>
    </a>

    <a class="contact-method" href={instagramUrl} target="_blank" rel="noopener">
      <span class="contact-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="contact-copy">
        <strong>{copy.instagram}</strong>
        <span class="contact-value">{instagramHandle}</span>
        <small>{copy.instagramHint}</small>
      </span>
      <span class="contact-arrow" aria-hidden="true">→</span>
    </a>
  </div>

  <p class="response-time">{copy.response}</p>
</aside>

<style>
  .contact-side {
    background: var(--white);
    border: 1px solid #E1E4E8;
    border-radius: var(--radius);
    padding: 28px;
  }

  .contact-side h2 {
    font-size: 1.3rem;
    line-height: 1.2;
    margin-bottom: 8px;
  }

  .contact-intro {
    color: var(--steel);
    font-size: 0.94rem;
    margin-bottom: 20px;
  }

  .contact-methods {
    display: grid;
    gap: 10px;
  }

  .contact-method {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) 24px;
    align-items: center;
    gap: 12px;
    min-height: 82px;
    padding: 14px;
    border: 1px solid #E3E6EA;
    border-radius: 12px;
    background: #FAFAFB;
    color: var(--graphite);
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease, background 160ms ease;
  }

  .contact-method:hover,
  .contact-method:focus-visible {
    border-color: var(--red);
    background: #FFF;
    transform: translateY(-1px);
  }

  .contact-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #F1F2F4;
    color: var(--red);
  }

  .contact-icon svg {
    width: 25px;
    height: 25px;
  }

  .contact-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .contact-copy strong {
    font-size: 0.86rem;
    color: var(--steel);
    font-weight: 700;
  }

  .contact-value {
    color: var(--graphite);
    font-size: 1rem;
    line-height: 1.3;
    font-weight: 750;
    overflow-wrap: anywhere;
  }

  .contact-copy small {
    margin-top: 2px;
    color: #7A8088;
    font-size: 0.75rem;
  }

  .contact-arrow {
    color: var(--red);
    font-size: 1.25rem;
    font-weight: 800;
    justify-self: end;
  }

  .response-time {
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px solid #E7E9EC;
    color: var(--steel);
    font-size: 0.83rem;
  }

  @media (max-width: 620px) {
    .contact-side { padding: 20px 16px; }
    .contact-side h2 { font-size: 1.2rem; }
    .contact-intro { font-size: 0.9rem; }
    .contact-method {
      grid-template-columns: 42px minmax(0, 1fr) 20px;
      min-height: 76px;
      gap: 10px;
      padding: 12px;
    }
    .contact-icon { width: 42px; height: 42px; border-radius: 11px; }
    .contact-icon svg { width: 23px; height: 23px; }
    .contact-value { font-size: 0.94rem; }
    .email-value { font-size: 0.88rem; }
  }
</style>

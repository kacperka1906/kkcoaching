---
interface Props {
  lang: 'en' | 'pl';
  topic: 'local' | 'online';
}

const { lang, topic } = Astro.props;
const isPl = lang === 'pl';

const guide = topic === 'local'
  ? (isPl
      ? {
          eyebrow: 'Poradnik przed pierwszym treningiem',
          title: 'Jak wybrać trenera personalnego w Cwmbran',
          body: 'Sprawdź, na co zwrócić uwagę przy wyborze trenera: sposób pracy, kwalifikacje, lokalizację, kontrolę postępów i poziom wsparcia.',
          href: '/pl/resources/jak-wybrac-trenera-personalnego-cwmbran',
          cta: 'Przeczytaj poradnik'
        }
      : {
          eyebrow: 'Before you book',
          title: 'How to choose a personal trainer in Cwmbran',
          body: 'A practical checklist covering coaching style, qualifications, location, progress tracking and the level of support you actually need.',
          href: '/resources/choosing-personal-trainer-cwmbran',
          cta: 'Read the guide'
        })
  : (isPl
      ? {
          eyebrow: 'Jak wygląda prowadzenie zdalne',
          title: 'Jak działa trener personalny online w UK',
          body: 'Zobacz, czego oczekiwać od planu, raportów, wsparcia żywieniowego, oceny techniki i regularnej kontroli postępów.',
          href: '/pl/resources/trener-personalny-online-uk-jak-to-dziala',
          cta: 'Przeczytaj poradnik'
        }
      : {
          eyebrow: 'How remote coaching works',
          title: 'How online personal training works in the UK',
          body: 'See what to expect from programming, check-ins, nutrition support, video technique feedback and progress tracking.',
          href: '/resources/online-personal-training-uk',
          cta: 'Read the guide'
        });
---
<section class="related-guide on-white" aria-labelledby="related-guide-heading">
  <div class="container related-guide__inner">
    <div>
      <span class="eyebrow">{guide.eyebrow}</span>
      <h2 id="related-guide-heading">{guide.title}</h2>
      <p>{guide.body}</p>
    </div>
    <a href={guide.href} class="btn btn-outline-dark">{guide.cta}</a>
  </div>
</section>

<style>
  .related-guide { padding-top: 54px; padding-bottom: 54px; }
  .related-guide__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 30px;
    align-items: center;
    border: 1px solid #E1E4E7;
    border-left: 4px solid var(--red);
    border-radius: var(--radius);
    padding: 28px 30px;
    background: #F7F8F9;
  }
  .related-guide h2 { font-size: clamp(1.35rem, 2.5vw, 1.8rem); margin: 8px 0 8px; }
  .related-guide p { color: var(--steel); max-width: 68ch; }
  @media (max-width: 700px) {
    .related-guide__inner { grid-template-columns: 1fr; padding: 24px 20px; }
    .related-guide .btn { width: 100%; text-align: center; justify-content: center; }
  }
</style>

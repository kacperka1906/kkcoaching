---
import type { ReviewSource } from './review-types';
interface Props { source: ReviewSource; }
const { source } = Astro.props;
---
<svg class:list={['rw-source-icon', `rw-icon-${source}`]} width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {source === 'facebook' ? <><circle cx="12" cy="12" r="12" fill="#1877f2"/><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.2c0-.9.3-1.4 1.5-1.4h1.7V4.1c-.5-.1-1.3-.2-2.3-.2-2.4 0-4 1.5-4 4.2V10H8v3h2.4v8z" fill="white"/></>
    : source === 'google' ? <><path d="M21 12a9 9 0 1 1-2.6-6.4" fill="none" stroke="#4285f4" stroke-width="3.5"/><path d="M21 12h-9m9 0a9 9 0 0 1-3 6.7" fill="none" stroke="#4285f4" stroke-width="3.5"/><path d="M5.6 5.6A9 9 0 0 1 18.4 5.6" fill="none" stroke="#ea4335" stroke-width="3.5"/><path d="M5.6 18.4A9 9 0 0 1 5.6 5.6" fill="none" stroke="#fbbc05" stroke-width="3.5"/><path d="M18 18.7a9 9 0 0 1-12.4-.3" fill="none" stroke="#34a853" stroke-width="3.5"/></>
    : source === 'whatsapp' ? <><path d="M12 2a10 10 0 0 0-8.7 15l-1 5 5-1A10 10 0 1 0 12 2Z" fill="#128c4a"/><path d="M8 7c-2 2 2 7 5 9 2 1 4-1 3-2l-2-1-1 1-3-3 1-1-1-3Z" fill="white"/></>
    : <><rect width="24" height="24" rx="6" fill="currentColor"/><path d="m7 12 3 3 7-7" fill="none" stroke="white" stroke-width="2"/></>}
</svg>

---
import AllInOneReviews from './AllInOneReviews.astro';
import { reviewCopy } from './review-copy';
interface Props { lang: 'en' | 'pl'; }
const { lang } = Astro.props;
const copy = reviewCopy[lang];
const title = lang === 'pl' ? 'Podgląd opinii · KK Coaching' : 'Reviews widget preview · KK Coaching';
const description = lang === 'pl' ? 'Izolowany podgląd widżetu z oryginalnymi rekomendacjami podopiecznych KK Coaching.' : 'An isolated preview of the KK Coaching reviews widget with original client recommendations.';
const canonical = `https://kkcoaching.fit/${lang === 'pl' ? 'pl/' : ''}reviews-widget-preview/`;
---
<!doctype html>
<html lang={lang}>
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content="https://kkcoaching.fit/favicon.svg"/><link rel="icon" href="/favicon.svg"/></head>
  <body>
    <header class="preview-header"><span class="preview-brand"><span class="preview-monogram">KK</span> COACHING</span><span class="preview-label">{lang === 'pl' ? 'PODGLĄD OPINII' : 'REVIEWS PREVIEW'}</span><nav aria-label={lang === 'pl' ? 'Język' : 'Language'}><a href="/reviews-widget-preview/" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a><a href="/pl/reviews-widget-preview/" lang="pl" aria-current={lang === 'pl' ? 'page' : undefined}>PL</a></nav></header>
    <main>
      <h1 class="rw-sr-only">{title}</h1>
      <div class="preview-controls"><span>{lang === 'pl' ? 'Opinie, które budują zaufanie.' : 'Built on real experiences.'}</span><label>{copy.layout}<select data-layout-select><option value="carousel">{copy.carousel}</option><option value="grid">{copy.grid}</option><option value="list">{copy.list}</option></select></label></div>
      <AllInOneReviews lang={lang}/>
      <p class="preview-note">{lang === 'pl' ? 'Izolowany podgląd · Oryginalne rekomendacje z Facebooka · Bez połączeń z API' : 'Isolated preview · Original Facebook recommendations · No provider connections'}</p>
    </main>
  </body>
</html>
<script>
  document.querySelector<HTMLSelectElement>('[data-layout-select]')?.addEventListener('change', event => {
    document.querySelector<HTMLElement>('[data-review-widget]')!.dataset.layout = (event.target as HTMLSelectElement).value;
  });
</script>
<style is:global>
  :root{--graphite:#17191d;--red:#a51f2e;--steel:#454a52;color-scheme:light}*{box-sizing:border-box}body{margin:0;background:#f3f4f6;color:var(--graphite);font-family:'Segoe UI',system-ui,-apple-system,sans-serif}.preview-header{height:84px;background:#17191d;color:#fff;display:flex;align-items:center;gap:28px;padding:0 max(24px,calc((100% - 1200px)/2))}.preview-brand{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;letter-spacing:.12em;white-space:nowrap}.preview-monogram{font-size:24px;font-style:italic;letter-spacing:-.1em;padding-right:5px}.preview-label{font-size:9px;letter-spacing:.18em;color:#b9bec6;border-left:1px solid #454a52;padding-left:28px}.preview-header nav{margin-left:auto;display:flex;gap:2px}.preview-header a{color:#b9bec6;font-size:11px;text-decoration:none;padding:15px 10px}.preview-header a[aria-current]{color:white;text-decoration:underline;text-underline-offset:6px}main{max-width:1248px;padding:46px 24px;margin:auto}.preview-controls{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:22px;color:#626872;font-size:12px}.preview-controls>span{font-weight:500}.preview-controls label{display:flex;align-items:center;gap:10px;font-size:11px}.preview-controls select{padding:9px 12px;min-height:44px;border:1px solid #dce0e5;border-radius:7px;background:#fff;color:#454a52;font:inherit}.preview-note{text-align:center;font-size:10px;line-height:1.7;color:#626872;margin:24px 0}.preview-header a:focus-visible,.preview-controls select:focus-visible{outline:3px solid #a51f2e;outline-offset:2px}@media(max-width:600px){.preview-header{height:68px;padding:0 18px;gap:12px}.preview-label{display:none}main{padding:24px 12px}.preview-controls{gap:10px;margin:0 5px 15px}.preview-controls>span{font-size:11px;max-width:140px}.preview-controls label{gap:6px}.preview-controls select{padding:8px}.preview-note{max-width:280px;margin:20px auto}}
</style>

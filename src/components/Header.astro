---
import Logo from './Logo.astro';

interface Props {
  lang: 'en' | 'pl';
  altPath?: string;
}
const { lang, altPath } = Astro.props;
const prefix = lang === 'pl' ? '/pl' : '';
const languageHref = altPath ?? (lang === 'pl' ? '/' : '/pl');
const homeLabel = lang === 'pl' ? 'KK Coaching - strona główna' : 'KK Coaching - home';

const nav = lang === 'pl'
  ? [
      { href: '/pl', label: 'Strona główna' },
      { href: '/pl/personal-training-cwmbran', label: 'Trener personalny Cwmbran' },
      { href: '/pl/online-coaching', label: 'Coaching online' },
      { href: '/pl/hybrid-coaching', label: 'Coaching hybrydowy' },
      { href: '/pl/transformations', label: 'Przemiany' },
      { href: '/pl/about', label: 'O mnie' },
      { href: '/pl/contact', label: 'Kontakt' }
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/personal-training-cwmbran', label: 'Personal Training Cwmbran' },
      { href: '/online-coaching', label: 'Online Coaching' },
      { href: '/hybrid-coaching', label: 'Hybrid Coaching' },
      { href: '/transformations', label: 'Transformations' },
      { href: '/about', label: 'About Me' },
      { href: '/contact', label: 'Contact' }
    ];

const ctaLabel = lang === 'pl' ? 'Bezpłatna konsultacja' : 'Free Consultation';
---
<header class="site-header">
  <div class="container">
    <a href={lang === 'pl' ? '/pl' : '/'} class="logo" aria-label={homeLabel}>
      <Logo height={32} />
    </a>
    <nav class="main-nav" id="mainNav" aria-label={lang === 'pl' ? 'Główna nawigacja' : 'Main navigation'}>
      <ul>
        {nav.map(item => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="header-right">
      <a class="header-cta" href={`${prefix}/contact`}>{ctaLabel}</a>
      <a class="lang-switch" href={languageHref} aria-label={lang === 'pl' ? 'Switch to English' : 'Przełącz na polski'}>
        {lang === 'pl' ? 'EN' : 'PL'}
      </a>
      <button class="nav-toggle" aria-label={lang === 'pl' ? 'Otwórz menu' : 'Open menu'} aria-controls="mainNav" aria-expanded="false" id="navToggle">&#9776;</button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mainNav');

  const closeMenu = () => {
    nav?.classList.remove('is-open');
    document.body.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    if (toggle) toggle.innerHTML = '&#9776;';
  };

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    document.body.classList.toggle('menu-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.innerHTML = isOpen ? '&times;' : '&#9776;';
  });

  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-header {
    background: var(--graphite);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex: 0 0 auto;
  }

  nav.main-nav ul {
    list-style: none;
    display: flex;
    gap: 16px;
  }
  nav.main-nav a {
    color: var(--off-white);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    white-space: nowrap;
  }
  nav.main-nav a:hover { color: var(--red); }

  .header-right { display: flex; align-items: center; gap: 12px; }
  .header-cta {
    background: var(--red);
    color: var(--white);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: var(--radius);
  }
  .header-cta:hover { background: var(--red-hover); }
  .lang-switch {
    color: var(--off-white);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    border: 1px solid #454A52;
    border-radius: var(--radius);
    min-width: 48px;
    min-height: 42px;
    padding: 7px 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .lang-switch:hover { border-color: var(--red); color: var(--white); }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--white);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    padding: 4px;
  }

  @media (max-width: 1180px) {
    .header-cta { display: none; }
    nav.main-nav ul { gap: 11px; }
    nav.main-nav a { font-size: 0.82rem; }
  }

  @media (max-width: 940px) {
    nav.main-nav { display: none; }
    .nav-toggle { display: inline-flex; align-items: center; justify-content: center; }
  }

  @media (max-width: 940px) {
    :global(body.menu-open) { overflow: hidden; }
    .site-header .container { min-height: 72px; padding-left: 18px; padding-right: 14px; }
    .logo :global(.site-logo) { height: 38px !important; max-width: 92px; object-fit: contain; }
    .header-right { gap: 8px; }
    nav.main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
      background: var(--graphite);
      padding: 10px 20px 22px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.28);
      border-top: 1px solid #2A2E34;
    }
    nav.main-nav.is-open { display: block; }
    nav.main-nav ul { flex-direction: column; gap: 0; }
    nav.main-nav li { border-bottom: 1px solid #2A2E34; }
    nav.main-nav li:last-child { border-bottom: 0; padding-top: 10px; }
    nav.main-nav a { display: block; padding: 14px 4px; font-size: 1rem; white-space: normal; }
    nav.main-nav li:last-child a {
      background: var(--red);
      color: var(--white);
      font-weight: 700;
      text-align: center;
      border-radius: var(--radius);
      padding: 13px 16px;
    }
    nav.main-nav li:last-child a:hover { background: var(--red-hover); color: var(--white); }
  }
</style>

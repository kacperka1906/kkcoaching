---
import Logo from './Logo.astro';
import admin from '../data/admin-v2.json';

interface Props {
  lang: 'en' | 'pl';
  altPath?: string;
}

const { lang, altPath } = Astro.props;
const languageHref = altPath ?? (lang === 'pl' ? '/' : '/pl');
const homeLabel = lang === 'pl' ? 'KK Coaching - strona główna' : 'KK Coaching - home';
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const nav = admin.header.items
  .filter(item => item.enabled)
  .map(item => ({
    ...item,
    label: item.label[lang],
    href: item.href[lang]
  }));
const ctaLabel = admin.header.headerCta.label[lang];
const ctaHref = admin.header.headerCta.href[lang];
const stickyMobile = admin.header.stickyMobile;
const compactOnScroll = admin.header.compactOnScroll;
---
<header
  class:list={['site-header', { 'sticky-mobile': stickyMobile, 'polish-header': lang === 'pl' }]}
  data-sticky-mobile={String(stickyMobile)}
  data-compact-on-scroll={String(compactOnScroll)}
  id="siteHeader"
>
  <div class="container">
    <a href={lang === 'pl' ? '/pl' : '/'} class="logo" aria-label={homeLabel}>
      <Logo height={32} />
    </a>

    <nav class="main-nav" id="mainNav" aria-label={lang === 'pl' ? 'Główna nawigacja' : 'Main navigation'}>
      <ul>
        {nav.map(item => (
          <li class:list={{ 'nav-item-cta': item.style === 'cta' }}>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        {lang === 'pl' && (
          <li class="nav-program-cta">
            <a href="/pl/moja-kolej-2027/" aria-current={currentPath === '/pl/moja-kolej-2027' ? 'page' : undefined}>
              <span class="program-dot" aria-hidden="true"></span>MOJA KOLEJ 2027
            </a>
          </li>
        )}
      </ul>
    </nav>

    <div class="header-right">
      {admin.header.showHeaderCta && <a class="header-cta" href={ctaHref}>{ctaLabel}</a>}
      <a class="lang-switch" href={languageHref} aria-label={lang === 'pl' ? 'EN — Switch to English' : 'PL — Przełącz na polski'}>
        {lang === 'pl' ? 'EN' : 'PL'}
      </a>
      <button class="nav-toggle" aria-label={lang === 'pl' ? 'Otwórz menu' : 'Open menu'} aria-controls="mainNav" aria-expanded="false" id="navToggle">&#9776;</button>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('siteHeader');
  const toggle = document.getElementById('navToggle');
  const nav = document.getElementById('mainNav');

  // Astro renders contact pages statically: query parameters are only known
  // in the browser. Preserve allowlisted enquiry intent when switching EN/PL.
  const languageLink = header?.querySelector('.lang-switch');
  const contactPath = window.location.pathname.replace(/\/+$/, '') || '/';
  if (languageLink && ['/contact', '/pl/contact'].includes(contactPath)) {
    const requestedIntent = new URLSearchParams(window.location.search).get('interest');
    if (['pt', 'online', 'hybrid', 'training-plan', 'taster'].includes(requestedIntent || '')) {
      const destination = new URL(languageLink.getAttribute('href') || '', window.location.origin);
      destination.searchParams.set('interest', requestedIntent);
      languageLink.setAttribute('href', destination.pathname + destination.search);
    }
  }


  if (header?.dataset.stickyMobile === 'true') {
    document.body.classList.add('has-fixed-mobile-header');
  }

  const closeMenu = (returnFocus = false) => {
    nav?.classList.remove('is-open');
    document.body.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded', 'false');
    if (toggle) {
      toggle.innerHTML = '&#9776;';
      toggle.setAttribute('aria-label', header?.querySelector('.lang-switch')?.textContent?.trim() === 'EN' ? 'Otwórz menu' : 'Open menu');
      if (returnFocus) toggle.focus({ preventScroll: true });
    }
  };

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    document.body.classList.toggle('menu-open', isOpen);
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.innerHTML = isOpen ? '&times;' : '&#9776;';
    toggle.setAttribute('aria-label', isOpen
      ? (header?.querySelector('.lang-switch')?.textContent?.trim() === 'EN' ? 'Zamknij menu' : 'Close menu')
      : (header?.querySelector('.lang-switch')?.textContent?.trim() === 'EN' ? 'Otwórz menu' : 'Open menu'));
    if (isOpen) nav?.querySelector('a')?.focus({ preventScroll: true });
  });

  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => closeMenu()));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('is-open')) closeMenu(true);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > (header?.classList.contains('polish-header') ? 1240 : 940) && nav?.classList.contains('is-open')) closeMenu();
  }, { passive: true });

  if (header?.dataset.compactOnScroll === 'true') {
    const updateScrolledState = () => header.classList.toggle('is-scrolled', window.scrollY > 24);
    updateScrolledState();
    window.addEventListener('scroll', updateScrolledState, { passive: true });
  }
</script>

<style>
  .site-header {
    background: var(--graphite);
    position: sticky;
    top: 0;
    z-index: 50;
    transition: box-shadow .2s ease, background-color .2s ease;
  }
  .site-header.is-scrolled { box-shadow: 0 8px 24px rgba(0,0,0,.22); }
  .site-header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    padding-top: 10px;
    padding-bottom: 10px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex: 0 0 auto;
  }

  nav.main-nav ul {
    list-style: none;
    display: flex;
    gap: 16px;
  }
  nav.main-nav a {
    color: var(--off-white);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    white-space: nowrap;
  }
  nav.main-nav a:hover,
  nav.main-nav a[aria-current="page"] { color: #FFDDE1; }
  nav.main-nav a[aria-current="page"] { font-weight: 700; }


  nav.main-nav li.nav-program-cta { display:flex;align-items:center; }
  nav.main-nav li.nav-program-cta a {
    display:inline-flex;align-items:center;gap:7px;
    padding:9px 11px;white-space:nowrap;
    border:1.5px solid #ed6173;border-radius:5px;
    background:rgba(173,27,47,.16);color:#fff;
    font-size:.78rem;font-weight:800;letter-spacing:.02em;
    box-shadow:0 0 0 1px rgba(237,97,115,.07);
    transition:background-color .15s ease,border-color .15s ease;
  }
  nav.main-nav li.nav-program-cta a:hover,
  nav.main-nav li.nav-program-cta a[aria-current="page"] {
    background:#a71f35;border-color:#ff9baa;color:#fff;
  }
  .program-dot {width:7px;height:7px;flex:0 0 7px;background:#fc7187;border-radius:50%;}
  nav.main-nav li.nav-program-cta a:hover .program-dot {background:#fff;}
  nav.main-nav li.nav-program-cta a:focus-visible {outline:3px solid #fff;outline-offset:3px;}

  .header-right { display: flex; align-items: center; gap: 12px; }
  .header-cta {
    background: var(--red);
    color: var(--white);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: var(--radius);
  }
  .header-cta:hover { background: var(--red-hover); }
  .lang-switch {
    color: var(--off-white);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
    border: 1px solid #454A52;
    border-radius: var(--radius);
    min-width: 48px;
    min-height: 42px;
    padding: 7px 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .lang-switch:hover { border-color: var(--red); color: var(--white); }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--white);
    font-size: 1.75rem;
    line-height: 1;
    cursor: pointer;
    min-width: 44px;
    min-height: 44px;
    padding: 4px;
  }

  @media (max-width: 1180px) {
    .header-cta { display: none; }
    nav.main-nav ul { gap: 11px; }
    nav.main-nav a { font-size: 0.82rem; }
  }


  /* Polish campaign navigation gets its own wider layout, without modifying EN header. */
  .site-header.polish-header .container {max-width:1490px;}
  @media (max-width: 1530px) and (min-width: 941px) {
    .site-header.polish-header .header-cta {display:none;}
  }
  @media (min-width: 941px) and (max-width: 1240px) {
    .site-header.polish-header .nav-toggle {display:inline-flex;align-items:center;justify-content:center;}
    .site-header.polish-header nav.main-nav {display:none;position:absolute;top:100%;left:0;right:0;max-height:calc(100dvh - 65px);overflow-y:auto;background:var(--graphite);padding:12px 24px 22px;box-shadow:0 12px 30px rgba(0,0,0,.28);}
    .site-header.polish-header nav.main-nav.is-open {display:block;}
    .site-header.polish-header nav.main-nav ul {flex-direction:column;gap:0;}
    .site-header.polish-header nav.main-nav li {border-bottom:1px solid #30333a;}
    .site-header.polish-header nav.main-nav a {display:block;padding:13px 7px;font-size:1rem;white-space:normal;}
    .site-header.polish-header nav.main-nav li.nav-program-cta {display:flex;padding:12px 0;border-bottom:0;}
    .site-header.polish-header nav.main-nav li.nav-program-cta a {display:flex;width:100%;justify-content:center;min-height:52px;background:#a51f2e;border:2px solid #ff90a1;color:#fff;font-size:1.04rem;}
    .site-header.polish-header nav.main-nav li.nav-item-cta a {color:#fff;font-weight:700;}
  }

  @media (max-width: 940px) {
    :global(body.menu-open) { overflow: hidden; }
    :global(body.has-fixed-mobile-header) { padding-top: 72px; }
    .site-header.sticky-mobile {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: 100;
    }
    .site-header .container { min-height: 72px; padding-left: 18px; padding-right: 14px; }
    .site-header.is-scrolled .container { background: rgba(23,25,29,.98); }
    .site-header.is-scrolled .logo :global(.site-logo) { transform: scale(.92); transform-origin: left center; }
    .logo :global(.site-logo) { height: 38px !important; max-width: 92px; object-fit: contain; transition: transform .2s ease; }
    .header-right { gap: 8px; }
    .nav-toggle { display: inline-flex; align-items: center; justify-content: center; }
    nav.main-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      max-height: calc(100dvh - 72px);
      overflow-y: auto;
      background: var(--graphite);
      padding: 10px 20px 22px;
      box-shadow: 0 12px 30px rgba(0,0,0,0.28);
      border-top: 1px solid #2A2E34;
    }
    nav.main-nav.is-open { display: block; }
    nav.main-nav ul { flex-direction: column; gap: 0; }
    nav.main-nav li { border-bottom: 1px solid #2A2E34; }
    nav.main-nav li:last-child { border-bottom: 0; }
    nav.main-nav a { display: block; padding: 14px 4px; font-size: 1rem; white-space: normal; }
    nav.main-nav li.nav-item-cta { border-bottom: 0; padding-top: 10px; }
    nav.main-nav li.nav-item-cta a {
      background: var(--red);
      color: var(--white);
      font-weight: 700;
      text-align: center;
      border-radius: var(--radius);
      padding: 13px 16px;
    }
    nav.main-nav li.nav-item-cta a:hover { background: var(--red-hover); color: var(--white); }
    nav.main-nav li.nav-program-cta {padding:12px 0;border-bottom:0;}
    nav.main-nav li.nav-program-cta a {width:100%;min-height:52px;justify-content:center;padding:15px 14px;font-size:1.05rem;background:#a51f2e;border:2px solid #ff90a1;color:#fff;box-shadow:0 5px 18px rgba(165,31,46,.3);}
    nav.main-nav li.nav-program-cta .program-dot {background:#fff;width:9px;height:9px;flex-basis:9px;}
  }
</style>

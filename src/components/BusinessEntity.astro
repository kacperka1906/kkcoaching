---
import siteEn from '../data/site.en.json';

const siteUrl = 'https://kkcoaching.fit';
const businessId = `${siteUrl}/#business`;
const personId = `${siteUrl}/#kacper-kaszowski`;
const locationId = `${siteUrl}/#jd-gyms-cwmbran-training-location`;
const sameAs = [siteEn.meta.instagramUrl, siteEn.meta.facebookUrl].filter(Boolean);
const trainingProvider = {
  '@type': 'Organization',
  name: 'Achieve More Training'
};

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': businessId,
      name: 'KK Coaching',
      alternateName: 'KK Coaching by Kacper Kaszowski',
      slogan: 'Train. Transform. Thrive.',
      url: `${siteUrl}/`,
      description: 'Personal training in Cwmbran and online fitness coaching with individual training, practical nutrition support and regular progress tracking.',
      image: `${siteUrl}/images/kacper-kaszowski-personal-trainer-cwmbran.jpg`,
      logo: `${siteUrl}/images/logo.png`,
      email: siteEn.meta.contactEmail,
      telephone: siteEn.meta.whatsappNumber,
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer enquiries',
        telephone: siteEn.meta.whatsappNumber,
        email: siteEn.meta.contactEmail,
        availableLanguage: ['en', 'pl']
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '17-18 Gwent Square',
        addressLocality: 'Cwmbran',
        addressRegion: 'Torfaen',
        postalCode: 'NP44 1PW',
        addressCountry: 'GB'
      },
      location: { '@id': locationId },
      areaServed: [
        { '@type': 'City', name: 'Cwmbran' },
        { '@type': 'AdministrativeArea', name: 'Torfaen' },
        { '@type': 'AdministrativeArea', name: 'South Wales' },
        { '@type': 'Country', name: 'United Kingdom' }
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'KK Coaching services',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: '1:1 Personal Training in Cwmbran',
              url: `${siteUrl}/personal-training-cwmbran`,
              serviceType: 'Personal Training'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Online Personal Training and Fitness Coaching',
              url: `${siteUrl}/online-coaching`,
              serviceType: 'Online Personal Training'
            }
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Hybrid Personal Training in Cwmbran',
              url: `${siteUrl}/hybrid-coaching`,
              serviceType: 'Hybrid Personal Training and Online Coaching'
            }
          }
        ]
      },
      knowsLanguage: ['English', 'Polish'],
      sameAs,
      founder: { '@id': personId }
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Kacper Kaszowski',
      jobTitle: 'Personal Trainer',
      url: `${siteUrl}/about`,
      image: `${siteUrl}/images/kacper-kaszowski-personal-trainer-cwmbran.jpg`,
      sameAs,
      knowsLanguage: ['English', 'Polish'],
      knowsAbout: [
        'Personal training',
        'Resistance training',
        'Exercise technique',
        'Fat loss coaching',
        'Muscle building',
        'Online fitness coaching'
      ],
      hasCredential: [
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'Level 3 Certificate in Planning and Delivering Personal Training',
          credentialCategory: 'Professional qualification',
          educationalLevel: 'Level 3',
          recognizedBy: trainingProvider
        },
        {
          '@type': 'EducationalOccupationalCredential',
          name: 'Level 2 Diploma in Gym Instructing',
          credentialCategory: 'Professional qualification',
          educationalLevel: 'Level 2',
          recognizedBy: trainingProvider
        }
      ],
      worksFor: { '@id': businessId }
    },
    {
      '@type': 'Place',
      '@id': locationId,
      name: 'JD Gyms Cwmbran',
      url: 'https://www.jdgyms.co.uk/gym/cwmbran/',
      address: {
        '@type': 'PostalAddress',
        streetAddress: '17-18 Gwent Square',
        addressLocality: 'Cwmbran',
        addressRegion: 'Torfaen',
        postalCode: 'NP44 1PW',
        addressCountry: 'GB'
      }
    }
  ]
};
---
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

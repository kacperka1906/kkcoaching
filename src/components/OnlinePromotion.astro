---
import promotion from '../data/online-promotion.json';

interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;
const isPl = lang === 'pl';
const totalSpaces = Math.max(0, Math.trunc(promotion.totalSpaces));
const remainingSpaces = Math.min(totalSpaces, Math.max(0, Math.trunc(promotion.remainingSpaces)));
const money = (value: number) => `£${Number.isInteger(value) ? value.toFixed(0) : value.toFixed(2)}`;

const polishSpaces = (count: number) => {
  if (count === 1) return `ZOSTAŁO ${count} MIEJSCE`;
  const lastTwo = count % 100;
  const last = count % 10;
  if (last >= 2 && last <= 4 && !(lastTwo >= 12 && lastTwo <= 14)) return `ZOSTAŁY ${count} MIEJSCA`;
  return `ZOSTAŁO ${count} MIEJSC`;
};

const spacesLabel = remainingSpaces < totalSpaces
  ? (isPl ? polishSpaces(remainingSpaces) : `${remainingSpaces} ${remainingSpaces === 1 ? 'SPACE' : 'SPACES'} REMAINING`)
  : (isPl ? `${totalSpaces} MIEJSC DLA NOWYCH KLIENTÓW` : `${totalSpaces} NEW CLIENT SPACES`);

const dateKeyInLondon = (date: Date) => {
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/London',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).formatToParts(date);
  const map = Object.fromEntries(parts.map(part => [part.type, part.value]));
  return `${map.year}-${map.month}-${map.day}`;
};

const today = dateKeyInLondon(new Date());
const startsNow = !promotion.startDate || today >= promotion.startDate;
const beforeEnd = !promotion.autoDisableAfterEndDate || !promotion.endDate || today <= promotion.endDate;
const initiallyVisible = startsNow && beforeEnd;
const standardLine = isPl
  ? `Następnie standardowo: ${money(promotion.standardPrice)} / 4 tygodnie`
  : `Then standard price: ${money(promotion.standardPrice)} every 4 weeks`;
---
{promotion.enabled && (
  <section
    class="online-promotion"
    data-online-promotion
    data-start-date={promotion.startDate}
    data-end-date={promotion.endDate}
    data-auto-disable={promotion.autoDisableAfterEndDate ? 'true' : 'false'}
    hidden={!initiallyVisible}
    aria-label={promotion.headline[lang]}
  >
    <div class="container promotion-shell">
      <div class="promotion-copy">
        <span class="promotion-eyebrow">{promotion.headline[lang]}</span>
        <div class="spaces-badge">{spacesLabel}</div>
        <div class="promotion-price" aria-label={`${money(promotion.promotionalPrice)} ${promotion.promotionalPeriod[lang]}`}>
          <strong>{money(promotion.promotionalPrice)}</strong>
          <span>{promotion.promotionalPeriod[lang]}</span>
        </div>
        <p class="standard-price">{standardLine}</p>
      </div>
      <div class="promotion-action">
        <a href={promotion.ctaDestination[lang]} class="btn btn-primary">{promotion.ctaText[lang]}</a>
        <p class="small-print">{promotion.smallPrint[lang]}</p>
      </div>
    </div>
  </section>
)}

{promotion.enabled && (
  <script is:inline>
    (() => {
      const section = document.querySelector('[data-online-promotion]');
      if (!section) return;

      const londonDateKey = (date) => {
        const parts = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).formatToParts(date);
        const map = Object.fromEntries(parts.map(part => [part.type, part.value]));
        return `${map.year}-${map.month}-${map.day}`;
      };

      const today = londonDateKey(new Date());
      const start = section.dataset.startDate || '';
      const end = section.dataset.endDate || '';
      const autoDisable = section.dataset.autoDisable === 'true';
      const afterStart = !start || today >= start;
      const beforeEnd = !autoDisable || !end || today <= end;
      section.hidden = !(afterStart && beforeEnd);
    })();
  </script>
)}

<style>
  .online-promotion { margin-top: 36px; }
  .promotion-shell {
    display: grid;
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    gap: 34px;
    align-items: center;
    background: #202329;
    border: 1px solid #3B4048;
    border-left: 5px solid var(--red);
    border-radius: var(--radius);
    padding: 28px 30px;
    box-shadow: 0 18px 46px rgba(0, 0, 0, .22);
  }
  .promotion-eyebrow {
    display: block;
    color: #F4B5BC;
    font-size: .76rem;
    line-height: 1.2;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .spaces-badge {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    background: var(--red);
    color: var(--white);
    border-radius: 999px;
    padding: 8px 12px;
    font-size: .76rem;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }
  .promotion-price { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
  .promotion-price strong {
    color: var(--white);
    font-size: clamp(3rem, 7vw, 5.2rem);
    line-height: .86;
    letter-spacing: -.055em;
  }
  .promotion-price span {
    color: #F4F5F6;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 900;
    line-height: 1.05;
    text-transform: uppercase;
    padding-bottom: 5px;
  }
  .standard-price { color: #BFC4CA; font-size: .92rem; font-weight: 700; margin-top: 13px; }
  .promotion-action { border-left: 1px solid #3A3E45; padding-left: 34px; }
  .promotion-action .btn { min-width: min(100%, 290px); text-align: center; }
  .small-print { color: #BFC4CA; font-size: .79rem; line-height: 1.55; max-width: 62ch; margin-top: 15px; }
  [hidden] { display: none !important; }

  @media (max-width: 820px) {
    .promotion-shell { grid-template-columns: 1fr; gap: 24px; }
    .promotion-action { border-left: 0; border-top: 1px solid #3A3E45; padding-left: 0; padding-top: 24px; }
  }

  @media (max-width: 620px) {
    .online-promotion { margin-top: 28px; }
    .promotion-shell { padding: 22px 18px; gap: 20px; }
    .promotion-price { gap: 9px; }
    .promotion-price strong { font-size: clamp(3.15rem, 18vw, 4.6rem); }
    .promotion-price span { font-size: .92rem; max-width: 11ch; }
    .spaces-badge { width: 100%; justify-content: center; text-align: center; }
    .promotion-action .btn { width: 100%; }
    .small-print { font-size: .76rem; }
  }
</style>

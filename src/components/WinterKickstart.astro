---
/* One shared panel; source prices, dates, CTA and copy from promotions.json. */
interface WinterOffer {
 id: string; service: string; startDate: string; endDate: string; enabled: boolean;
 autoDisableAfterEndDate: boolean; promotionalPrice: number;
 headline: {en:string;pl:string}; title:{en:string;pl:string};
 offerText:{en:string;pl:string}; promotionalPeriod:{en:string;pl:string};
 ctaText:{en:string;pl:string}; ctaDestination:{en:string;pl:string};
 smallPrint:{en:string;pl:string}; winterFeatures?:{en:string[];pl:string[]};
}
interface Props {
 lang: 'en'|'pl'; placement: 'homepage'|'service'; offer:WinterOffer; hybridOffer?:WinterOffer;
}
const {lang,placement,offer,hybridOffer}=Astro.props;
const isPl=lang==='pl';
const isHome=placement==='homepage';
const variants=isHome&&hybridOffer?[offer,hybridOffer]:[offer];
const text=isPl ? {
 label:'OFERTA LISTOPADOWA',kicker:'6 tygodni. Konkretny plan. Zacznij jeszcze przed styczniem.',
 terms:'Dla nowych klientów · Oferta dostępna od 1 do 30 listopada 2026 · Rozpoczęcie w uzgodnionym terminie · Treningi zależą od dostępności trenera · Karnet JD Gyms płatny osobno · Rabaty nie łączą się · Bez automatycznego odnowienia · Kontynuacja według standardowego cennika.',
 pt:'TRENING PERSONALNY 1:1',hybrid:'HYBRID COACHING',session:'6 tygodni',more:'Szczegóły ustalimy indywidualnie przed zakupem, zgodnie z zasadami odwoływania i przekładania sesji KK Coaching.'
} : {
 label:'NOVEMBER SPECIAL',kicker:'6 weeks. Real progress. Start before January.',
 terms:'New clients only · Available to purchase 1–30 November 2026 · Start date arranged individually · Subject to trainer availability · JD Gyms membership paid separately · Cannot be combined with other discounts · No automatic renewal · Further coaching at standard rates.',
 pt:'PERSONAL TRAINING 1:1',hybrid:'HYBRID COACHING',session:'6 weeks',more:'We will agree your start date and session rescheduling terms before purchase, in line with KK Coaching policies.'
};
---
<article
  class:list={['winter-campaign',isHome?'winter-home':'winter-service']}
  data-promotion-card
  data-promotion-id={offer.id}
  data-enabled={String(offer.enabled)}
  data-start-date={offer.startDate}
  data-end-date={offer.endDate}
  data-auto-disable={String(offer.autoDisableAfterEndDate)}
  aria-label="WINTER KICKSTART 2026"
>
  <header class="winter-header">
    <span class="winter-label"><span class="winter-symbol" aria-hidden="true">✳</span>{offer.headline[lang]}</span>
    <h2>WINTER KICKSTART</h2>
    <p>{text.kicker}</p>
  </header>
  <div class="winter-variants">
    {variants.map(item=>(
      <div class:list={['winter-variant',item.service==='hybrid'&&'is-hybrid']}
        data-winter-variant={item.service==='hybrid'?'hybrid':'pt'}
        data-promotion-id={item.id===offer.id?undefined:item.id}>
        <span class="winter-type">{item.service==='hybrid'?text.hybrid:text.pt}</span>
        <div class="winter-price"><strong>£{item.promotionalPrice}</strong><span>{text.session}</span></div>
        <p class="winter-duration">{item.promotionalPeriod[lang]}</p>
        <p class="winter-duration-note">{item.standardPriceText[lang]}</p>
        <p class="winter-description">{item.offerText[lang]}</p>
        <ul class="winter-features">
          {(item.winterFeatures?.[lang]??[]).map(feature=><li>{feature}</li>)}
        </ul>
        <a class="winter-cta" href={item.ctaDestination[lang]}>{item.ctaText[lang]}<span aria-hidden="true">↗</span></a>
      </div>
    ))}
  </div>
  <footer class="winter-terms">
    <p>{offer.smallPrint[lang]}</p>
    <p>{text.more}</p>
  </footer>
</article>
<style>
  .winter-campaign {min-width:0;overflow:hidden;border:1px solid #4a4e55;border-top:4px solid #d83e54;border-radius:8px;background:linear-gradient(135deg,#25282e,#17191e);box-shadow:0 18px 46px rgba(0,0,0,.22);color:#f7f8fa;}
  .winter-home {grid-column:1/-1;}
  .winter-header {padding:30px 32px 21px;position:relative;background:radial-gradient(ellipse at top right,rgba(175,31,52,.24),transparent 55%);}
  .winter-label {display:inline-flex;align-items:center;gap:8px;color:#ffb1bc;font-size:.72rem;letter-spacing:.14em;font-weight:850;}
  .winter-symbol {font-size:1.1rem;line-height:1;}
  .winter-header h2 {color:#fff;font-size:clamp(2rem,5vw,3.4rem);line-height:1.06;font-weight:900;letter-spacing:-.045em;margin:12px 0 8px;}
  .winter-header p {color:#e3e4e8;font-size:clamp(.96rem,1.8vw,1.12rem);line-height:1.5;}
  .winter-variants {display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;padding:0 26px 24px;}
  .winter-service .winter-variants {grid-template-columns:1fr;}
  .winter-variant {min-width:0;padding:26px 25px;background:#202329;border:1px solid #484d55;border-radius:6px;display:flex;flex-direction:column;}
  .winter-variant.is-hybrid {border:2px solid #d34b61;background:linear-gradient(150deg,#27262d,#202228);}
  .winter-type {color:#ffc2c9;letter-spacing:.11em;font-size:.71rem;font-weight:900;text-transform:uppercase;}
  .winter-price {display:flex;align-items:baseline;flex-wrap:wrap;gap:12px;margin:16px 0 4px;}
  .winter-price strong {color:white;font-size:clamp(3rem,5.5vw,4.3rem);letter-spacing:-.055em;line-height:1;white-space:nowrap;font-variant-numeric:tabular-nums;}
  .winter-price span {color:#cdd1d6;font-size:.83rem;font-weight:700;}
  .winter-duration {font-size:.84rem;color:#f3c5ca;font-weight:800;margin:9px 0 15px;}
  .winter-duration-note {font-size:.79rem;color:#cfd2d8;margin:-8px 0 15px;}
  .winter-description {color:#eff0f3;line-height:1.65;font-size:.95rem;}
  .winter-features {display:grid;gap:9px;list-style:none;padding:0;margin:19px 0 26px;}
  .winter-features li {position:relative;padding-left:23px;font-size:.85rem;color:#e0e3e7;line-height:1.5;}
  .winter-features li:before {content:"✓";position:absolute;left:0;color:#f27384;font-weight:900;}
  .winter-cta {display:flex;align-items:center;justify-content:center;gap:12px;min-height:48px;width:100%;margin-top:auto;padding:13px 16px;color:#fff;text-decoration:none;border-radius:4px;background:#a51f35;font-weight:800;font-size:.88rem;}
  .winter-cta:hover {color:white;background:#c52a44;}
  .winter-cta:focus-visible {outline:3px solid #fff;outline-offset:4px;}
  .winter-terms {margin:0 31px;padding:17px 0 23px;border-top:1px solid #4c5159;color:#d3d6db;}
  .winter-terms p {font-size:.81rem;line-height:1.65;margin:5px 0;}
  @media (max-width:720px) {
    .winter-header {padding:25px 20px 20px;}
    .winter-header h2 {font-size:clamp(1.85rem,8.7vw,2.8rem);}
    .winter-variants {grid-template-columns:1fr;gap:14px;padding:0 16px 19px;}
    .winter-variant {padding:21px 19px;}
    .winter-terms {margin:0 18px;padding:14px 0 20px;}
    .winter-price strong {font-size:3.8rem;}
  }
  @media (max-width:390px) {
    .winter-header h2 {font-size:1.87rem;}
    .winter-price strong {font-size:3.4rem;}
  }
  @media (prefers-reduced-motion:reduce) {.winter-cta {transition:none;}}
</style>

---
import admin from '../data/admin-v2.json';

interface Props {
  lang: 'en' | 'pl';
  limit?: number;
}

const { lang, limit = admin.reviews.homeLimit } = Astro.props;
const settings = admin.reviews;
const items = settings.items
  .filter((item: any) => item.enabled !== false)
  .filter((item: any) => item.featured !== false)
  .slice(0, Math.max(1, limit));
const canRender = settings.enabled && items.length > 0;
const sourceLabels: Record<string, string> = {
  google: lang === 'pl' ? 'Opinia Google' : 'Google Review',
  whatsapp: 'WhatsApp',
  messenger: 'Messenger',
  mypthub: 'MyPTHub',
  instagram: 'Instagram',
  facebook: lang === 'pl' ? 'Rekomendacja Facebook' : 'Facebook recommendation',
  email: 'Email',
  other: lang === 'pl' ? 'Inne' : 'Other'
};
---
{canRender && (
  <section id="client-reviews" class="reviews-section on-white" data-kk-reviews aria-labelledby={`reviews-heading-${lang}`}>
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">{settings.eyebrow[lang]}</span>
        <h2 id={`reviews-heading-${lang}`}>{settings.heading[lang]}</h2>
        <p>{settings.body[lang]}</p>
      </div>
      <div class="reviews-grid">
        {items.map((item: any) => (
          <article class:list={['review-card', { 'review-card--screenshot': Boolean(item.screenshot) }]}>
            {item.screenshot ? (
              <a
                class="review-shot-link"
                href={item.screenshot}
                target="_blank"
                rel="noopener"
                aria-label={lang === 'pl' ? `Otwórz pełną rekomendację: ${item.client}` : `Open full recommendation: ${item.client}`}
              >
                <img
                  class="review-shot"
                  src={item.screenshot}
                  alt={lang === 'pl' ? `Oryginalna rekomendacja ${item.client} na Facebooku` : `Original Facebook recommendation from ${item.client}`}
                  loading="lazy"
                  decoding="async"
                />
              </a>
            ) : (
              <>
                {item.rating && <div class="review-stars" aria-label={`${item.rating} out of 5 stars`}>{'★★★★★'.slice(0, Math.max(0, Math.min(5, Math.round(item.rating))))}</div>}
                {item.quote && <blockquote>“{item.quote}”</blockquote>}
                <div class="review-meta">
                  <strong>{item.client}</strong>
                  {item.source && <span class="review-source">{sourceLabels[item.source] ?? item.source}</span>}
                </div>
              </>
            )}
          </article>
        ))}
      </div>
      {(settings.googleReviewsUrl || settings.leaveGoogleReviewUrl) && (
        <div class="review-actions">
          {settings.googleReviewsUrl && <a class="btn btn-outline-dark" href={settings.googleReviewsUrl} target="_blank" rel="noopener">{settings.seeAllLabel[lang]}</a>}
          {settings.leaveGoogleReviewUrl && <a class="btn btn-primary" href={settings.leaveGoogleReviewUrl} target="_blank" rel="noopener">{settings.leaveReviewLabel[lang]}</a>}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .reviews-section { border-top: 1px solid #E3E5E8; }
  .reviews-grid { columns: 2; column-gap: 18px; }
  .review-card { display: flex; flex-direction: column; min-width: 0; padding: 18px; margin: 0 0 18px; break-inside: avoid; border: 1px solid #E1E4E8; border-radius: var(--radius); background: var(--white); box-shadow: 0 8px 22px rgba(20,22,26,.05); }
  .review-card--screenshot { padding: 8px; }
  .review-stars { color: var(--red); font-size: 1rem; letter-spacing: .08em; font-weight: 800; margin-bottom: 12px; }
  blockquote { margin: 0 0 18px; color: var(--graphite); font-size: .98rem; line-height: 1.65; flex: 1; }
  .review-shot-link {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 10px;
    background: #FFFFFF;
    cursor: zoom-in;
  }
  .review-shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .review-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .review-meta strong { font-size: .92rem; }
  .review-source { display: inline-flex; align-items: center; min-height: 26px; padding: 3px 8px; border-radius: 999px; background: #F1F2F4; color: var(--steel); font-size: .72rem; font-weight: 700; }
  .review-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  @media (max-width: 700px) {
    .reviews-grid { columns: 1; }
    .review-card { padding: 14px; margin-bottom: 16px; }
    .review-card--screenshot { padding: 6px; }
    .review-actions { display: grid; grid-template-columns: 1fr; }
    .review-actions .btn { width: 100%; }
  }
</style>




<script is:inline data-review-dedupe>
  (() => {
    const sections = document.querySelectorAll('#client-reviews');
    sections.forEach((section, index) => {
      if (index > 0) section.remove();
    });
  })()


<script is:inline>
  (() => {
    const sections = Array.from(document.querySelectorAll('.reviews-section'));
    sections.slice(1).forEach((section) => section.remove());
  })();
</script>

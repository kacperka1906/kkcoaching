---
interface Props {
  height?: number;
}
const { height = 34 } = Astro.props;
---
<img
  src="/images/logo.png"
  alt="KK Coaching"
  width={height}
  height={height}
  decoding="async"
  class="site-logo"
  style={`height:${height}px; width:auto;`}
/>

<style>
  .site-logo { display: block; }
</style>

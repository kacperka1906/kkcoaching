---
interface Props {
  height?: number;
}
const { height = 34 } = Astro.props;
const imageWidth = Math.max(128, height * 4);
const optimizedSrc = `/.netlify/images?url=/images/logo.png&w=${imageWidth}&fm=webp&q=82`;
---
<img
  src={optimizedSrc}
  alt="KK Coaching"
  width={height}
  height={height}
  decoding="async"
  class="site-logo"
  style={`height:${height}px; width:auto;`}
/>

<style>
  .site-logo { display: block; }
</style>

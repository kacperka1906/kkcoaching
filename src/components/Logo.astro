---
import admin from '../data/admin-v2.json';

interface Props {
  height?: number;
  footer?: boolean;
}
const { height = 34, footer = false } = Astro.props;
const imageWidth = Math.max(128, height * 4);
const source = footer ? admin.brand.footerLogo : admin.brand.logo;
const optimizedSrc = `/.netlify/images?url=${source}&w=${imageWidth}&fm=webp&q=82`;
---
<img
  src={optimizedSrc}
  alt={admin.brand.siteName}
  width={imageWidth}
  height={height}
  decoding="async"
  class="site-logo"
  style={`height:${height}px; width:auto;`}
/>

<style>
  .site-logo { display: block; }
</style>

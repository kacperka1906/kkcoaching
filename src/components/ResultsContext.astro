---
interface Props { lang: 'en' | 'pl' }
const { lang } = Astro.props;
const isPl = lang === 'pl';

const copy = isPl
  ? {
      eyebrow: 'Co stoi za zdjęciami',
      heading: 'Efekt widać na zdjęciu. Coaching to cały proces, który do niego prowadzi.',
      intro: 'Przemiana nie powstaje od jednego idealnego tygodnia. Największą różnicę robi system, który da się realizować wystarczająco długo i który można poprawiać na podstawie tego, co naprawdę się dzieje.',
      cards: [
        ['Trening z jasnym kierunkiem', 'Plan jest dopasowany do celu i poziomu, a progresja daje konkretny punkt odniesienia z tygodnia na tydzień.'],
        ['Żywienie do normalnego życia', 'Kalorie, makro i nawyki mają pomagać osiągać cel bez budowania planu, którego nie da się utrzymać poza idealnym tygodniem.'],
        ['Dane zamiast zgadywania', 'Patrzymy na trend masy ciała, pomiary, zdjęcia, wyniki treningowe i realizację planu. Zmieniamy tylko to, co faktycznie wymaga zmiany.']
      ],
      note: 'Każda osoba zaczyna z innego miejsca, dlatego rezultaty są indywidualne. To prawdziwe historie przemian związanych z KK Coaching, a nie gwarancja konkretnego wyniku w określonym czasie.',
      cta: 'Zobacz opcje współpracy',
      ctaHref: '/pl/services'
    }
  : {
      eyebrow: 'What sits behind the photos',
      heading: 'The result is visible in the photo. Coaching is the process that gets you there.',
      intro: 'A transformation is not built from one perfect week. The biggest difference comes from a system you can execute for long enough, then improve using what is actually happening rather than guesswork.',
      cards: [
        ['Training with a clear direction', 'Your programme matches the goal and your current level, while progression gives us a clear reference point from week to week.'],
        ['Nutrition that works in real life', 'Calories, macros and habits should move you toward the goal without creating a plan that only works during a perfect week.'],
        ['Data before guesswork', 'We look at body-weight trends, measurements, photos, training performance and adherence. We change things when there is a real reason to change them.']
      ],
      note: 'Everyone starts from a different point, so results are individual. These are real transformation stories connected with KK Coaching, not a promise that every person will achieve the same outcome in the same timeframe.',
      cta: 'Compare coaching options',
      ctaHref: '/services'
    };
---
<section class="results-context on-dark" aria-labelledby={`results-context-heading-${lang}`}>
  <div class="container">
    <div class="section-head centered context-head">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2 id={`results-context-heading-${lang}`}>{copy.heading}</h2>
      <p>{copy.intro}</p>
    </div>

    <div class="context-grid">
      {copy.cards.map(([title, body]) => (
        <article class="context-card">
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>

    <p class="results-note">{copy.note}</p>
    <div class="context-cta">
      <a href={copy.ctaHref} class="btn btn-secondary">{copy.cta}</a>
    </div>
  </div>
</section>

<style>
  .results-context { padding: 76px 0; }
  .context-head h2 { color: var(--white); max-width: 840px; margin-left: auto; margin-right: auto; }
  .context-head p { color: #C5C9CF; max-width: 68ch; margin-left: auto; margin-right: auto; }
  .context-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 34px; }
  .context-card { background: #202329; border: 1px solid #353A42; border-radius: var(--radius); padding: 25px 23px; }
  .context-card h3 { color: var(--white); font-size: 1.05rem; margin-bottom: 9px; }
  .context-card p { color: #BFC4CB; font-size: 0.9rem; }
  .results-note { color: #AEB4BC; max-width: 76ch; margin: 28px auto 0; text-align: center; font-size: 0.82rem; line-height: 1.55; }
  .context-cta { text-align: center; margin-top: 26px; }

  @media (max-width: 760px) {
    .context-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .results-context { padding: 56px 0; }
    .context-card { padding: 21px 18px; }
    .context-cta .btn { width: 100%; }
  }
</style>

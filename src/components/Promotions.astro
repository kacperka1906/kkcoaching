---
import promotions from '../data/promotions.json';
import pricing from '../data/pricing.json';

interface Props {
  lang: 'en' | 'pl';
  placement: 'homepage' | 'service';
  service?: 'online' | 'hybrid' | 'personal-training';
}

const { lang, placement, service } = Astro.props;
const isPl = lang === 'pl';

const serviceLabels = {
  online: { en: 'Online Coaching', pl: 'Coaching online' },
  hybrid: { en: 'Hybrid Coaching', pl: 'Coaching hybrydowy' },
  'personal-training': { en: 'Personal Training', pl: 'Trening personalny' },
  general: { en: 'KK Coaching', pl: 'KK Coaching' },
  all: { en: 'KK Coaching', pl: 'KK Coaching' }
};

const money = (value: number) => `£${Number.isInteger(value) ? value.toFixed(0) : value.toFixed(2)}`;
const octoberDiscount = 0.20;
const discounted = (value: number) => value * (1 - octoberDiscount);
const activePersonal = pricing.personal.packages.filter(plan => plan.enabled && plan.sessions > 0);
const lowestPersonalRate = activePersonal.length
  ? Math.min(...activePersonal.map(plan => plan.price / plan.sessions))
  : null;
const activeHybrid = pricing.hybrid.packages.filter(plan => plan.enabled);
const lowestHybridPrice = activeHybrid.length
  ? Math.min(...activeHybrid.map(plan => plan.price))
  : null;
const fromLabel = pricing.labels.from[lang];

const octoberPriceRows = [
  ...(lowestPersonalRate !== null ? [{
    label: isPl ? 'Trening personalny 1:1' : '1:1 Personal Training',
    standard: `${fromLabel} ${money(lowestPersonalRate)} ${isPl ? '/ trening' : '/ session'}`,
    october: `${fromLabel} ${money(discounted(lowestPersonalRate))} ${isPl ? '/ trening' : '/ session'}`
  }] : []),
  ...(pricing.online.enabled ? [{
    label: isPl ? 'Coaching online' : 'Online Coaching',
    standard: `${money(pricing.online.price)} / ${pricing.online.billingWeeks} ${isPl ? 'tygodnie' : 'weeks'}`,
    october: `${money(discounted(pricing.online.price))} / ${pricing.online.billingWeeks} ${isPl ? 'tygodnie' : 'weeks'}`
  }] : []),
  ...(lowestHybridPrice !== null ? [{
    label: isPl ? 'Coaching hybrydowy' : 'Hybrid Coaching',
    standard: `${fromLabel} ${money(lowestHybridPrice)} / 4 ${isPl ? 'tygodnie' : 'weeks'}`,
    october: `${fromLabel} ${money(discounted(lowestHybridPrice))} / 4 ${isPl ? 'tygodnie' : 'weeks'}`
  }] : []),
  ...(pricing.trainingPlan.enabled ? [{
    label: isPl ? 'Indywidualny plan treningowy' : 'Training Plan',
    standard: `${money(pricing.trainingPlan.price)} · ${pricing.labels.oneOff[lang]}`,
    october: `${money(discounted(pricing.trainingPlan.price))} · ${pricing.labels.oneOff[lang]}`
  }] : [])
];

const polishSpaces = (count: number) => {
  if (count === 1) return `ZOSTAŁO ${count} MIEJSCE`;
  const lastTwo = count % 100;
  const last = count % 10;
  if (last >= 2 && last <= 4 && !(lastTwo >= 12 && lastTwo <= 14)) return `ZOSTAŁY ${count} MIEJSCA`;
  return `ZOSTAŁO ${count} MIEJSC`;
};

const spacesLabel = (offer: (typeof promotions.offers)[number]) => {
  const total = Math.max(0, Math.trunc(offer.totalSpaces));
  const remaining = Math.min(total, Math.max(0, Math.trunc(offer.remainingSpaces)));
  if (remaining >= total) return isPl ? `OFERTA DLA ${total} NOWYCH KLIENTÓW` : `LIMITED TO ${total} NEW CLIENTS`;
  return isPl ? polishSpaces(remaining) : `${remaining} ${remaining === 1 ? 'SPACE' : 'SPACES'} REMAINING`;
};

const dateKeyInLondon = (date: Date) => {
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/London',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).formatToParts(date);
  const map = Object.fromEntries(parts.map(part => [part.type, part.value]));
  return `${map.year}-${map.month}-${map.day}`;
};

const today = dateKeyInLondon(new Date());

const candidateOffers = promotions.offers
  .filter(offer => {
    if (!offer.enabled) return false;
    if (placement === 'homepage') return offer.display.homepage;
    if (!offer.display.servicePage || !service) return false;
    return offer.service === service || offer.service === 'all';
  })
  .sort((a, b) => Number(b.featured) - Number(a.featured) || b.priority - a.priority);

const preparedOffers = candidateOffers.map(offer => {
  const startsNow = !offer.startDate || today >= offer.startDate;
  const beforeEnd = !offer.autoDisableAfterEndDate || !offer.endDate || today <= offer.endDate;
  return { offer, initiallyVisible: startsNow && beforeEnd };
});

const hasInitiallyVisible = preparedOffers.some(item => item.initiallyVisible);
const sectionLabel = isPl ? 'Aktualne promocje' : 'Current offers';
---
{candidateOffers.length > 0 && (
  <section
    class:list={['promotion-section', placement === 'homepage' ? 'promotion-home' : 'promotion-service', 'on-dark']}
    data-promotions-section
    hidden={!hasInitiallyVisible}
    aria-label={sectionLabel}
  >
    <div class="container">
      {placement === 'homepage' && <span class="promotion-section-label">{sectionLabel}</span>}
      <div class="promotion-grid">
        {preparedOffers.map(({ offer, initiallyVisible }) => (
          <article
            class:list={['promotion-card', offer.featured && 'is-featured']}
            data-promotion-card
            data-promotion-id={offer.id}
            data-start-date={offer.startDate}
            data-end-date={offer.endDate}
            data-auto-disable={offer.autoDisableAfterEndDate ? 'true' : 'false'}
            hidden={!initiallyVisible}
          >
            <div class="promotion-main">
              <div class="promotion-meta">
                <span class="service-badge">{serviceLabels[offer.service][lang]}</span>
                <span class="promotion-eyebrow">{offer.headline[lang]}</span>
              </div>

              {offer.showPrice ? (
                <div class="price-wrap">
                  <div class="promotion-price" aria-label={`${money(offer.promotionalPrice)} ${offer.promotionalPeriod[lang]}`}>
                    <strong>{money(offer.promotionalPrice)}</strong>
                    <span>{offer.promotionalPeriod[lang]}</span>
                  </div>
                  <p class="standard-price">{offer.standardPriceText[lang]}</p>
                </div>
              ) : offer.id === 'october-2026-20-off-everything' ? (
                <div class="october-offer">
                  <h2>{offer.title[lang]}</h2>
                  <p class="offer-text">{offer.offerText[lang]}</p>
                  <div class="october-price-table" role="table" aria-label={isPl ? 'Ceny standardowe i październikowe' : 'Standard and October prices'}>
                    <div class="october-price-row october-price-head" role="row">
                      <span role="columnheader"></span>
                      <span role="columnheader">{isPl ? 'Standard' : 'Standard'}</span>
                      <span role="columnheader">{isPl ? 'Październik' : 'October'}</span>
                    </div>
                    {octoberPriceRows.map(row => (
                      <div class="october-price-row" role="row">
                        <strong role="rowheader">{row.label}</strong>
                        <span class="october-standard" role="cell"><span class="mobile-price-label">{isPl ? 'Standard:' : 'Standard:'}</span>{row.standard}</span>
                        <span class="october-now" role="cell"><span class="mobile-price-label">{isPl ? 'Październik:' : 'October:'}</span>{row.october}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <>
                  <h2>{offer.title[lang]}</h2>
                  <p class="offer-text">{offer.offerText[lang]}</p>
                </>
              )}

              {offer.showSpaces && <div class="spaces-badge">{spacesLabel(offer)}</div>}
            </div>

            <div class="promotion-action">
              <a href={offer.ctaDestination[lang]} class="btn btn-primary">{offer.ctaText[lang]}</a>
              <p class="small-print">{offer.smallPrint[lang]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{candidateOffers.length > 0 && (
  <script is:inline>
    (() => {
      const sections = [...document.querySelectorAll('[data-promotions-section]')];
      if (!sections.length) return;

      const londonDateKey = (date) => {
        const parts = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).formatToParts(date);
        const map = Object.fromEntries(parts.map(part => [part.type, part.value]));
        return `${map.year}-${map.month}-${map.day}`;
      };

      const today = londonDateKey(new Date());

      sections.forEach((section) => {
        const cards = [...section.querySelectorAll('[data-promotion-card]')];
        let visibleCount = 0;

        cards.forEach((card) => {
          const start = card.dataset.startDate || '';
          const end = card.dataset.endDate || '';
          const autoDisable = card.dataset.autoDisable === 'true';
          const afterStart = !start || today >= start;
          const beforeEnd = !autoDisable || !end || today <= end;
          const visible = afterStart && beforeEnd;
          card.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        section.hidden = visibleCount === 0;
      });
    })();
  </script>
)}

<style>
  .promotion-section {
    background: var(--graphite);
    padding: 34px 0 58px;
  }

  .promotion-home { padding-top: 26px; }
  .promotion-service { padding-top: 14px; }

  .promotion-section-label {
    display: block;
    color: #F4B5BC;
    font-size: .74rem;
    line-height: 1.2;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .promotion-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }

  .promotion-card {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(250px, .92fr);
    gap: 28px;
    align-items: center;
    background: #202329;
    border: 1px solid #3B4048;
    border-left: 4px solid #555B64;
    border-radius: var(--radius);
    padding: 26px 28px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, .16);
  }

  .promotion-card.is-featured { border-left-color: var(--red); }

  .promotion-home .promotion-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px;
  }

  .promotion-home .promotion-card {
    grid-template-columns: 1fr;
    gap: 18px;
    padding: 22px;
    align-content: start;
  }

  .promotion-home .promotion-action {
    border-left: 0;
    border-top: 1px solid #3A3E45;
    padding-left: 0;
    padding-top: 18px;
  }

  .promotion-home .promotion-price strong {
    font-size: clamp(2.8rem, 4.7vw, 3.7rem);
  }

  .promotion-meta {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .service-badge,
  .promotion-eyebrow,
  .spaces-badge {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    border-radius: 999px;
    padding: 7px 11px;
    font-size: .69rem;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: .065em;
    text-transform: uppercase;
  }

  .service-badge {
    background: #30343B;
    color: #F1F2F4;
    border: 1px solid #444A53;
  }

  .promotion-eyebrow {
    color: #F4B5BC;
    border: 1px solid #5B3C42;
    background: #2A2225;
  }

  .spaces-badge {
    color: #F1C1C6;
    border: 1px solid #6A3A41;
    background: transparent;
    margin-top: 17px;
  }

  .promotion-card h2 {
    color: var(--white);
    font-size: clamp(1.55rem, 3vw, 2.25rem);
    line-height: 1.08;
    margin: 0 0 10px;
  }

  .offer-text {
    color: #D3D6DA;
    max-width: 58ch;
  }

  .october-offer .offer-text { margin-bottom: 18px; }

  .october-price-table {
    display: grid;
    gap: 0;
    border: 1px solid #3B4048;
    border-radius: 12px;
    overflow: hidden;
    background: #1B1E23;
  }

  .october-price-row {
    display: grid;
    grid-template-columns: minmax(160px, 1.15fr) minmax(120px, .85fr) minmax(120px, .85fr);
    align-items: center;
    gap: 12px;
    padding: 11px 13px;
    border-top: 1px solid #343942;
  }

  .october-price-row:first-child { border-top: 0; }

  .october-price-head {
    background: #262A30;
    color: #AEB3BA;
    font-size: .67rem;
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .october-price-row strong {
    color: #F2F3F4;
    font-size: .82rem;
    line-height: 1.25;
  }

  .october-standard {
    color: #AEB3BA;
    font-size: .79rem;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .october-now {
    color: #FFD6DA;
    font-size: .84rem;
    font-weight: 900;
  }

  .mobile-price-label { display: none; }

  .price-wrap { margin-top: 2px; }

  .promotion-price {
    display: flex;
    align-items: flex-end;
    gap: 11px;
    flex-wrap: wrap;
  }

  .promotion-price strong {
    color: var(--white);
    font-size: clamp(3rem, 5.4vw, 4.35rem);
    line-height: .88;
    letter-spacing: -.05em;
  }

  .promotion-price span {
    color: #F4F5F6;
    font-size: .96rem;
    font-weight: 900;
    line-height: 1.08;
    text-transform: uppercase;
    padding-bottom: 4px;
    max-width: 13ch;
  }

  .standard-price {
    color: #C7CBD0;
    font-size: .92rem;
    font-weight: 700;
    margin-top: 13px;
  }

  .promotion-action {
    border-left: 1px solid #3A3E45;
    padding-left: 28px;
  }

  .promotion-action .btn {
    width: 100%;
    text-align: center;
    justify-content: center;
  }

  .small-print {
    color: #AEB3BA;
    font-size: .76rem;
    line-height: 1.5;
    margin-top: 13px;
  }

  [hidden] { display: none !important; }

  @media (max-width: 980px) {
    .promotion-card {
      grid-template-columns: 1fr;
      gap: 21px;
    }

    .promotion-action {
      border-left: 0;
      border-top: 1px solid #3A3E45;
      padding-left: 0;
      padding-top: 21px;
    }
  }

  @media (max-width: 620px) {
    .promotion-section { padding: 20px 0 40px; }
    .promotion-service { padding-top: 10px; }
    .promotion-card { padding: 20px 17px; gap: 18px; }
    .promotion-meta { margin-bottom: 18px; }
    .service-badge,
    .promotion-eyebrow { justify-content: center; text-align: center; }
    .promotion-price strong { font-size: clamp(3rem, 15vw, 3.9rem); }
    .promotion-price span { font-size: .82rem; max-width: 10ch; }
    .standard-price { font-size: .88rem; margin-top: 11px; }
    .spaces-badge { width: auto; max-width: 100%; justify-content: center; text-align: center; margin-top: 15px; }
    .promotion-action { padding-top: 18px; }
    .small-print { font-size: .73rem; }
    .october-price-row {
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 12px 13px;
    }
    .october-price-head { display: none; }
    .mobile-price-label {
      display: inline;
      margin-right: 5px;
      font-weight: 800;
      text-decoration: none;
    }
  }
</style>

---
import promotions from '../data/promotions.json';

interface Props {
  lang: 'en' | 'pl';
  placement: 'homepage' | 'service';
  service?: 'online' | 'hybrid' | 'personal-training';
}

const { lang, placement, service } = Astro.props;
const isPl = lang === 'pl';

const serviceLabels = {
  online: { en: 'Online Coaching', pl: 'Coaching online' },
  hybrid: { en: 'Hybrid Coaching', pl: 'Coaching hybrydowy' },
  'personal-training': { en: 'Personal Training', pl: 'Trening personalny' },
  general: { en: 'KK Coaching', pl: 'KK Coaching' },
  all: { en: 'KK Coaching', pl: 'KK Coaching' }
};

const money = (value: number) => `£${Number.isInteger(value) ? value.toFixed(0) : value.toFixed(2)}`;

const polishSpaces = (count: number) => {
  if (count === 1) return `ZOSTAŁO ${count} MIEJSCE`;
  const lastTwo = count % 100;
  const last = count % 10;
  if (last >= 2 && last <= 4 && !(lastTwo >= 12 && lastTwo <= 14)) return `ZOSTAŁY ${count} MIEJSCA`;
  return `ZOSTAŁO ${count} MIEJSC`;
};

const spacesLabel = (offer: (typeof promotions.offers)[number]) => {
  const total = Math.max(0, Math.trunc(offer.totalSpaces));
  const remaining = Math.min(total, Math.max(0, Math.trunc(offer.remainingSpaces)));
  if (remaining >= total) return isPl ? `${total} MIEJSC DLA NOWYCH KLIENTÓW` : `${total} NEW CLIENT SPACES`;
  return isPl ? polishSpaces(remaining) : `${remaining} ${remaining === 1 ? 'SPACE' : 'SPACES'} REMAINING`;
};

const dateKeyInLondon = (date: Date) => {
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/London',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).formatToParts(date);
  const map = Object.fromEntries(parts.map(part => [part.type, part.value]));
  return `${map.year}-${map.month}-${map.day}`;
};

const today = dateKeyInLondon(new Date());

const candidateOffers = promotions.offers
  .filter(offer => {
    if (!offer.enabled) return false;
    if (placement === 'homepage') return offer.display.homepage;
    if (!offer.display.servicePage || !service) return false;
    return offer.service === service || offer.service === 'all';
  })
  .sort((a, b) => Number(b.featured) - Number(a.featured) || b.priority - a.priority);

const preparedOffers = candidateOffers.map(offer => {
  const startsNow = !offer.startDate || today >= offer.startDate;
  const beforeEnd = !offer.autoDisableAfterEndDate || !offer.endDate || today <= offer.endDate;
  return { offer, initiallyVisible: startsNow && beforeEnd };
});

const hasInitiallyVisible = preparedOffers.some(item => item.initiallyVisible);
const sectionLabel = isPl ? 'Aktualne promocje' : 'Current offers';
---
{candidateOffers.length > 0 && (
  <section
    class:list={['promotion-section', placement === 'homepage' ? 'promotion-home' : 'promotion-service', 'on-dark']}
    data-promotions-section
    hidden={!hasInitiallyVisible}
    aria-label={sectionLabel}
  >
    <div class="container">
      {placement === 'homepage' && <span class="promotion-section-label">{sectionLabel}</span>}
      <div class="promotion-grid">
        {preparedOffers.map(({ offer, initiallyVisible }) => (
          <article
            class:list={['promotion-card', offer.featured && 'is-featured']}
            data-promotion-card
            data-promotion-id={offer.id}
            data-start-date={offer.startDate}
            data-end-date={offer.endDate}
            data-auto-disable={offer.autoDisableAfterEndDate ? 'true' : 'false'}
            hidden={!initiallyVisible}
          >
            <div class="promotion-main">
              <div class="promotion-meta">
                <span class="service-badge">{serviceLabels[offer.service][lang]}</span>
                <span class="promotion-eyebrow">{offer.headline[lang]}</span>
              </div>
              <h2>{offer.title[lang]}</h2>
              <p class="offer-text">{offer.offerText[lang]}</p>

              {offer.showSpaces && <div class="spaces-badge">{spacesLabel(offer)}</div>}

              {offer.showPrice && (
                <div class="price-wrap">
                  <div class="promotion-price" aria-label={`${money(offer.promotionalPrice)} ${offer.promotionalPeriod[lang]}`}>
                    <strong>{money(offer.promotionalPrice)}</strong>
                    <span>{offer.promotionalPeriod[lang]}</span>
                  </div>
                  <p class="standard-price">{offer.standardPriceText[lang]}</p>
                </div>
              )}
            </div>

            <div class="promotion-action">
              <a href={offer.ctaDestination[lang]} class="btn btn-primary">{offer.ctaText[lang]}</a>
              <p class="small-print">{offer.smallPrint[lang]}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

{candidateOffers.length > 0 && (
  <script is:inline>
    (() => {
      const section = document.querySelector('[data-promotions-section]');
      if (!section) return;

      const londonDateKey = (date) => {
        const parts = new Intl.DateTimeFormat('en-GB', {
          timeZone: 'Europe/London',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit'
        }).formatToParts(date);
        const map = Object.fromEntries(parts.map(part => [part.type, part.value]));
        return `${map.year}-${map.month}-${map.day}`;
      };

      const today = londonDateKey(new Date());
      const cards = [...section.querySelectorAll('[data-promotion-card]')];
      let visibleCount = 0;

      cards.forEach((card) => {
        const start = card.dataset.startDate || '';
        const end = card.dataset.endDate || '';
        const autoDisable = card.dataset.autoDisable === 'true';
        const afterStart = !start || today >= start;
        const beforeEnd = !autoDisable || !end || today <= end;
        const visible = afterStart && beforeEnd;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      section.hidden = visibleCount === 0;
    })();
  </script>
)}

<style>
  .promotion-section {
    background: var(--graphite);
    padding: 38px 0 64px;
  }

  .promotion-home { padding-top: 28px; }
  .promotion-service { padding-top: 18px; }

  .promotion-section-label {
    display: block;
    color: #F4B5BC;
    font-size: .76rem;
    line-height: 1.2;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .promotion-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 22px;
  }

  .promotion-card {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, .9fr);
    gap: 28px;
    align-items: center;
    background: #202329;
    border: 1px solid #3B4048;
    border-left: 5px solid #555B64;
    border-radius: var(--radius);
    padding: 28px 30px;
    box-shadow: 0 18px 46px rgba(0, 0, 0, .18);
  }

  .promotion-card.is-featured { border-left-color: var(--red); }

  .promotion-meta {
    display: flex;
    gap: 9px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .service-badge,
  .promotion-eyebrow,
  .spaces-badge {
    display: inline-flex;
    align-items: center;
    min-height: 31px;
    border-radius: 999px;
    padding: 7px 11px;
    font-size: .7rem;
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: .07em;
    text-transform: uppercase;
  }

  .service-badge { background: #30343B; color: #F1F2F4; border: 1px solid #444A53; }
  .promotion-eyebrow { color: #F4B5BC; border: 1px solid #5B3C42; background: #2A2225; }
  .spaces-badge { background: var(--red); color: var(--white); margin-top: 17px; }

  .promotion-card h2 {
    color: var(--white);
    font-size: clamp(1.55rem, 3vw, 2.35rem);
    line-height: 1.08;
    margin: 0 0 10px;
  }

  .offer-text { color: #D3D6DA; max-width: 58ch; }
  .price-wrap { margin-top: 21px; }
  .promotion-price { display: flex; align-items: flex-end; gap: 11px; flex-wrap: wrap; }
  .promotion-price strong { color: var(--white); font-size: clamp(3rem, 6vw, 4.8rem); line-height: .86; letter-spacing: -.055em; }
  .promotion-price span { color: #F4F5F6; font-size: 1rem; font-weight: 900; line-height: 1.05; text-transform: uppercase; padding-bottom: 5px; }
  .standard-price { color: #BFC4CA; font-size: .9rem; font-weight: 700; margin-top: 12px; }

  .promotion-action {
    border-left: 1px solid #3A3E45;
    padding-left: 28px;
  }

  .promotion-action .btn { width: 100%; text-align: center; justify-content: center; }
  .small-print { color: #BFC4CA; font-size: .78rem; line-height: 1.52; margin-top: 14px; }
  [hidden] { display: none !important; }

  @media (max-width: 980px) {
    .promotion-card { grid-template-columns: 1fr; gap: 22px; }
    .promotion-action { border-left: 0; border-top: 1px solid #3A3E45; padding-left: 0; padding-top: 22px; }
  }

  @media (max-width: 620px) {
    .promotion-section { padding: 24px 0 46px; }
    .promotion-card { padding: 22px 18px; gap: 19px; }
    .promotion-meta { align-items: stretch; }
    .service-badge, .promotion-eyebrow { justify-content: center; text-align: center; }
    .promotion-card h2 { font-size: clamp(1.45rem, 8vw, 2rem); }
    .spaces-badge { width: 100%; justify-content: center; text-align: center; }
    .promotion-price strong { font-size: clamp(3.15rem, 18vw, 4.6rem); }
    .promotion-price span { font-size: .9rem; max-width: 11ch; }
    .small-print { font-size: .75rem; }
  }
</style>

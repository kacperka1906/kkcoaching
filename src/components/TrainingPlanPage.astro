---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import pricing from '../data/pricing.json';
import copy from '../data/training-plan-v2.json';

interface Props { lang: 'en' | 'pl' }
const { lang } = Astro.props;
const isPl = lang === 'pl';
const services = await getCollection('services');
const service = services.find(item => item.id.startsWith(`${lang}/`) && item.id.includes('training-plan'));
if (!service) throw new Error(`Missing ${lang} training-plan service content`);
const price = pricing.trainingPlan.price;
const money = `${pricing.currency}${Number.isInteger(price) ? price.toFixed(0) : price.toFixed(2)}`;
const faqs = copy.faq.items.map(item => ({ q: item.q[lang], a: item.a[lang] }));
const path = isPl ? '/pl/training-plan' : '/training-plan';
const altPath = isPl ? '/training-plan' : '/pl/training-plan';
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', '@id': `https://kkcoaching.fit${path}#service`, name: isPl ? 'Indywidualny plan treningowy' : 'Personalised Training Plan', serviceType: 'Personalised Training Programme', description: copy.seo.description[lang], url: `https://kkcoaching.fit${path}`, provider: { '@id': 'https://kkcoaching.fit/#business' }, areaServed: { '@type': 'Country', name: 'United Kingdom' }, offers: { '@type': 'Offer', priceCurrency: 'GBP', price, availability: 'https://schema.org/InStock', url: `https://kkcoaching.fit${path}` } },
    { '@type': 'FAQPage', mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
  ]
};
---
<BaseLayout title={copy.seo.title[lang]} description={copy.seo.description[lang]} lang={lang} path={path} altPath={altPath} structuredData={structuredData} socialImage={service.data.image} socialImageAlt={service.data.imageAlt}>
  <section class="plan-hero on-dark"><div class="container hero-grid"><div class="hero-copy"><span class="eyebrow">{copy.hero.eyebrow[lang]}</span><h1>{copy.hero.heading[lang]}</h1><p class="lead">{copy.hero.lead[lang]}</p><div class="price-line"><strong>{money}</strong><span>{copy.hero.oneOffLabel[lang]}</span></div><div class="hero-actions"><a href={copy.hero.primaryHref[lang]} class="btn btn-primary">{copy.hero.primaryCta[lang]}</a><a href={copy.hero.secondaryHref[lang]} class="btn btn-secondary">{copy.hero.secondaryCta[lang]}</a></div><p class="scope-note">{copy.hero.scopeNote[lang]}</p></div><div class="hero-media"><img src={service.data.image} alt={service.data.imageAlt} width="720" height="540" loading="eager" fetchpriority="high" decoding="async" /></div></div></section>
  <section class="on-white" aria-labelledby={`fit-heading-${lang}`}><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.fit.eyebrow[lang]}</span><h2 id={`fit-heading-${lang}`}>{copy.fit.heading[lang]}</h2><p>{copy.fit.body[lang]}</p></div><div class="three-grid">{copy.fit.cards.map(item => <article class="info-card"><h3>{item.title[lang]}</h3><p>{item.body[lang]}</p></article>)}</div></div></section>
  <section class="on-dark" aria-labelledby={`included-heading-${lang}`}><div class="container split"><div><span class="eyebrow">{copy.included.eyebrow[lang]}</span><h2 id={`included-heading-${lang}`}>{copy.included.heading[lang]}</h2><p class="dark-copy">{copy.included.body[lang]}</p></div><ul class="check-list">{service.data.bullets.map(item => <li>{item}</li>)}</ul></div></section>
  <section aria-labelledby={`process-heading-${lang}`}><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.process.eyebrow[lang]}</span><h2 id={`process-heading-${lang}`}>{copy.process.heading[lang]}</h2></div><div class="process-grid">{copy.process.steps.map(item => <article class="process-card"><span class="num">{item.num}</span><h3>{item.title[lang]}</h3><p>{item.body[lang]}</p></article>)}</div></div></section>
  <section class="compare on-white" aria-labelledby={`compare-heading-${lang}`}><div class="container compare-grid"><div><span class="eyebrow">{copy.compare.eyebrow[lang]}</span><h2 id={`compare-heading-${lang}`}>{copy.compare.heading[lang]}</h2><p>{copy.compare.body[lang]}</p></div><div class="compare-links">{copy.compare.links.map(item => <a href={item.href[lang]}><strong>{item.title[lang]}</strong><span>{item.body[lang]}</span></a>)}</div></div></section>
  <section aria-labelledby={`faq-heading-${lang}`}><div class="container faq-wrap"><div class="section-head centered"><span class="eyebrow">{copy.faq.eyebrow[lang]}</span><h2 id={`faq-heading-${lang}`}>{copy.faq.heading[lang]}</h2></div><div class="faq-list">{faqs.map(item => <details class="faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></div></section>
  <section class="final-cta"><div class="container"><span class="eyebrow light">{copy.finalCta.eyebrow[lang]}</span><h2>{copy.finalCta.heading[lang]}</h2><p>{copy.finalCta.body[lang]}</p><a href={copy.finalCta.href[lang]} class="btn btn-secondary">{copy.finalCta.cta[lang]}</a></div></section>
</BaseLayout>

<style>
  .plan-hero { padding: 72px 0; }
  .hero-grid, .split, .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .hero-copy h1 { color: var(--white); font-size: clamp(2.15rem, 5vw, 4rem); max-width: 13ch; margin-bottom: 18px; }
  .hero-copy .lead { color: #D3D6DA; font-size: 1.08rem; max-width: 56ch; }
  .price-line { display: flex; align-items: baseline; gap: 9px; margin-top: 22px; }
  .price-line strong { color: #F2F3F4; font-size: clamp(2rem, 4vw, 3rem); line-height: 1; }
  .price-line span { color: #C8CCD2; font-weight: 700; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 26px 0 16px; }
  .scope-note { color: #AEB4BC; font-size: 0.82rem; }
  .hero-media img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); border: 1px solid #363A40; }
  .three-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .info-card, .process-card { background: var(--white); border: 1px solid #E2E4E7; border-radius: var(--radius); padding: 28px 24px; }
  .info-card { border-top: 3px solid var(--red); }
  .info-card h3, .process-card h3 { font-size: 1.06rem; margin-bottom: 10px; }
  .info-card p, .process-card p { color: var(--steel); font-size: 0.93rem; }
  .dark-copy { color: #C0C4CA; max-width: 58ch; }
  .check-list { list-style: none; display: grid; gap: 12px; }
  .check-list li { position: relative; padding: 13px 16px 13px 44px; background: #202329; border: 1px solid #333840; border-radius: var(--radius); color: #D4D7DB; }
  .check-list li::before { content: '✓'; position: absolute; left: 16px; color: #F18B97; font-weight: 900; }
  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .process-card .num { color: var(--red); font-weight: 900; font-size: 0.78rem; letter-spacing: 0.08em; }
  .compare-links { display: grid; gap: 12px; }
  .compare-links a { display: grid; gap: 3px; padding: 18px 20px; border: 1px solid #DDE0E4; background: var(--white); color: var(--graphite); text-decoration: none; border-radius: var(--radius); }
  .compare-links a:hover { border-color: var(--red); }
  .compare-links span { color: var(--steel); font-size: 0.88rem; }
  .faq-wrap { max-width: 900px; }
  .faq-list { display: grid; gap: 10px; }
  .faq-item { background: var(--white); border: 1px solid #DFE2E6; border-radius: var(--radius); padding: 0 18px; }
  .faq-item summary { cursor: pointer; font-weight: 800; padding: 18px 0; }
  .faq-item p { color: var(--steel); padding: 0 0 18px; }
  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 88px 0; }
  .final-cta h2 { color: var(--white); }
  .final-cta p { color: #F3D7DA; max-width: 58ch; margin: 0 auto 28px; }
  .eyebrow.light { color: #FFDCE0; }
  @media (max-width: 900px) { .hero-grid, .split, .compare-grid { grid-template-columns: 1fr; gap: 34px; } .process-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) { .three-grid { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .plan-hero { padding: 52px 0; } .hero-copy h1 { font-size: clamp(2rem, 10vw, 2.7rem); } .hero-actions { display: grid; grid-template-columns: 1fr; } .hero-actions .btn, .final-cta .btn { width: 100%; } .process-grid { grid-template-columns: 1fr; } }
</style>

---
import siteEn from '../data/site.en.json';

interface Props { lang: 'en' | 'pl' }
const { lang } = Astro.props;
const isPl = lang === 'pl';
const siteUrl = 'https://kkcoaching.fit';
const personId = `${siteUrl}/#kacper-kaszowski`;
const aboutUrl = `${siteUrl}${isPl ? '/pl/about' : '/about'}`;
const sameAs = [siteEn.meta.instagramUrl, siteEn.meta.facebookUrl].filter(Boolean);
const image = `${siteUrl}/images/kacper-kaszowski-personal-trainer-cwmbran.jpg`;

const articles = isPl
  ? [
      { '@id': `${siteUrl}/pl/resources/jak-wybrac-trenera-personalnego-cwmbran#article` },
      { '@id': `${siteUrl}/pl/resources/trener-personalny-online-uk-jak-to-dziala#article` }
    ]
  : [
      { '@id': `${siteUrl}/resources/choosing-personal-trainer-cwmbran#article` },
      { '@id': `${siteUrl}/resources/online-personal-training-uk#article` }
    ];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${aboutUrl}#profile`,
  url: aboutUrl,
  dateModified: '2026-08-12T12:00:00+01:00',
  mainEntity: {
    '@type': 'Person',
    '@id': personId,
    name: 'Kacper Kaszowski',
    jobTitle: isPl ? 'Trener personalny' : 'Personal Trainer',
    url: `${siteUrl}/about`,
    image,
    sameAs,
    knowsLanguage: ['English', 'Polish'],
    hasCredential: [
      {
        '@type': 'EducationalOccupationalCredential',
        name: 'Level 3 Certificate in Planning and Delivering Personal Training',
        credentialCategory: 'Professional qualification',
        educationalLevel: 'Level 3'
      },
      {
        '@type': 'EducationalOccupationalCredential',
        name: 'Level 2 Diploma in Gym Instructing',
        credentialCategory: 'Professional qualification',
        educationalLevel: 'Level 2'
      }
    ]
  },
  hasPart: articles
};
---
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

---
interface Props { lang: 'en' | 'pl' }
const { lang } = Astro.props;
const prefix = lang === 'pl' ? '/pl' : '';

const t = lang === 'pl'
  ? {
      text: 'Używamy plików cookie do analityki (Google Analytics), aby rozumieć ruch na stronie. Analityczne cookies uruchamiają się dopiero po Twojej zgodzie.',
      accept: 'Akceptuję',
      reject: 'Odrzuć opcjonalne',
      policy: 'Polityka cookies',
      label: 'Ustawienia zgody na cookies'
    }
  : {
      text: 'We use analytics cookies (Google Analytics) to understand site traffic. Analytics cookies only run after you consent.',
      accept: 'Accept',
      reject: 'Reject optional',
      policy: 'Cookie Policy',
      label: 'Cookie consent settings'
    };
---
<div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" aria-label={t.label} hidden>
  <div class="cookie-banner__inner">
    <p>{t.text} <a href={`${prefix}/cookies`}>{t.policy}</a></p>
    <div class="cookie-banner__actions">
      <button id="cookie-reject" type="button" class="btn btn-outline-dark">{t.reject}</button>
      <button id="cookie-accept" type="button" class="btn btn-primary">{t.accept}</button>
    </div>
  </div>
</div>

<script>
  // GA4 is injected only after explicit analytics consent. Visitors can reopen this
  // preference control from the footer and withdraw consent at any time.
  const STORAGE_KEY = 'kk_cookie_consent'; // 'accepted' | 'rejected'
  const GA_MEASUREMENT_ID = 'G-LFHEZ5ETW8';
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const reject = document.getElementById('cookie-reject');
  const settingsTriggers = document.querySelectorAll('[data-cookie-settings]');

  function showBanner() {
    banner?.removeAttribute('hidden');
    window.setTimeout(() => accept?.focus(), 0);
  }

  function hideBanner() {
    banner?.setAttribute('hidden', '');
  }

  function loadAnalyticsIfConsented() {
    if (localStorage.getItem(STORAGE_KEY) === 'accepted') {
      window.dispatchEvent(new CustomEvent('kk-analytics-consent-granted'));
    }
  }

  function clearAnalyticsCookies() {
    const cookieNames = document.cookie
      .split(';')
      .map(cookie => cookie.split('=')[0]?.trim())
      .filter(Boolean)
      .filter(name => name === '_gid' || name === '_gat' || name.startsWith('_ga'));

    for (const name of cookieNames) {
      document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
      document.cookie = `${name}=; Max-Age=0; path=/; domain=.kkcoaching.fit; SameSite=Lax`;
    }
  }

  const existing = localStorage.getItem(STORAGE_KEY);
  if (!existing) {
    showBanner();
  } else {
    loadAnalyticsIfConsented();
  }

  settingsTriggers.forEach(trigger => {
    trigger.addEventListener('click', showBanner);
  });

  accept?.addEventListener('click', () => {
    localStorage.setItem(STORAGE_KEY, 'accepted');
    hideBanner();
    window.dispatchEvent(new CustomEvent('kk-analytics-consent-granted'));
  });

  reject?.addEventListener('click', () => {
    const analyticsWasActive = localStorage.getItem(STORAGE_KEY) === 'accepted' || Boolean(window.__gaLoaded);
    localStorage.setItem(STORAGE_KEY, 'rejected');
    window[`ga-disable-${GA_MEASUREMENT_ID}`] = true;
    clearAnalyticsCookies();
    hideBanner();
    window.dispatchEvent(new CustomEvent('kk-analytics-consent-withdrawn'));

    // A reload guarantees that the injected GA script is removed after consent is withdrawn.
    if (analyticsWasActive) window.location.reload();
  });
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    background: var(--graphite);
    color: var(--off-white);
    z-index: 200;
    padding: 18px 24px;
    box-shadow: 0 -4px 16px rgba(0,0,0,0.25);
  }
  .cookie-banner__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cookie-banner__inner p { font-size: 0.85rem; color: #C7CBD1; max-width: 60ch; }
  .cookie-banner__inner a { color: var(--white); text-decoration: underline; }
  .cookie-banner__actions { display: flex; gap: 10px; flex-shrink: 0; }
  .cookie-banner__actions .btn { padding: 10px 18px; font-size: 0.85rem; }
  .cookie-banner__actions .btn-outline-dark { color: var(--off-white); border-color: #454A52; }
  .cookie-banner__actions .btn-outline-dark:hover { background: #23262c; }

  @media (max-width: 560px) {
    .cookie-banner { padding: 16px 18px; }
    .cookie-banner__actions { width: 100%; }
    .cookie-banner__actions .btn { flex: 1 1 0; }
  }
</style>

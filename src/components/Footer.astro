---
import Logo from './Logo.astro';
import TrainingLocation from './TrainingLocation.astro';
import BusinessEntity from './BusinessEntity.astro';
import AuthorProfilePageSchema from './AuthorProfilePageSchema.astro';
import ServicePricing from './ServicePricing.astro';
import admin from '../data/admin-v2.json';

interface Props { lang: 'en' | 'pl' }
const { lang } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const locationPages = new Set(['/', '/pl', '/services', '/pl/services', '/hybrid-coaching', '/pl/hybrid-coaching']);
const pricingPages = new Set(['/personal-training-cwmbran', '/online-coaching', '/hybrid-coaching', '/pl/personal-training-cwmbran', '/pl/online-coaching', '/pl/hybrid-coaching']);
const showTrainingLocation = locationPages.has(pathname) && admin.location.enabled;
const showPricing = pricingPages.has(pathname);
const showAuthorProfileSchema = pathname === '/about' || pathname === '/pl/about';
const phoneHref = `tel:${admin.contact.phone.replace(/\D/g, '')}`;
const whatsappHref = `https://wa.me/${admin.contact.whatsapp.replace(/\D/g, '')}`;
const footer = admin.footer;
const location = admin.location;
const copyright = footer.copyright[lang].replace('{year}', String(new Date().getFullYear()));
const homeHref = lang === 'pl' ? '/pl' : '/';
const homeLabel = lang === 'pl' ? 'KK Coaching - strona główna' : 'KK Coaching - home';
---
<BusinessEntity />
{showAuthorProfileSchema && <AuthorProfilePageSchema lang={lang} />}
{showPricing && <ServicePricing lang={lang} pathname={pathname} />}
{showTrainingLocation && <TrainingLocation lang={lang} />}

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href={homeHref} class="logo" aria-label={homeLabel}>
          <Logo height={30} />
          <span class="logo-anchor-text">{admin.brand.siteName}</span>
        </a>
        <p class="tagline">{admin.brand.tagline[lang]}</p>
        <p class="credentials">{admin.brand.credentials[lang]}</p>
        <p class="location">{admin.brand.locationSummary[lang]}</p>
      </div>
      <div>
        <h4>{footer.sectionLabels.quickLinks[lang]}</h4>
        <ul>
          {footer.quickLinks.filter(link => link.enabled).map(link => <li><a href={link.href[lang]}>{link.label[lang]}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>{footer.sectionLabels.contact[lang]}</h4>
        <ul>
          <li><a href={whatsappHref} target="_blank" rel="noopener">WhatsApp · {admin.contact.whatsapp}</a></li>
          <li><a href={phoneHref}>{footer.sectionLabels.phone[lang]} · {admin.contact.phone}</a></li>
          <li><a href={`mailto:${admin.contact.email}`}>{admin.contact.email}</a></li>
          <li><a href={admin.contact.instagramUrl} target="_blank" rel="noopener">Instagram · {admin.contact.instagramLabel}</a></li>
          {admin.contact.facebookUrl && <li><a href={admin.contact.facebookUrl} target="_blank" rel="noopener">Facebook</a></li>}
          <li class="local-nap">
            <strong>{admin.brand.siteName}</strong>
            <span>{footer.sectionLabels.trainingAt[lang]}: {location.venueName}</span>
            <span>{location.addressLine1} · {location.city} · {location.postcode}</span>
          </li>
        </ul>
      </div>
      <div>
        <h4>{footer.sectionLabels.legal[lang]}</h4>
        <ul>
          {footer.legalLinks.filter(link => link.enabled).map(link => <li><a href={link.href[lang]}>{link.label[lang]}</a></li>)}
          <li><button type="button" class="footer-link-button" data-cookie-settings>{footer.sectionLabels.cookieSettings[lang]}</button></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>{copyright}</span>
      <span>{footer.seoLine[lang]}</span>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--graphite); color: #9CA1A8; padding: 56px 0 28px; font-size: 0.9rem; }
  .logo { display: inline-flex; align-items: center; position: relative; }
  .logo-anchor-text { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .tagline { margin-top: 12px; max-width: 36ch; color: #C7CBD1; }
  .credentials { margin-top: 9px; max-width: 44ch; color: #D9DCE0; font-size: 0.8rem; font-weight: 700; line-height: 1.45; }
  .location { margin-top: 7px; max-width: 44ch; font-size: 0.82rem; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1.05fr 1.35fr 0.9fr; gap: 32px; margin-bottom: 40px; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; gap: 28px; } }
  footer h4 { color: var(--white); font-size: 0.9rem; margin-bottom: 14px; }
  footer ul { list-style: none; }
  footer ul li { margin-bottom: 8px; overflow-wrap: anywhere; }
  footer a, .footer-link-button { text-decoration: none; color: inherit; }
  footer a:hover, .footer-link-button:hover { color: var(--white); }
  .footer-link-button { appearance: none; border: 0; background: none; padding: 0; font: inherit; cursor: pointer; text-align: left; }
  .local-nap { display: grid; gap: 2px; margin-top: 15px; padding-top: 14px; border-top: 1px solid #2A2D33; font-size: 0.8rem; line-height: 1.45; }
  .local-nap strong { color: #C7CBD1; }
  .footer-bottom { border-top: 1px solid #2A2D33; padding-top: 20px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 0.8rem; }
</style>

---
import Logo from './Logo.astro';
import TrainingLocation from './TrainingLocation.astro';
import BusinessEntity from './BusinessEntity.astro';
import AuthorProfilePageSchema from './AuthorProfilePageSchema.astro';
import siteEn from '../data/site.en.json';
import sitePl from '../data/site.pl.json';

interface Props { lang: 'en' | 'pl' }
const { lang } = Astro.props;
const site = lang === 'pl' ? sitePl : siteEn;
const prefix = lang === 'pl' ? '/pl' : '';
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const locationPages = new Set([
  '/',
  '/pl',
  '/services',
  '/pl/services',
  '/hybrid-coaching',
  '/pl/hybrid-coaching'
]);
const showTrainingLocation = locationPages.has(pathname);
const showAuthorProfileSchema = pathname === '/about' || pathname === '/pl/about';
const phoneHref = `tel:${site.meta.whatsappNumber.replace(/\D/g, '')}`;

const labels = lang === 'pl'
  ? {
      nav: 'Na skróty', services: 'Opcje współpracy', personal: 'Trener personalny Cwmbran', online: 'Coaching online', hybrid: 'Coaching hybrydowy', transformations: 'Przemiany', resources: 'Poradniki', about: 'O mnie', contact: 'Kontakt',
      legal: 'Informacje prawne', privacy: 'Polityka prywatności', cookies: 'Polityka cookies', cookieSettings: 'Ustawienia cookies', terms: 'Regulamin strony',
      direct: 'Kontakt', location: 'Treningi 1:1 w Cwmbran · coaching online bez ograniczeń lokalizacji',
      footerSeo: 'Trener personalny Cwmbran · Coaching online · Coaching hybrydowy', home: 'KK Coaching - strona główna', phone: 'Telefon', trainingAt: 'Treningi 1:1'
    }
  : {
      nav: 'Quick links', services: 'Coaching options', personal: 'Personal Training Cwmbran', online: 'Online Coaching', hybrid: 'Hybrid Coaching', transformations: 'Transformations', resources: 'Fitness Guides', about: 'About Me', contact: 'Contact',
      legal: 'Legal', privacy: 'Privacy Policy', cookies: 'Cookie Policy', cookieSettings: 'Cookie settings', terms: 'Website Terms',
      direct: 'Contact', location: '1:1 training in Cwmbran · online coaching worldwide',
      footerSeo: 'Personal Training Cwmbran · Online Coaching · Hybrid Coaching', home: 'KK Coaching - home', phone: 'Phone', trainingAt: '1:1 training'
    };
---
<BusinessEntity />
{showAuthorProfileSchema && <AuthorProfilePageSchema lang={lang} />}
{showTrainingLocation && <TrainingLocation lang={lang} />}

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href={prefix || '/'} class="logo" aria-label={labels.home}>
          <Logo height={30} />
          <span class="logo-anchor-text">KK Coaching</span>
        </a>
        <p class="tagline">{site.meta.tagline}</p>
        <p class="location">{labels.location}</p>
      </div>
      <div>
        <h4>{labels.nav}</h4>
        <ul>
          <li><a href={`${prefix}/services`}>{labels.services}</a></li>
          <li><a href={`${prefix}/personal-training-cwmbran`}>{labels.personal}</a></li>
          <li><a href={`${prefix}/online-coaching`}>{labels.online}</a></li>
          <li><a href={`${prefix}/hybrid-coaching`}>{labels.hybrid}</a></li>
          <li><a href={`${prefix}/transformations`}>{labels.transformations}</a></li>
          <li><a href={`${prefix}/resources`}>{labels.resources}</a></li>
          <li><a href={`${prefix}/about`}>{labels.about}</a></li>
          <li><a href={`${prefix}/contact`}>{labels.contact}</a></li>
        </ul>
      </div>
      <div>
        <h4>{labels.direct}</h4>
        <ul>
          <li><a href={`https://wa.me/${site.meta.whatsappNumber.replace(/\D/g, '')}`} target="_blank" rel="noopener">WhatsApp · {site.meta.whatsappNumber}</a></li>
          <li><a href={phoneHref}>{labels.phone} · {site.meta.whatsappNumber}</a></li>
          <li><a href={`mailto:${site.meta.contactEmail}`}>{site.meta.contactEmail}</a></li>
          <li><a href={site.meta.instagramUrl} target="_blank" rel="noopener">Instagram · @kkcoaching.fit</a></li>
          {site.meta.facebookUrl && <li><a href={site.meta.facebookUrl} target="_blank" rel="noopener">Facebook</a></li>}
          <li class="local-nap"><strong>KK Coaching</strong><span>{labels.trainingAt}: JD Gyms Cwmbran</span><span>17–18 Gwent Square · Cwmbran · NP44 1PW</span></li>
        </ul>
      </div>
      <div>
        <h4>{labels.legal}</h4>
        <ul>
          <li><a href={`${prefix}/privacy`}>{labels.privacy}</a></li>
          <li><a href={`${prefix}/cookies`}>{labels.cookies}</a></li>
          <li><button type="button" class="footer-link-button" data-cookie-settings>{labels.cookieSettings}</button></li>
          <li><a href={`${prefix}/terms`}>{labels.terms}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} KK Coaching &mdash; Kacper Kaszowski</span>
      <span>{labels.footerSeo}</span>
    </div>
  </div>
</footer>

<style>
  footer { background: var(--graphite); color: #9CA1A8; padding: 56px 0 28px; font-size: 0.9rem; }
  .logo { display: inline-flex; align-items: center; position: relative; }
  .logo-anchor-text {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .tagline { margin-top: 12px; max-width: 36ch; color: #C7CBD1; }
  .location { margin-top: 8px; max-width: 42ch; font-size: 0.82rem; }
  .footer-grid { display: grid; grid-template-columns: 1.6fr 1.05fr 1.35fr 0.9fr; gap: 32px; margin-bottom: 40px; }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .footer-grid { grid-template-columns: 1fr; gap: 28px; } }
  footer h4 { color: var(--white); font-size: 0.9rem; margin-bottom: 14px; }
  footer ul { list-style: none; }
  footer ul li { margin-bottom: 8px; overflow-wrap: anywhere; }
  footer a,
  .footer-link-button { text-decoration: none; color: inherit; }
  footer a:hover,
  .footer-link-button:hover { color: var(--white); }
  .footer-link-button {
    appearance: none;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-align: left;
  }
  .local-nap {
    display: grid;
    gap: 2px;
    margin-top: 15px;
    padding-top: 14px;
    border-top: 1px solid #2A2D33;
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .local-nap strong { color: #C7CBD1; }
  .footer-bottom {
    border-top: 1px solid #2A2D33;
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.8rem;
  }
</style>

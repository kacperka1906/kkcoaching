---
interface Props {
  lang: 'en' | 'pl';
}

const { lang } = Astro.props;
const isPl = lang === 'pl';
const mapQuery = encodeURIComponent('JD Gyms Cwmbran, 17-18 Gwent Square, Cwmbran NP44 1PW');
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const directionsHref = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;
---
<section class="training-location on-white" aria-labelledby={`training-location-heading-${lang}`}>
  <div class="container location-grid">
    <div class="location-copy">
      <span class="eyebrow">{isPl ? 'Treningi 1:1 w Cwmbran' : '1:1 training in Cwmbran'}</span>
      <h2 id={`training-location-heading-${lang}`}>
        {isPl ? 'Tutaj odbywają się treningi personalne' : 'Where your 1:1 sessions take place'}
      </h2>
      <p>
        {isPl
          ? 'Treningi 1:1 prowadzę w JD Gyms Cwmbran — w centrum miasta, z łatwym dojazdem i pełnym zapleczem do treningu siłowego.'
          : 'I deliver 1:1 sessions at JD Gyms Cwmbran — a central location with easy access and a full commercial-gym setup for productive strength training.'}
      </p>
      <div class="location-details">
        <strong>JD Gyms Cwmbran</strong>
        <span>17–18 Gwent Square</span>
        <span>Cwmbran, NP44 1PW</span>
      </div>
      <div class="location-actions">
        <a class="btn btn-primary" href={directionsHref} target="_blank" rel="noopener">
          {isPl ? 'Wyznacz trasę' : 'Get directions'}
        </a>
        <a class="text-link" href={isPl ? '/pl/personal-training-cwmbran' : '/personal-training-cwmbran'}>
          {isPl ? 'Zobacz trening personalny 1:1 →' : 'Explore 1:1 Personal Training →'}
        </a>
      </div>
    </div>

    <div class="map-wrap">
      <iframe
        src={mapSrc}
        title={isPl ? 'Mapa lokalizacji JD Gyms Cwmbran' : 'Map showing JD Gyms Cwmbran'}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .training-location { padding: 72px 0; border-top: 1px solid #E3E5E8; }
  .location-grid { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: 42px; align-items: center; }
  .location-copy p { color: var(--steel); max-width: 52ch; margin-bottom: 22px; }
  .location-details { display: grid; gap: 2px; margin-bottom: 24px; }
  .location-details strong { font-size: 1.05rem; }
  .location-details span { color: var(--steel); font-size: 0.92rem; }
  .location-actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .text-link { color: var(--graphite); font-weight: 700; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .text-link:hover { color: var(--red); }
  .map-wrap { min-width: 0; border: 1px solid #D9DCE0; border-radius: var(--radius); overflow: hidden; background: #E9EBEE; box-shadow: 0 12px 28px rgba(20, 22, 26, 0.08); }
  .map-wrap iframe { display: block; width: 100%; height: 380px; border: 0; }

  @media (max-width: 820px) {
    .location-grid { grid-template-columns: 1fr; gap: 30px; }
    .map-wrap { order: 2; }
  }

  @media (max-width: 620px) {
    .training-location { padding: 54px 0; }
    .location-actions { display: grid; grid-template-columns: 1fr; gap: 14px; }
    .location-actions .btn { width: 100%; }
    .text-link { text-align: center; }
    .map-wrap iframe { height: 310px; }
  }
</style>

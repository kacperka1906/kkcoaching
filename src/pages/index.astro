---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import site from '../data/site.en.json';

const allServices = (await getCollection('services'))
  .filter(s => s.id.startsWith('en/'))
  .sort((a, b) => a.data.order - b.data.order);

const testimonials = await getCollection('testimonials');
const consentedTestimonials = testimonials.filter(t => t.data.consentOnFile);
const featured = consentedTestimonials.find(t => t.data.featured) ?? consentedTestimonials[0];

const siteUrl = String(Astro.site).replace(/\/$/, '');
const businessId = `${siteUrl}/#business`;
const personId = `${siteUrl}/#kacper-kaszowski`;
const websiteId = `${siteUrl}/#website`;
const sameAs = [site.meta.instagramUrl, site.meta.facebookUrl].filter(Boolean);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: `${siteUrl}/`,
      name: 'KK Coaching',
      alternateName: 'KK Coaching by Kacper Kaszowski',
      publisher: { '@id': businessId }
    },
    {
      '@type': 'Organization',
      '@id': businessId,
      name: 'KK Coaching',
      description: 'Personal training in Cwmbran and online fitness coaching with individual training, practical nutrition support and progress tracking.',
      image: `${siteUrl}/images/kacper-kaszowski-personal-trainer-cwmbran.jpg`,
      logo: `${siteUrl}/images/logo.png`,
      url: `${siteUrl}/`,
      email: site.meta.contactEmail,
      telephone: site.meta.whatsappNumber,
      sameAs,
      founder: { '@id': personId },
      areaServed: ['Cwmbran', 'Torfaen', 'South Wales', 'United Kingdom'],
      knowsLanguage: ['English', 'Polish']
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Kacper Kaszowski',
      jobTitle: 'Personal Trainer',
      url: `${siteUrl}/about`,
      image: `${siteUrl}/images/kacper-kaszowski-personal-trainer-cwmbran.jpg`,
      sameAs,
      worksFor: { '@id': businessId }
    }
  ]
};
---
<BaseLayout
  title="Personal Trainer Cwmbran & Online Coach | KK Coaching"
  description="Personal trainer in Cwmbran and online fitness coach across the UK. Individual training, nutrition support and progress tracking. Book a free consultation."
  lang="en"
  path="/"
  altPath="/pl"
  structuredData={structuredData}
>
  <Hero
    heading={site.hero.heading}
    lead={site.hero.lead}
    ctaPrimary={site.hero.ctaPrimary}
    ctaPrimaryHref="/contact"
    ctaSecondary={site.hero.ctaSecondary}
    ctaSecondaryHref="/transformations"
    trustLine={site.hero.trustLine}
    image={site.hero.image}
    imageAlt={site.hero.imageAlt}
  />

  <section aria-labelledby="who-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{site.whoItsFor.eyebrow}</span>
        <h2 id="who-heading">{site.whoItsFor.heading}</h2>
        <p>{site.whoItsFor.body}</p>
      </div>
      <div class="card-grid">
        {site.whoItsFor.cards.map(card => (
          <article class="card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="on-dark" aria-labelledby="services-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{site.servicesIntro.eyebrow}</span>
        <h2 id="services-heading">{site.servicesIntro.heading}</h2>
        <p>{site.servicesIntro.body}</p>
      </div>
      <div class="service-grid">
        {allServices.map(service => (
          <ServiceCard
            title={service.data.title}
            tagline={service.data.tagline}
            bullets={service.data.bullets}
            ctaLabel={service.data.ctaLabel}
            ctaTarget={service.data.ctaTarget}
            image={service.data.image}
            imageAlt={service.data.imageAlt}
            minor={service.data.minor}
          />
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="story-heading">
    <div class="container">
      <div class="story">
        <img src={site.story.image} alt={site.story.imageAlt} width="500" height="500" loading="lazy" />
        <div class="story-copy">
          <span class="eyebrow">{site.story.eyebrow}</span>
          <h2 id="story-heading">{site.story.heading}</h2>
          <p>{site.story.bodyShort}</p>
          <div class="stat-line" aria-label="Kacper's coaching story in numbers">
            <div class="stat-card"><strong>{site.story.statStart}</strong><span>Starting point</span></div>
            <div class="stat-card"><strong>{site.story.statLoss}</strong><span>Weight lost</span></div>
            <div class="stat-card"><strong>{site.story.statQualification}</strong><span>Coaching options</span></div>
          </div>
          <a href="/about" class="btn btn-outline-dark story-cta">{site.story.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="tight on-white" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">{site.process.eyebrow}</span>
        <h2 id="process-heading">{site.process.heading}</h2>
        <p>{site.process.body}</p>
      </div>
      <div class="process-steps">
        {site.process.steps.map((step, i) => (
          <div class="process-step">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="transformations" aria-labelledby="transform-heading">
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">{site.transformations.eyebrow}</span>
        <h2 id="transform-heading">{site.transformations.heading}</h2>
        <p>{site.transformations.body}</p>
      </div>
      {featured && (
        <div class="transform-card">
          <img src={featured.data.image} alt={featured.data.imageAlt} width="640" height="480" loading="lazy" />
          <div class="transform-body">
            <div class="meta">
              <span>{featured.data.name}</span>
              <span>{featured.data.serviceType}</span>
              <span>{featured.data.duration}</span>
            </div>
            <blockquote>{featured.data.startingPoint} &rarr; {featured.data.result}</blockquote>
          </div>
        </div>
      )}
      <div class="center-cta">
        <a href="/transformations" class="btn btn-outline-dark">{site.transformations.cta}</a>
      </div>
    </div>
  </section>

  <section class="final-cta" id="contact" aria-labelledby="final-cta-heading">
    <div class="container">
      <h2 id="final-cta-heading">{site.finalCta.heading}</h2>
      <p>{site.finalCta.body}</p>
      <a href="/contact" class="btn btn-secondary">{site.finalCta.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .card-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  @media (max-width: 900px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }
  .card { background: var(--white); border-radius: var(--radius); padding: 28px 24px; border: 1px solid #E3E5E8; }
  .card h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .card p { color: var(--steel); font-size: 0.95rem; }

  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 900px) { .service-grid { grid-template-columns: 1fr; } }

  .story { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 56px; align-items: center; }
  .story img { width: min(100%, 500px); aspect-ratio: 1 / 1; object-fit: cover; border-radius: var(--radius); }
  .story-copy { min-width: 0; }
  .story .stat-line { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 28px 0 30px; }
  .story .stat-card {
    min-width: 0;
    background: #F6F7F8;
    border: 1px solid #E3E5E8;
    border-top: 3px solid var(--red);
    border-radius: var(--radius);
    padding: 18px 14px 16px;
    text-align: center;
  }
  .story .stat-line strong {
    display: block;
    color: var(--red);
    font-size: clamp(1.2rem, 2.3vw, 1.8rem);
    line-height: 1.05;
    white-space: normal;
  }
  .story .stat-line span {
    display: block;
    margin-top: 8px;
    font-size: 0.72rem;
    line-height: 1.25;
    color: var(--steel);
    text-transform: uppercase;
    letter-spacing: 0.045em;
  }
  @media (max-width: 860px) {
    .story { grid-template-columns: 1fr; gap: 34px; }
    .story img { width: min(100%, 520px); margin: 0 auto; }
  }
  @media (max-width: 560px) {
    .story { gap: 26px; }
    .story .stat-line { gap: 8px; margin: 24px 0; }
    .story .stat-card { padding: 14px 6px 13px; border-radius: 10px; }
    .story .stat-line strong { font-size: clamp(0.98rem, 4.7vw, 1.25rem); }
    .story .stat-line span { margin-top: 7px; font-size: 0.61rem; letter-spacing: 0.025em; }
    .story-cta { width: 100%; text-align: center; justify-content: center; }
  }

  .process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  @media (max-width: 900px) { .process-steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .process-steps { grid-template-columns: 1fr; } }
  .process-step .num { color: var(--red); font-weight: 800; font-size: 0.85rem; letter-spacing: 0.05em; margin-bottom: 10px; display: block; }
  .process-step h3 { font-size: 1.05rem; margin-bottom: 8px; }
  .process-step p { color: var(--steel); font-size: 0.92rem; }

  .transform-card { background: var(--white); border-radius: var(--radius); overflow: hidden; border: 1px solid #E3E5E8; max-width: 640px; margin: 0 auto; }
  .transform-card img { width: 100%; }
  .transform-card .transform-body { padding: 28px; }
  .transform-card .meta { display: flex; gap: 18px; font-size: 0.82rem; color: var(--steel); margin-bottom: 12px; flex-wrap: wrap; }
  .transform-card blockquote { font-style: italic; border-left: 3px solid var(--red); padding-left: 16px; margin-top: 14px; }
  .center-cta { text-align: center; margin-top: 40px; }

  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 96px 0; }
  .final-cta h2 { color: var(--white); }
  .final-cta p { color: #F3D7DA; max-width: 52ch; margin: 0 auto 32px; font-size: 1.05rem; }
  .final-cta .btn-secondary { border-color: var(--white); }
</style>

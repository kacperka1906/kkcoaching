---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactMethods from '../components/ContactMethods.astro';
import site from '../data/site.en.json';
---
<BaseLayout
  title="Free Personal Training Consultation Cwmbran | KK Coaching"
  description="Book a free consultation with KK Coaching for personal training in Cwmbran, online coaching or hybrid coaching. Tell me your goal and what has been holding you back."
  lang="en"
  path="/contact"
  altPath="/pl/contact"
>
  <section class="page-hero on-dark">
    <div class="container">
      <span class="eyebrow">Start here</span>
      <h1>Book Your Free Consultation</h1>
      <p class="lead">Tell me where you are now, what you want to achieve and what has been getting in the way. There is no pressure to commit - we will simply work out whether I can help and which option fits best.</p>
    </div>
  </section>

  <section class="on-white">
    <div class="container contact-grid">
      <form id="contact-form" data-track-as="contact_enquiry" novalidate>
        <div class="field">
          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="phone">Phone / WhatsApp <span aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel" />
        </div>
        <div class="field">
          <label for="location">Location</label>
          <input type="text" id="location" name="location" placeholder="e.g. Cwmbran, Cardiff, or online" />
        </div>
        <div class="field">
          <label for="language">Preferred language</label>
          <select id="language" name="language">
            <option value="English">English</option>
            <option value="Polish">Polish</option>
          </select>
        </div>
        <div class="field">
          <label for="interest">Interested in</label>
          <select id="interest" name="interest">
            <option>Personal Training</option>
            <option>Online Coaching</option>
            <option>Hybrid Coaching</option>
            <option>Training Plan</option>
            <option>Not sure yet</option>
          </select>
        </div>
        <div class="field">
          <label for="goal">What would you like to achieve? <span aria-hidden="true">*</span></label>
          <textarea id="goal" name="goal" rows="3" required placeholder="Fat loss, muscle gain, getting stronger, feeling more confident in the gym..."></textarea>
        </div>
        <div class="field">
          <label for="blocker">What is currently holding you back?</label>
          <textarea id="blocker" name="blocker" rows="3" placeholder="Time, consistency, nutrition, not knowing what to do, previous injuries..."></textarea>
        </div>

        <div class="field honeypot" aria-hidden="true">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field checkbox-field">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">
            I agree to be contacted and I have read the <a href="/privacy">Privacy Policy</a>. <span aria-hidden="true">*</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Send My Enquiry</button>
        <p class="form-note">No pressure, no sales script. I usually reply within 24 hours.</p>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <ContactMethods
        lang="en"
        whatsappNumber={site.meta.whatsappNumber}
        contactEmail={site.meta.contactEmail}
        instagramUrl={site.meta.instagramUrl}
      />
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const formData = new FormData(form);

    if (formData.get('company')) {
      window.location.href = '/thank-you';
      return;
    }

    status.textContent = 'Sending...';

    try {
      const res = await fetch('/.netlify/functions/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData))
      });

      if (!res.ok) throw new Error('Request failed');

      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          form_name: 'contact_enquiry',
          lead_language: 'en',
          interest: String(formData.get('interest') ?? '')
        });
      }

      window.location.href = '/thank-you';
    } catch (err) {
      status.textContent = "Something went wrong sending your message. Please try WhatsApp or email instead.";
    }
  });
</script>

<style>
  .page-hero { padding: 64px 0; }
  .page-hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 14px; }
  .page-hero .lead { color: #C7CBD1; max-width: 64ch; }

  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; gap: 34px; } }

  .field { margin-bottom: 18px; }
  .field label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.92rem; }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid #D8DBDE;
    border-radius: var(--radius);
    padding: 12px 14px;
    font-size: 1rem;
    font-family: inherit;
    background: var(--white);
  }
  .field textarea { resize: vertical; }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .checkbox-field { display: flex; align-items: flex-start; gap: 10px; }
  .checkbox-field input { width: auto; margin-top: 4px; }
  .checkbox-field label { font-weight: 400; font-size: 0.88rem; color: var(--steel); }
  .checkbox-field a { color: var(--red); }

  .form-note { margin-top: 12px; font-size: 0.85rem; color: var(--steel); }
  .form-status { margin-top: 8px; font-size: 0.9rem; color: var(--steel); }

  @media (max-width: 620px) {
    .page-hero { padding: 48px 0; }
    form > .btn { width: 100%; }
  }
</style>

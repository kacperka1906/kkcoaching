---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResourceHub from '../../components/ResourceHub.astro';
import resources from '../../data/resources-v1.json';

const lang = 'en';
const hub = resources.hub;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://kkcoaching.fit/resources#collection',
      url: 'https://kkcoaching.fit/resources',
      name: hub.seo.title.en,
      description: hub.seo.description.en,
      isPartOf: { '@id': 'https://kkcoaching.fit/#website' }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kkcoaching.fit/' },
        { '@type': 'ListItem', position: 2, name: 'Fitness Guides' }
      ]
    }
  ]
};
---
<BaseLayout
  title={hub.seo.title[lang]}
  description={hub.seo.description[lang]}
  lang="en"
  path="/resources"
  altPath="/pl/resources"
  structuredData={structuredData}
>
  <ResourceHub lang="en" />
</BaseLayout>

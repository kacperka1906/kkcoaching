---
import BaseLayout from '../layouts/BaseLayout.astro';
import copy from '../data/hybrid-v2.json';
import admin from '../data/admin-v2.json';

const lang = 'en';
const faqs = copy.faq.items.map(item => ({ q: item.q[lang], a: item.a[lang] }));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://kkcoaching.fit/hybrid-coaching#service',
      name: copy.hero.heading[lang],
      serviceType: 'Hybrid Personal Training and Online Fitness Coaching',
      description: copy.seo.description[lang],
      url: 'https://kkcoaching.fit/hybrid-coaching',
      areaServed: { '@type': 'AdministrativeArea', name: 'Cwmbran, Torfaen, South Wales' },
      provider: { '@type': 'Organization', '@id': 'https://kkcoaching.fit/#business', name: admin.brand.siteName, url: 'https://kkcoaching.fit/' }
    },
    { '@type': 'FAQPage', mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
  ]
};
---
<BaseLayout title={copy.seo.title[lang]} description={copy.seo.description[lang]} lang="en" path="/hybrid-coaching" altPath="/pl/hybrid-coaching" structuredData={structuredData}>
  <section class="hybrid-hero on-dark">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{copy.hero.eyebrow[lang]}</span><h1>{copy.hero.heading[lang]}</h1><p class="lead">{copy.hero.lead[lang]}</p>
        <div class="hero-actions"><a href={copy.hero.primaryHref[lang]} class="btn btn-primary">{copy.hero.primaryCta[lang]}</a><a href={copy.hero.secondaryHref[lang]} class="btn btn-secondary">{copy.hero.secondaryCta[lang]}</a></div>
        <div class="trust-row" aria-label={copy.hero.trustAria[lang]}>{copy.hero.trustPoints.map(item => <span>{item[lang]}</span>)}</div>
      </div>
      <div class="hero-media"><img src={copy.hero.fallbackImage} alt={copy.hero.imageAlt[lang]} width="720" height="540" /></div>
    </div>
  </section>

  <section class="on-white"><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.why.eyebrow[lang]}</span><h2>{copy.why.heading[lang]}</h2><p>{copy.why.body[lang]}</p></div><div class="compare-grid"><article class="scope-card"><span class="scope-label">{copy.onlineCore.label[lang]}</span><h3>{copy.onlineCore.heading[lang]}</h3><ul>{copy.onlineCore.items.map(item => <li>{item[lang]}</li>)}</ul></article><article class="scope-card featured"><span class="scope-label">{copy.inPerson.label[lang]}</span><h3>{copy.inPerson.heading[lang]}</h3><ul>{copy.inPerson.items.map(item => <li>{item[lang]}</li>)}</ul></article></div></div></section>

  <section class="app-band on-dark"><div class="container app-grid"><div><span class="eyebrow">{copy.app.eyebrow[lang]}</span><h2>{copy.app.heading[lang]}</h2><p>{copy.app.body[lang]}</p></div><div class="app-points" aria-label={copy.app.aria[lang]}>{copy.app.points.map(item => <span>{item[lang]}</span>)}</div></div></section>

  <section class="on-white"><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.choice.eyebrow[lang]}</span><h2>{copy.choice.heading[lang]}</h2><p>{copy.choice.body[lang]}</p></div><div class="related-grid">{copy.choice.cards.map(item => <a href={item.href[lang]} class="related-card"><strong>{item.title[lang]}</strong><span>{item.body[lang]}</span></a>)}</div></div></section>

  <section class="on-white faq-section" aria-labelledby="faq-heading"><div class="container faq-wrap"><div class="section-head centered"><span class="eyebrow">{copy.faq.eyebrow[lang]}</span><h2 id="faq-heading">{copy.faq.heading[lang]}</h2></div><div class="faq-list">{faqs.map(item => <details class="faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></div></section>

  <section class="final-cta"><div class="container"><span class="eyebrow light">{copy.finalCta.eyebrow[lang]}</span><h2>{copy.finalCta.heading[lang]}</h2><p>{copy.finalCta.body[lang]}</p><a href={copy.finalCta.href[lang]} class="btn btn-secondary">{copy.finalCta.cta[lang]}</a></div></section>
</BaseLayout>

<style>
  .hybrid-hero { padding: 72px 0; }
  .hero-grid, .app-grid { display: grid; grid-template-columns: 1.08fr 0.92fr; gap: 56px; align-items: center; }
  .hybrid-hero h1 { color: var(--white); font-size: clamp(2.15rem, 4.8vw, 3.9rem); max-width: 16ch; margin-bottom: 18px; }
  .lead { color: #D3D6DA; font-size: 1.1rem; max-width: 60ch; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 30px 0 24px; }
  .trust-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .trust-row span { border: 1px solid #3B4048; border-radius: 999px; padding: 7px 11px; color: #D9DCE0; font-size: 0.78rem; }
  .hero-media img { width: 100%; border-radius: var(--radius); border: 1px solid #363A40; }
  .compare-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 1040px; margin: 0 auto; }
  .scope-card { background: #F6F7F8; border: 1px solid #E0E3E6; border-radius: var(--radius); padding: 30px; }
  .scope-card.featured { border: 2px solid var(--red); background: var(--white); }
  .scope-label { display: inline-block; color: var(--red); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 10px; }
  .scope-card h3 { margin-bottom: 18px; }
  .scope-card ul { list-style: none; display: grid; gap: 10px; color: var(--steel); }
  .scope-card li { position: relative; padding-left: 24px; }
  .scope-card li::before { content: '✓'; position: absolute; left: 0; color: var(--red); font-weight: 800; }
  .app-band h2 { color: var(--white); }
  .app-band p { color: #C0C4CA; max-width: 60ch; }
  .app-points { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .app-points span { background: #202329; border: 1px solid #353A42; color: var(--white); padding: 18px; border-radius: var(--radius); font-weight: 700; text-align: center; }
  .related-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; max-width: 900px; margin: 0 auto; }
  .related-card { display: block; text-decoration: none; background: #F6F7F8; border: 1px solid #E0E3E6; border-radius: var(--radius); padding: 24px; transition: border-color .2s ease, transform .2s ease; }
  .related-card:hover { border-color: var(--red); transform: translateY(-2px); }
  .related-card strong { display: block; margin-bottom: 6px; }
  .related-card span { color: var(--steel); font-size: 0.92rem; }
  .faq-section { padding-top: 36px; }
  .faq-wrap { max-width: 860px; }
  .faq-list { border-top: 1px solid #D8DBDE; }
  .faq-item { border-bottom: 1px solid #D8DBDE; padding: 18px 0; }
  .faq-item summary { font-weight: 700; cursor: pointer; list-style: none; padding-right: 34px; position: relative; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; position: absolute; right: 4px; color: var(--red); font-size: 1.25rem; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { color: var(--steel); margin-top: 10px; padding-right: 34px; }
  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 88px 0; }
  .final-cta .eyebrow.light { color: #FFDDE1; }
  .final-cta h2 { color: var(--white); max-width: 760px; margin: 0 auto 14px; }
  .final-cta p { color: #F5DADD; max-width: 62ch; margin: 0 auto 28px; }
  @media (max-width: 900px) { .hero-grid, .app-grid, .compare-grid { grid-template-columns: 1fr; gap: 34px; } .hybrid-hero h1 { max-width: none; } }
  @media (max-width: 620px) { .hybrid-hero { padding: 48px 0 56px; } .hybrid-hero h1 { font-size: clamp(2rem, 9.5vw, 2.72rem); } .lead { font-size: 1rem; } .hero-actions { display: grid; grid-template-columns: 1fr; } .hero-actions .btn { width: 100%; } .trust-row { display: grid; grid-template-columns: 1fr 1fr; } .trust-row span { text-align: center; } .scope-card { padding: 24px 20px; } .app-points, .related-grid { grid-template-columns: 1fr; } }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const whatsappUrl = 'https://wa.me/447516327552?text=Hi%20Kacper%2C%20I%20scanned%20your%20JD%20Gyms%20QR%20code%20and%20I%27d%20like%20to%20know%20more%20about%20coaching.';

const options = [
  {
    badge: 'TRAIN WITH ME AT JD GYMS',
    title: '1:1 Personal Training',
    text: 'Hands-on coaching at JD Gyms Cwmbran. Build confidence with your technique, follow a structured programme and know what to work on next.',
    href: '/personal-training-cwmbran/',
    cta: 'Explore Personal Training',
    featured: true
  },
  {
    badge: 'IN THE GYM + BETWEEN SESSIONS',
    title: 'Hybrid Coaching',
    text: 'Combine face-to-face sessions with personalised training and nutrition plans, progress check-ins and support between our sessions.',
    href: '/hybrid-coaching/',
    cta: 'Explore Hybrid Coaching',
    featured: false
  },
  {
    badge: 'FLEXIBLE SUPPORT',
    title: 'Online Coaching',
    text: 'Train on your own schedule with an individual programme, practical nutrition guidance and ongoing reviews wherever you are.',
    href: '/online-coaching/',
    cta: 'Explore Online Coaching',
    trialUrl: 'https://kkcoaching.mypthub.net/p/240389',
    featured: false
  }
];
---
<BaseLayout
  title="Coaching at JD Gyms Cwmbran | KK Coaching"
  description="Scanned the KK Coaching banner at JD Gyms Cwmbran? Meet Kacper, book a free consultation and compare 1:1 PT, Hybrid and Online Coaching."
  lang="en"
  path="/jd/"
  noindex={true}
>
  <section class="jd-hero on-dark" aria-labelledby="jd-heading">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">JD GYMS · CWMBRAN</span>
        <h1 id="jd-heading">Get more from every gym session.</h1>
        <p class="lead">I'm Kacper, the coach behind KK Coaching. If you scanned my banner at JD Gyms, you're in the right place. Whether you want to build muscle, get stronger or feel more confident using the gym, I'll help you train with a clear plan.</p>
        <div class="hero-actions">
          <a href="/contact/" class="btn btn-primary">Book a Free Consultation</a>
          <a href={whatsappUrl} class="jd-whatsapp" target="_blank" rel="noopener noreferrer">Ask Me on WhatsApp</a>
        </div>
        <p class="hero-note">A quick conversation about your goals and the support that suits you. No pressure to sign up.</p>
        <ul class="trust-row" aria-label="Coach credentials and languages">
          <li>Level 3 Personal Trainer</li>
          <li>Level 4 Sports Nutrition</li>
          <li>English / Polish</li>
        </ul>
      </div>
      <div class="hero-image-wrap">
        <img
          class="hero-image"
          src="/images/about-kacper-2026.webp"
          width="720"
          height="900"
          alt="Kacper Kaszowski, personal trainer and founder of KK Coaching"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <span class="image-caption">KK COACHING · PERSONAL TRAINING IN CWMBRAN</span>
      </div>
    </div>
  </section>

  <section class="jd-taster on-white" aria-labelledby="taster-heading">
    <div class="container">
      <div class="taster-panel">
        <div class="taster-copy">
          <span class="eyebrow">WANT TO TRY TRAINING TOGETHER?</span>
          <h2 id="taster-heading">Your first 60-minute PT taster is free.</h2>
          <p>See how I coach, practise your technique and talk through your next steps before deciding if you'd like to continue.</p>
          <p class="taster-terms">For eligible new clients, one per person and subject to availability. No obligation to continue. An active JD Gyms membership is required and paid separately.</p>
        </div>
        <a href="/contact/?interest=taster" class="btn btn-primary">Ask About a Free Taster</a>
      </div>
    </div>
  </section>

  <section class="choice-section on-white" aria-labelledby="choice-heading">
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">YOUR COACHING OPTIONS</span>
        <h2 id="choice-heading">Choose how much support you need.</h2>
        <p>Some people want help during their gym sessions. Others want a complete plan and accountability between sessions too. There's an option for both.</p>
      </div>

      <div class="option-grid">
        {options.map(option => (
          <article class:list={['option-card', { featured: option.featured }]}>
            <span class="option-badge">{option.badge}</span>
            <h3>{option.title}</h3>
            <p>{option.text}</p>
            <a href={option.href} class:list={['btn', option.featured ? 'btn-primary' : 'btn-outline-dark']}>{option.cta}</a>
            {option.trialUrl && (
              <div class="trial-choice">
                <span class="trial-choice-label">TRY BEFORE YOU COMMIT</span>
                <a href={option.trialUrl} class="trial-link" target="_blank" rel="noopener noreferrer">Get 7 Days Free Access <span aria-hidden="true">↗</span></a>
                <p class="trial-note">Free MyPTHub demo with sample workouts and meals. Not a personalised coaching trial. No automatic renewal.</p>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="steps-section" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">KEEP IT SIMPLE</span>
        <h2 id="steps-heading">Here's how we get started.</h2>
      </div>
      <div class="steps-grid">
        <div class="step"><span aria-hidden="true">01</span><h3>Tell me your goal</h3><p>We talk about what you want to achieve, your experience and the time you have.</p></div>
        <div class="step"><span aria-hidden="true">02</span><h3>Choose your first step</h3><p>Book a consultation or ask about a free PT taster at JD Gyms.</p></div>
        <div class="step"><span aria-hidden="true">03</span><h3>Build your plan</h3><p>If you'd like to continue, we'll choose the coaching option that works for you.</p></div>
      </div>
    </div>
  </section>

  <section class="consult-section on-white" aria-labelledby="consult-heading">
    <div class="container consult-inner">
      <span class="eyebrow">QUESTIONS BEFORE YOU START?</span>
      <h2 id="consult-heading">Let's have a quick chat.</h2>
      <p>You don't have to know exactly which package you need. Tell me what you're working towards and I'll explain your options without any pressure.</p>
      <div class="actions">
        <a href="/contact/" class="btn btn-primary">Book a Free Consultation</a>
        <a href={whatsappUrl} class="btn btn-outline-dark" target="_blank" rel="noopener noreferrer">Message Me on WhatsApp</a>
      </div>
      <p class="microcopy">1:1 sessions at JD Gyms Cwmbran · Coaching in English and Polish · JD membership paid separately.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .jd-hero { padding: clamp(36px, 5vw, 76px) 0; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(290px, .85fr); gap: clamp(28px, 5vw, 70px); align-items: center; }
  .hero-copy { min-width: 0; }
  .jd-hero h1 { color: var(--white); font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.05; max-width: 12ch; margin: 12px 0 20px; }
  .lead { color: #D5D8DC; font-size: clamp(1rem, 1.7vw, 1.14rem); line-height: 1.65; max-width: 58ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin: 26px 0 12px; }
  .hero-actions .btn, .jd-whatsapp { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; padding: 12px 20px; text-align: center; }
  .jd-whatsapp { color: #fff; border: 1px solid #9298A1; border-radius: var(--radius); text-decoration: none; font-weight: 700; }
  .jd-whatsapp:hover, .jd-whatsapp:focus-visible { background: #32353C; border-color: #fff; color: #fff; }
  .hero-note { color: #B8BEC7; font-size: .83rem; max-width: 58ch; }
  .trust-row { list-style: none; margin: 24px 0 0; padding: 0; display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .trust-row li { color: #F2F3F4; border: 1px solid #444B54; border-radius: 999px; padding: 8px 12px; font-size: .8rem; }
  .trust-row span { color: #C7CBD1; }
  .hero-image-wrap { position: relative; max-width: 520px; width: 100%; margin-inline: auto; }
  .hero-image { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); background: #2C3036; border: 1px solid #454A52; }
  .image-caption { position: absolute; left: 14px; right: 14px; bottom: 14px; display: block; padding: 12px 14px; font-size: .72rem; letter-spacing: .06em; line-height: 1.4; font-weight: 800; background: rgba(23,25,29,.9); border-left: 3px solid var(--red); color: #fff; }
  .jd-taster { padding: 36px 0 6px; }
  .taster-panel { display: flex; align-items: center; gap: 26px; justify-content: space-between; padding: clamp(22px, 4vw, 38px); border: 1px solid #E2E4E7; border-left: 5px solid var(--red); border-radius: var(--radius); background: #F6F7F8; }
  .taster-copy { max-width: 65ch; }
  .taster-panel h2 { margin: 6px 0 8px; font-size: clamp(1.5rem, 3vw, 2.1rem); }
  .taster-panel p { color: var(--steel); margin: 0; }
  .taster-panel .taster-terms { margin-top: 10px; font-size: .82rem; line-height: 1.5; }
  .taster-panel .btn { min-height: 50px; text-align: center; flex-shrink: 0; }
  .choice-section { padding: 72px 0 82px; }
  .choice-section .section-head p { max-width: 63ch; margin-inline: auto; }
  .option-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 32px; }
  .option-card { background: var(--white); border: 1px solid #DDE0E3; border-radius: var(--radius); padding: 28px 24px 24px; display: flex; flex-direction: column; min-height: 100%; }
  .option-card.featured { border-top: 4px solid var(--red); box-shadow: 0 14px 36px rgba(23,25,29,.09); }
  .option-badge { color: var(--red); font-size: .7rem; line-height: 1.35; font-weight: 800; letter-spacing: .055em; margin-bottom: 12px; }
  .option-card h3 { font-size: 1.3rem; margin-bottom: 12px; }
  .option-card p { color: var(--steel); margin-bottom: 24px; flex: 1; }
  .option-card .btn { width: 100%; text-align: center; }
  .trial-choice { margin-top: 18px; padding-top: 16px; border-top: 1px solid #E3E5E8; }
  .trial-choice-label { display: block; color: var(--red); font-size: .71rem; letter-spacing: .045em; font-weight: 800; margin-bottom: 5px; }
  .trial-link { color: var(--graphite); font-size: .98rem; font-weight: 800; text-underline-offset: 4px; }
  .trial-link:hover { color: var(--red); }
  .trial-note { margin: 7px 0 0 !important; font-size: .78rem; line-height: 1.45; }
  .steps-section { background: #F6F7F8; padding: 70px 0; }
  .steps-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 32px; }
  .step { padding: 23px; border: 1px solid #E0E3E6; border-radius: var(--radius); background: #fff; }
  .step > span { color: var(--red); font-size: .8rem; letter-spacing: .06em; font-weight: 800; }
  .step h3 { font-size: 1.15rem; margin: 10px 0; }
  .step p { font-size: .93rem; line-height: 1.6; color: var(--steel); }
  .consult-section { padding: 80px 0 88px; }
  .consult-inner { max-width: 740px; text-align: center; }
  .consult-inner h2 { margin: 8px 0 14px; }
  .consult-inner > p { color: var(--steel); }
  .actions { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 28px 0 20px; }
  .actions .btn { min-height: 50px; }
  .microcopy { font-size: .83rem; line-height: 1.5; }
  @media (max-width: 950px) {
    .hero-grid { grid-template-columns: 1fr; gap: 30px; }
    .hero-image-wrap { max-width: 490px; }
    .hero-copy { max-width: 720px; margin-inline: auto; }
    .option-grid { grid-template-columns: 1fr; max-width: 680px; margin-left: auto; margin-right: auto; }
    .steps-grid { grid-template-columns: 1fr; max-width: 680px; margin-inline: auto; }
    .taster-panel { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 620px) {
    .jd-hero { padding: 34px 0 44px; }
    .jd-hero h1 { font-size: clamp(2.4rem, 10vw, 3.5rem); }
    .hero-actions { flex-direction: column; }
    .hero-actions .btn, .hero-actions .jd-whatsapp { width: 100%; }
    .hero-image-wrap { max-width: 390px; }
    .jd-taster { padding: 20px 0 0; }
    .taster-panel .btn { width: 100%; }
    .choice-section { padding: 54px 0 58px; }
    .option-card { padding: 24px 20px 22px; }
    .steps-section { padding: 54px 0; }
    .consult-section { padding: 60px 0; }
    .actions { display: grid; grid-template-columns: 1fr; }
    .actions .btn { width: 100%; }
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.en.json';
---
<BaseLayout
  title="Thank You | KK Coaching"
  description="Thanks for reaching out to KK Coaching. Your enquiry has been received."
  lang="en"
  path="/thank-you"
  altPath="/pl/thank-you"
>
  <section class="thank-you">
    <div class="container">
      <span class="eyebrow">Enquiry received</span>
      <h1>Thanks &mdash; your message is in.</h1>
      <p class="lead">I usually reply within 24 hours. In the meantime, feel free to message on WhatsApp if it's urgent.</p>
      <div class="actions">
        <a href={`https://wa.me/${site.meta.whatsappNumber.replace(/\D/g, '')}`} class="btn btn-primary" target="_blank" rel="noopener">Message on WhatsApp</a>
        <a href="/" class="btn btn-outline-dark">Back to Home</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you { padding: 120px 0; text-align: center; }
  .thank-you h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 16px; }
  .thank-you .lead { color: var(--steel); max-width: 52ch; margin: 0 auto 32px; }
  .actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
</style>

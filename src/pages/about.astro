---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.en.json';
import pages from '../data/pages-v2.json';
import admin from '../data/admin-v2.json';

const lang = 'en';
const copy = pages.about;
const siteUrl = String(Astro.site).replace(/\/$/, '');
const sameAs = [admin.contact.instagramUrl, admin.contact.facebookUrl].filter(Boolean);
const aboutImage = copy.image;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#kacper-kaszowski`,
  name: admin.brand.ownerName,
  jobTitle: 'Personal Trainer',
  url: `${siteUrl}/about`,
  image: `${siteUrl}${aboutImage}`,
  sameAs,
  worksFor: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#business`,
    name: admin.brand.siteName,
    url: `${siteUrl}/`
  }
};
---
<BaseLayout
  title={copy.seo.title[lang]}
  description={copy.seo.description[lang]}
  lang="en"
  path="/about"
  altPath="/pl/about"
  structuredData={structuredData}
  socialImage={aboutImage}
  socialImageAlt={copy.seo.socialAlt[lang]}
>
  <section class="about-hero on-dark">
    <div class="container about-hero__grid">
      <img
        class="about-photo"
        src={aboutImage}
        alt={copy.imageAlt[lang]}
        width="600"
        height="600"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        onerror="this.onerror=null;this.src='/images/kacper.jpg';"
      />
      <div class="about-copy">
        <span class="eyebrow">{copy.heroEyebrow[lang]}</span>
        <h1>{site.story.heading}</h1>
        <p class="lead">{site.story.bodyFull}</p>
      </div>
    </div>
  </section>

  <section class="on-white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.lessons.eyebrow[lang]}</span>
        <h2>{copy.lessons.heading[lang]}</h2>
      </div>
      <div class="lesson-grid">
        {copy.lessons.cards.map(card => (
          <article class="card">
            <h3>{card.title[lang]}</h3>
            <p>{card.body[lang]}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="qualifications" aria-labelledby="quals-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">{copy.qualifications.eyebrow[lang]}</span>
        <h2 id="quals-heading">{copy.qualifications.heading[lang]}</h2>
      </div>
      <ul class="quals-list">
        {copy.qualifications.items.map(item => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.description[lang]}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <h2>{site.finalCta.heading}</h2>
      <p>{site.finalCta.body}</p>
      <a href="/contact" class="btn btn-secondary">{site.finalCta.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .about-photo {
    width: min(100%, 480px);
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: #25282e;
    box-shadow: 0 14px 34px rgba(0,0,0,.22);
  }
  .about-hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 20px; }
  .about-hero .lead { color: #C7CBD1; max-width: 62ch; }

  .lesson-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .card { background: var(--white); border-radius: var(--radius); padding: 28px 24px; border: 1px solid #E3E5E8; }
  .card h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .card p { color: var(--steel); font-size: 0.95rem; }

  .qualifications { background: #F6F7F8; }
  .qualifications .section-head { margin-bottom: 24px; }
  .quals-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    max-width: 860px;
  }
  .quals-list li {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    background: var(--white);
    border: 1px solid #E3E5E8;
    border-left: 4px solid var(--red);
    border-radius: var(--radius);
  }
  .quals-list strong { font-weight: 800; }
  .quals-list span { color: var(--steel); font-size: 0.86rem; line-height: 1.45; }

  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 96px 0; }
  .final-cta h2 { color: var(--white); }
  .final-cta p { color: #F3D7DA; max-width: 52ch; margin: 0 auto 32px; font-size: 1.05rem; }

  @media (max-width: 820px) {
    .about-hero__grid { grid-template-columns: 1fr; gap: 28px; padding-top: 42px; padding-bottom: 48px; }
    .about-copy { order: 1; }
    .about-photo { order: 2; width: 100%; max-width: 520px; margin: 0 auto; }
    .lesson-grid { grid-template-columns: 1fr; }
    .quals-list { grid-template-columns: 1fr; }
  }
</style>

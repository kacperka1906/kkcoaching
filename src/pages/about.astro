---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.en.json';

const siteUrl = String(Astro.site).replace(/\/$/, '');
const sameAs = [site.meta.instagramUrl, site.meta.facebookUrl].filter(Boolean);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${siteUrl}/#kacper-kaszowski`,
  name: 'Kacper Kaszowski',
  jobTitle: 'Personal Trainer',
  url: `${siteUrl}/about`,
  image: `${siteUrl}/images/about-kacper.webp`,
  sameAs,
  worksFor: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#business`,
    name: 'KK Coaching',
    url: `${siteUrl}/`
  }
};
---
<BaseLayout
  title="Kacper Kaszowski | Personal Trainer in Cwmbran | KK Coaching"
  description="Meet Kacper Kaszowski, personal trainer in Cwmbran and founder of KK Coaching. From a 117 to 76 kg transformation to structured 1:1 and online coaching."
  lang="en"
  path="/about"
  altPath="/pl/about"
  structuredData={structuredData}
>
  <section class="about-hero on-dark">
    <div class="container about-hero__grid">
      <img src="/images/about-kacper.webp" alt={site.story.imageAlt} width="480" height="480" />
      <div>
        <span class="eyebrow">Meet your coach</span>
        <h1>{site.story.heading}</h1>
        <p class="lead">{site.story.bodyFull}</p>
      </div>
    </div>
  </section>

  <section class="on-white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Lessons from the process</span>
        <h2>What losing 40+ kg actually taught me</h2>
      </div>
      <div class="lesson-grid">
        <article class="card">
          <h3>Consistency beats intensity</h3>
          <p>The hardest part is not completing one perfect workout or following one perfect week of dieting. It is building a routine you can repeat for months. That is why my coaching prioritises consistent execution before unnecessary extremes.</p>
        </article>
        <article class="card">
          <h3>A plan has to fit real life</h3>
          <p>The best programme on paper is useless if your schedule, experience or lifestyle make it impossible to follow. Training and nutrition have to work around your life, not the other way around.</p>
        </article>
        <article class="card">
          <h3>Progress needs to be measured</h3>
          <p>Body weight is only one piece of information. Training performance, measurements, photos and adherence help show whether the plan is working and when something genuinely needs to change.</p>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="quals-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Qualifications</span>
        <h2 id="quals-heading">Qualified coaching with practical experience</h2>
        <p>My own transformation gives me perspective. My qualifications give me the professional foundation to coach safely and effectively within my scope.</p>
      </div>
      <ul class="quals-list">
        <li>Level 2 Gym Instructor &mdash; completed</li>
        <li>Level 3 Personal Trainer &mdash; completed</li>
      </ul>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <h2>{site.finalCta.heading}</h2>
      <p>{site.finalCta.body}</p>
      <a href="/contact" class="btn btn-secondary">{site.finalCta.cta}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
    padding-top: 64px;
    padding-bottom: 64px;
  }
  .about-hero__grid img { width: min(100%, 480px); aspect-ratio: 1 / 1; object-fit: cover; border-radius: var(--radius); }
  .about-hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 20px; }
  .about-hero .lead { color: #C7CBD1; max-width: 62ch; }
  @media (max-width: 820px) { .about-hero__grid { grid-template-columns: 1fr; } }

  .lesson-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 820px) { .lesson-grid { grid-template-columns: 1fr; } }
  .card { background: var(--white); border-radius: var(--radius); padding: 28px 24px; border: 1px solid #E3E5E8; }
  .card h3 { font-size: 1.1rem; margin-bottom: 10px; }
  .card p { color: var(--steel); font-size: 0.95rem; }

  .quals-list { list-style: none; max-width: 480px; }
  .quals-list li {
    padding: 14px 0;
    border-bottom: 1px solid #E3E5E8;
    font-weight: 600;
  }

  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 96px 0; }
  .final-cta h2 { color: var(--white); }
  .final-cta p { color: #F3D7DA; max-width: 52ch; margin: 0 auto 32px; font-size: 1.05rem; }
</style>
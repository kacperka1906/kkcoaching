---
import BaseLayout from '../../layouts/BaseLayout.astro';
import copy from '../../data/online-v2.json';
import admin from '../../data/admin-v2.json';

const lang = 'pl';
const faqs = copy.faq.items.map(item => ({ q: item.q[lang], a: item.a[lang] }));
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://kkcoaching.fit/pl/online-coaching#service',
      name: copy.hero.heading[lang],
      serviceType: 'Online Personal Training',
      description: copy.seo.description[lang],
      url: 'https://kkcoaching.fit/pl/online-coaching',
      areaServed: [{ '@type': 'Country', name: 'United Kingdom' }, { '@type': 'Place', name: 'Online' }],
      provider: { '@type': 'Organization', '@id': 'https://kkcoaching.fit/#business', name: admin.brand.siteName, url: 'https://kkcoaching.fit' }
    },
    { '@type': 'FAQPage', mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
  ]
};
---
<BaseLayout title={copy.seo.title[lang]} description={copy.seo.description[lang]} lang="pl" path="/pl/online-coaching" altPath="/online-coaching" structuredData={structuredData}>
  <section class="online-hero on-dark">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{copy.hero.eyebrow[lang]}</span><h1>{copy.hero.heading[lang]}</h1><p class="lead">{copy.hero.lead[lang]}</p>
        <div class="hero-actions"><a href={copy.hero.primaryHref[lang]} class="btn btn-primary">{copy.hero.primaryCta[lang]}</a><a href={copy.hero.secondaryHref[lang]} class="btn btn-secondary">{copy.hero.secondaryCta[lang]}</a></div>
        <div class="trust-row" aria-label={copy.hero.trustAria[lang]}>{copy.hero.trustPoints.map(item => <span>{item[lang]}</span>)}</div>
      </div>
      <div class="hero-media"><img src={copy.hero.fallbackImage} alt={copy.hero.imageAlt[lang]} width="720" height="540" /></div>
    </div>
  </section>
  <section class="on-white" aria-labelledby="outcomes-heading"><div class="container"><div class="section-head"><span class="eyebrow">{copy.outcomes.eyebrow[lang]}</span><h2 id="outcomes-heading">{copy.outcomes.heading[lang]}</h2><p>{copy.outcomes.body[lang]}</p></div><div class="three-grid">{copy.outcomes.cards.map(item => <article class="info-card"><h3>{item.title[lang]}</h3><p>{item.body[lang]}</p></article>)}</div></div></section>
  <section class="on-dark" aria-labelledby="included-heading"><div class="container split"><div><span class="eyebrow">{copy.included.eyebrow[lang]}</span><h2 id="included-heading">{copy.included.heading[lang]}</h2><p class="dark-copy">{copy.included.body[lang]}</p></div><ul class="check-list">{copy.included.items.map(item => <li>{item[lang]}</li>)}</ul></div></section>
  <section class="app-section on-white" aria-labelledby="app-heading"><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.app.eyebrow[lang]}</span><h2 id="app-heading">{copy.app.heading[lang]}</h2><p>{copy.app.body[lang]}</p></div><div class="app-grid">{copy.app.cards.map(item => <article class="app-card"><h3>{item.title[lang]}</h3><p>{item.body[lang]}</p></article>)}</div></div></section>

  <section class="on-white" aria-labelledby="online-search-heading">
    <div class="container">
      <div class="section-head centered online-search-copy">
        <span class="eyebrow">Prowadzenie online po polsku</span>
        <h2 id="online-search-heading">Trener personalny online: plan, raporty i stałe prowadzenie</h2>
        <p>Jeśli porównujesz trenera personalnego online, trening personalny online albo prowadzenie online, najważniejsze jest to, co dzieje się po ułożeniu planu. Trening, żywienie, regularne raporty i dane o postępach są częścią jednego systemu, dzięki czemu zmiany wynikają z realnych efektów, a nie ze zgadywania.</p>
      </div>
      <div class="three-grid">
        <article class="info-card">
          <h3>Prowadzenie online na redukcję i odchudzanie</h3>
          <p>Ustalamy realny cel kaloryczny, utrzymujemy produktywny trening siłowy i regularnie analizujemy trend, żeby schudnąć bez szybkich diet i ciągłego zmieniania kierunku.</p>
        </article>
        <article class="info-card">
          <h3>Plan treningowy, który zmienia się wraz z postępem</h3>
          <p>Program zaczyna się od Twojego celu, sprzętu i grafiku, a korekty wprowadzam wtedy, kiedy wyniki treningowe, realizacja planu albo postęp pokazują, że są potrzebne.</p>
        </article>
        <article class="info-card">
          <h3>Potrzebujesz tylko planu treningowego?</h3>
          <p>Jeśli nie potrzebujesz stałych raportów, żywienia i bieżącego wsparcia, <a href="/pl/training-plan">indywidualny plan treningowy</a> daje Ci konkretny plan na siłownię bez abonamentu coachingowego.</p>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="process-heading"><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.process.eyebrow[lang]}</span><h2 id="process-heading">{copy.process.heading[lang]}</h2><p>{copy.process.body[lang]}</p></div><div class="process-grid">{copy.process.steps.map(item => <article class="process-card"><span class="num">{item.num}</span><h3>{item.title[lang]}</h3><p>{item.body[lang]}</p></article>)}</div></div></section>
  <section class="proof on-white" aria-labelledby="proof-heading"><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.results.eyebrow[lang]}</span><h2 id="proof-heading">{copy.results.heading[lang]}</h2><p>{copy.results.body[lang]}</p></div><div class="results-grid">{copy.results.items.map(item => <article class="result-card"><img src={item.image} alt={item.imageAlt[lang]} width="600" height="750" loading="lazy" /><div class="result-copy"><span>{item.meta[lang]}</span><h3>{item.heading[lang]}</h3><p>{item.body[lang]}</p></div></article>)}</div><div class="center-cta"><a href={copy.results.href[lang]} class="btn btn-outline-dark">{copy.results.cta[lang]}</a></div></div></section>
  <section class="coach-section on-dark" aria-labelledby="coach-heading"><div class="container coach-grid"><img src={copy.coach.image} alt={copy.coach.imageAlt[lang]} width="500" height="600" loading="lazy" /><div><span class="eyebrow">{copy.coach.eyebrow[lang]}</span><h2 id="coach-heading">{copy.coach.heading[lang]}</h2>{copy.coach.paragraphs.map(item => <p class="dark-copy">{item[lang]}</p>)}<a href={copy.coach.href[lang]} class="btn btn-secondary">{copy.coach.cta[lang]}</a></div></div></section>
  <section class="on-white" aria-labelledby="faq-heading"><div class="container faq-wrap"><div class="section-head centered"><span class="eyebrow">{copy.faq.eyebrow[lang]}</span><h2 id="faq-heading">{copy.faq.heading[lang]}</h2></div><div class="faq-list">{faqs.map(item => <details class="faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></div></section>
  <section class="final-cta"><div class="container"><span class="eyebrow light">{copy.finalCta.eyebrow[lang]}</span><h2>{copy.finalCta.heading[lang]}</h2><p>{copy.finalCta.body[lang]}</p><a href={copy.finalCta.href[lang]} class="btn btn-secondary">{copy.finalCta.cta[lang]}</a></div></section>
</BaseLayout>

<style>
  .online-hero { padding: 72px 0; }
  .hero-grid, .split, .coach-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .hero-copy h1 { color: var(--white); font-size: clamp(2.15rem, 5vw, 4rem); max-width: 14ch; margin-bottom: 18px; }
  .hero-copy .lead { color: #D3D6DA; font-size: 1.12rem; max-width: 58ch; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 30px 0 24px; }
  .trust-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .trust-row span { border: 1px solid #3B4048; border-radius: 999px; padding: 7px 11px; color: #D9DCE0; font-size: 0.78rem; }
  .hero-media img { width: 100%; border-radius: var(--radius); border: 1px solid #363A40; }
  .three-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .info-card, .process-card { background: var(--white); border: 1px solid #E2E4E7; border-radius: var(--radius); padding: 28px 24px; }
  .info-card { border-top: 3px solid var(--red); }
  .info-card h3, .process-card h3 { font-size: 1.08rem; margin-bottom: 10px; }
  .info-card p, .process-card p { color: var(--steel); font-size: 0.94rem; }
  .info-card a { color: var(--red); font-weight: 700; }
  .dark-copy { color: #C0C4CA; max-width: 58ch; margin-bottom: 14px; }
  .check-list { list-style: none; display: grid; gap: 12px; }
  .check-list li { position: relative; padding: 13px 16px 13px 44px; background: #202329; border: 1px solid #333840; border-radius: var(--radius); color: #F1F2F4; }
  .check-list li::before { content: '✓'; position: absolute; left: 16px; color: #E25766; font-weight: 800; }
  .app-section { padding-top: 88px; }
  .app-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .app-card { background: #F6F7F8; border: 1px solid #E2E4E7; border-top: 3px solid var(--red); border-radius: var(--radius); padding: 24px 20px; }
  .app-card h3 { font-size: 1rem; margin-bottom: 9px; }
  .app-card p { color: var(--steel); font-size: 0.9rem; }
  .online-search-copy { max-width: 900px; margin-left: auto; margin-right: auto; }
  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .process-card .num { display: block; color: var(--red); font-weight: 800; font-size: 0.82rem; margin-bottom: 12px; letter-spacing: 0.08em; }
  .results-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 920px; margin: 0 auto; }
  .result-card { background: var(--white); border: 1px solid #E2E4E7; border-radius: var(--radius); overflow: hidden; }
  .result-card img { width: 100%; height: auto; }
  .result-copy { padding: 22px; }
  .result-copy > span { color: var(--red); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; }
  .result-copy h3 { margin: 8px 0; font-size: 1.05rem; }
  .result-copy p { color: var(--steel); font-size: 0.9rem; }
  .center-cta { text-align: center; margin-top: 34px; }
  .coach-grid img { width: 100%; max-height: 620px; object-fit: cover; object-position: center top; border-radius: var(--radius); }
  .faq-wrap { max-width: 860px; }
  .faq-list { border-top: 1px solid #D8DBDE; }
  .faq-item { border-bottom: 1px solid #D8DBDE; padding: 18px 0; }
  .faq-item summary { font-weight: 700; cursor: pointer; list-style: none; padding-right: 34px; position: relative; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; position: absolute; right: 4px; color: var(--red); font-size: 1.25rem; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { color: var(--steel); margin-top: 10px; padding-right: 34px; }
  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 88px 0; }
  .final-cta .eyebrow.light { color: #FFDDE1; }
  .final-cta h2 { color: var(--white); max-width: 720px; margin: 0 auto 14px; }
  .final-cta p { color: #F5DADD; max-width: 62ch; margin: 0 auto 28px; }
  @media (max-width: 900px) { .hero-grid, .split, .coach-grid { grid-template-columns: 1fr; gap: 34px; } .three-grid { grid-template-columns: 1fr; } .app-grid, .process-grid { grid-template-columns: repeat(2, 1fr); } .hero-copy h1 { max-width: none; } }
  @media (max-width: 620px) { .online-hero { padding: 48px 0 56px; } .hero-copy h1 { font-size: clamp(2rem, 9.6vw, 2.75rem); } .hero-copy .lead { font-size: 1rem; } .hero-actions { display: grid; grid-template-columns: 1fr; } .hero-actions .btn { width: 100%; } .trust-row { display: grid; grid-template-columns: 1fr 1fr; } .trust-row span { text-align: center; display: flex; align-items: center; justify-content: center; min-height: 48px; } .app-grid, .process-grid, .results-grid { grid-template-columns: 1fr; } }
</style>

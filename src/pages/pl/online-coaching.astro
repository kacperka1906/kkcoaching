---
import BaseLayout from '../../layouts/BaseLayout.astro';

const outcomes = [
  {
    title: 'Plan dopasowany do Twojego celu',
    body: 'Trening dobieram do Twojego doświadczenia, sprzętu, grafiku i tego, czy priorytetem jest redukcja, masa, rekompozycja czy po prostu powrót do regularności.'
  },
  {
    title: 'Żywienie, które da się utrzymać',
    body: 'Dostajesz konkretne założenia kaloryczne i makroskładniki oraz praktyczne wskazówki, które można dopasować do pracy, rodziny, wyjść i jedzenia, które faktycznie lubisz.'
  },
  {
    title: 'Feedback zanim mały problem stanie się dużym',
    body: 'Regularne check-iny, dane z treningów i nagrania techniki pozwalają reagować wtedy, kiedy naprawdę jest powód do zmiany, zamiast zgadywać.'
  }
];

const included = [
  'Indywidualny plan treningowy',
  'Założenia kaloryczne, makroskładniki i praktyczne wskazówki żywieniowe',
  'Aplikacja coachingowa z planem i materiałami do ćwiczeń',
  'Regularne check-iny i uporządkowana analiza progresu',
  'Monitoring masy ciała, pomiarów, zdjęć i wyników treningowych',
  'Korekty planu na podstawie progresu i realizacji założeń',
  'Ocena techniki na podstawie nagrań z treningu',
  'Kontakt przez WhatsApp pomiędzy check-inami',
  'Edukacja, żebyś rozumiał, dlaczego dany plan działa'
];

const process = [
  {
    num: '01',
    title: 'Konsultacja i punkt startowy',
    body: 'Ustalamy Twój cel, obecny trening, nawyki żywieniowe, grafik, dostępny sprzęt i główny powód, przez który wcześniejsze próby się rozpadały.'
  },
  {
    num: '02',
    title: 'Ustawiamy cały system',
    body: 'Dostajesz indywidualny plan treningowy, założenia żywieniowe i jasny sposób monitorowania postępów.'
  },
  {
    num: '03',
    title: 'Trenujesz, logujesz i jesteśmy w kontakcie',
    body: 'Realizujesz plan, zapisujesz najważniejsze dane i wysyłasz nagrania, jeśli chcesz feedback techniczny. Widzę, co naprawdę dzieje się między check-inami.'
  },
  {
    num: '04',
    title: 'Analizujemy i korygujemy',
    body: 'Patrzymy na trend, a nie pojedynczy pomiar. Jeśli progres, wyniki treningowe albo realizacja założeń pokazują, że coś trzeba zmienić — zmieniamy.'
  }
];

const faqs = [
  {
    q: 'Czy muszę mieszkać w UK, żeby korzystać z coachingu online?',
    a: 'Nie. Coaching online nie jest ograniczony lokalizacją. Jeśli możemy się sprawnie komunikować i masz dostęp do sprzętu potrzebnego do realizacji planu, prowadzenie może odbywać się w pełni zdalnie.'
  },
  {
    q: 'Czy coaching online jest tylko dla osób zaawansowanych?',
    a: 'Nie. Plan jest dopasowany do Twojego poziomu. Jeśli dopiero zaczynasz, możemy zacząć prosto, a nagrania ćwiczeń pozwolą mi dawać Ci feedback techniczny na bieżąco.'
  },
  {
    q: 'Czy dostanę sztywną dietę rozpisaną posiłek po posiłku?',
    a: 'Podstawą są kalorie, makroskładniki i praktyczne zasady żywienia, które da się wdrożyć w normalnym życiu. Jeżeli bardziej szczegółowa struktura posiłków będzie pomocna, możemy ją dopracować, ale celem nie jest uzależnienie Cię od jednej sztywnej rozpiski.'
  },
  {
    q: 'Jak monitorujemy postępy?',
    a: 'W zależności od celu możemy używać trendu masy ciała, pomiarów, zdjęć sylwetki, wyników treningowych, kroków lub aktywności i realizacji założeń. Dopiero całość pokazuje, czy plan wymaga zmiany.'
  },
  {
    q: 'Jaki mam kontakt pomiędzy check-inami?',
    a: 'Masz kontakt przez WhatsApp na pytania, aktualizacje i sytuacje, które nie powinny czekać do kolejnego formalnego check-inu. W ramach coachingu możesz też wysyłać nagrania ćwiczeń do oceny techniki.'
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://kkcoaching.fit/pl/online-coaching#service',
      name: 'Coaching online - trening, żywienie i monitoring progresu',
      serviceType: 'Online Fitness Coaching',
      description: 'Indywidualny coaching online z planem treningowym, założeniami żywieniowymi, regularnymi check-inami, monitoringiem postępów, oceną techniki i stałym wsparciem.',
      url: 'https://kkcoaching.fit/pl/online-coaching',
      areaServed: [
        { '@type': 'Country', name: 'United Kingdom' },
        { '@type': 'Place', name: 'Online' }
      ],
      provider: {
        '@type': 'Organization',
        name: 'KK Coaching',
        url: 'https://kkcoaching.fit'
      }
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(item => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a }
      }))
    }
  ]
};
---
<BaseLayout
  title="Coaching Online | Trening, Żywienie i Check-iny | KK Coaching"
  description="Indywidualny coaching online: plan treningowy, założenia żywieniowe, regularne check-iny, monitoring postępów, feedback techniczny i WhatsApp. Aplikuj do KK Coaching."
  lang="pl"
  path="/pl/online-coaching"
  altPath="/online-coaching"
  structuredData={structuredData}
>
  <section class="online-hero on-dark">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Pełne prowadzenie online</span>
        <h1>Coaching online bez zgadywania, co robić dalej</h1>
        <p class="lead">Indywidualny plan treningowy, praktyczne założenia żywieniowe, regularna kontrola postępów i stałe wsparcie — wszystko dopasowane do Twojego celu i normalnego życia.</p>
        <div class="hero-actions">
          <a href="/pl/contact" class="btn btn-primary">Aplikuj na coaching online</a>
          <a href="/pl/transformations" class="btn btn-secondary">Zobacz przemiany</a>
        </div>
        <div class="trust-row" aria-label="Co obejmuje coaching online">
          <span>Indywidualny plan</span>
          <span>Regularne check-iny</span>
          <span>WhatsApp</span>
          <span>Polski / English</span>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/online-coaching-placeholder.svg" alt="Coaching online KK Coaching z treningiem, żywieniem i monitoringiem postępów" width="720" height="540" />
        <span class="image-note">Grafika tymczasowa — później zastąpimy ją prawdziwym zdjęciem coachingu lub aplikacji.</span>
      </div>
    </div>
  </section>

  <section class="on-white" aria-labelledby="outcomes-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Co się zmienia</span>
        <h2 id="outcomes-heading">Przestajesz kolekcjonować plany. Zaczynasz działać według jednego systemu.</h2>
        <p>Coaching online to nie kolejny PDF z treningiem. Największa wartość to jeden kierunek działania, dane pozwalające ocenić progres i możliwość korekty planu wtedy, kiedy zmienia się Twoje ciało, wyniki albo sytuacja w życiu.</p>
      </div>
      <div class="three-grid">
        {outcomes.map(item => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark" aria-labelledby="included-heading">
    <div class="container split">
      <div>
        <span class="eyebrow">Co dostajesz</span>
        <h2 id="included-heading">Liczy się też to, co dzieje się pomiędzy check-inami.</h2>
        <p class="dark-copy">Chodzi o to, żeby wiedzieć, co dzieje się z tygodnia na tydzień, a nie po miesiącu odkryć, że plan dawno przestał pasować do Twojego życia. Trening, żywienie, dane i feedback mają działać jako jedna całość.</p>
      </div>
      <ul class="check-list">
        {included.map(item => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section aria-labelledby="process-heading">
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">Jak to działa</span>
        <h2 id="process-heading">Prosta pętla: plan, realizacja, analiza, korekta.</h2>
        <p>Zawsze wiesz, jaki jest aktualny cel i na jakich danych opieramy kolejną decyzję.</p>
      </div>
      <div class="process-grid">
        {process.map(item => (
          <article class="process-card">
            <span class="num">{item.num}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="proof on-white" aria-labelledby="proof-heading">
    <div class="container">
      <div class="section-head centered">
        <span class="eyebrow">Prawdziwe prowadzenie. Prawdziwy progres.</span>
        <h2 id="proof-heading">Efekty zbudowane wokół normalnego życia</h2>
        <p>Nie chodzi o jeden idealny tydzień. Chodzi o wystarczająco dużo dobrych tygodni, kontrolę tego, co ma znaczenie i utrzymanie planu na właściwym torze.</p>
      </div>
      <div class="results-grid">
        <article class="result-card">
          <img src="/images/client-transformation-aneta-10kg-16-weeks.svg" alt="16-tygodniowa przemiana Anety w coachingu online KK Coaching — 10 kg mniej i 12 cm mniej w talii" width="600" height="750" loading="lazy" />
          <div class="result-copy">
            <span>ANETA · COACHING ONLINE · 16 TYGODNI</span>
            <h3>-10 kg · -12 cm w talii</h3>
            <p>Do tego większa pewność siebie, przejście z treningów domowych na komercyjną siłownię i lepsza kontrola nocnego podjadania.</p>
          </div>
        </article>
        <article class="result-card">
          <img src="/images/client-transformation-agnieszka-16-weeks.svg" alt="16-tygodniowa przemiana sylwetki Agnieszki w KK Coaching" width="600" height="750" loading="lazy" />
          <div class="result-copy">
            <span>AGNIESZKA · COACHING · 16 TYGODNI</span>
            <h3>-3 kg · +8 cm w biodrach</h3>
            <p>Efekty z planu dopasowanego do jej stylu życia i regularności zamiast pogoni za perfekcją.</p>
          </div>
        </article>
      </div>
      <div class="center-cta"><a href="/pl/transformations" class="btn btn-outline-dark">Zobacz wszystkie przemiany</a></div>
    </div>
  </section>

  <section class="coach-section on-dark" aria-labelledby="coach-heading">
    <div class="container coach-grid">
      <img src="/images/kacper.png" alt="Kacper Kaszowski, założyciel KK Coaching i Level 3 Personal Trainer" width="500" height="600" loading="lazy" />
      <div>
        <span class="eyebrow">Twój trener</span>
        <h2 id="coach-heading">Ten proces ma dla mnie znaczenie, bo sam musiałem nauczyć się go od zera.</h2>
        <p class="dark-copy">Zaczynałem z masą około 117 kg i zredukowałem ponad 40 kg, zanim całkowicie przebudowałem swoją sylwetkę. Po drodze nauczyłem się, jak łatwo pomylić „trudniej” z „lepiej”, szukać szybkich rozwiązań i zmieniać plan zanim zdąży zadziałać.</p>
        <p class="dark-copy">Dzisiaj te same zasady wykorzystuję w pracy z podopiecznymi: jasny cel, realne wykonanie, konkretny feedback i zmiany na podstawie postępów, a nie emocji.</p>
        <a href="/pl/about" class="btn btn-secondary">Poznaj swojego trenera</a>
      </div>
    </div>
  </section>

  <section class="on-white" aria-labelledby="faq-heading">
    <div class="container faq-wrap">
      <div class="section-head centered">
        <span class="eyebrow">Pytania</span>
        <h2 id="faq-heading">Coaching online — FAQ</h2>
      </div>
      <div class="faq-list">
        {faqs.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container">
      <span class="eyebrow light">Zacznijmy od rozmowy</span>
      <h2>Jeśli masz dość zgadywania, napisz mi, gdzie jesteś teraz.</h2>
      <p>Napisz, jaki masz cel, jakie masz doświadczenie, jak wygląda Twój obecny tydzień i co do tej pory najbardziej Cię blokowało. Powiem Ci, czy coaching online będzie odpowiednią formą wsparcia i jak wygląda kolejny krok.</p>
      <a href="/pl/contact" class="btn btn-secondary">Aplikuj na coaching online</a>
    </div>
  </section>
</BaseLayout>

<style>
  .online-hero { padding: 72px 0; }
  .hero-grid, .split, .coach-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .hero-copy h1 { color: var(--white); font-size: clamp(2.15rem, 5vw, 4rem); max-width: 14ch; margin-bottom: 18px; }
  .hero-copy .lead { color: #D3D6DA; font-size: 1.12rem; max-width: 58ch; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 30px 0 24px; }
  .trust-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .trust-row span { border: 1px solid #3B4048; border-radius: 999px; padding: 7px 11px; color: #D9DCE0; font-size: 0.78rem; }
  .hero-media img { width: 100%; border-radius: var(--radius); border: 1px solid #363A40; }
  .image-note { display: block; color: #90959D; font-size: 0.72rem; margin-top: 8px; }

  .three-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .info-card, .process-card { background: var(--white); border: 1px solid #E2E4E7; border-radius: var(--radius); padding: 28px 24px; }
  .info-card { border-top: 3px solid var(--red); }
  .info-card h3, .process-card h3 { font-size: 1.08rem; margin-bottom: 10px; }
  .info-card p, .process-card p { color: var(--steel); font-size: 0.94rem; }

  .dark-copy { color: #C0C4CA; max-width: 58ch; margin-bottom: 14px; }
  .check-list { list-style: none; display: grid; gap: 12px; }
  .check-list li { position: relative; padding: 13px 16px 13px 44px; background: #202329; border: 1px solid #333840; border-radius: var(--radius); color: #F1F2F4; }
  .check-list li::before { content: '✓'; position: absolute; left: 16px; color: #E25766; font-weight: 800; }

  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .process-card .num { display: block; color: var(--red); font-weight: 800; font-size: 0.82rem; margin-bottom: 12px; letter-spacing: 0.08em; }

  .results-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 920px; margin: 0 auto; }
  .result-card { background: var(--white); border: 1px solid #E2E4E7; border-radius: var(--radius); overflow: hidden; }
  .result-card img { width: 100%; height: auto; }
  .result-copy { padding: 22px; }
  .result-copy > span { color: var(--red); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; }
  .result-copy h3 { margin: 8px 0; font-size: 1.05rem; }
  .result-copy p { color: var(--steel); font-size: 0.9rem; }
  .center-cta { text-align: center; margin-top: 34px; }

  .coach-grid img { width: 100%; max-height: 620px; object-fit: cover; object-position: center top; border-radius: var(--radius); }

  .faq-wrap { max-width: 860px; }
  .faq-list { border-top: 1px solid #D8DBDE; }
  .faq-item { border-bottom: 1px solid #D8DBDE; padding: 18px 0; }
  .faq-item summary { font-weight: 700; cursor: pointer; list-style: none; padding-right: 34px; position: relative; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; position: absolute; right: 4px; color: var(--red); font-size: 1.25rem; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { color: var(--steel); margin-top: 10px; padding-right: 34px; }

  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 88px 0; }
  .final-cta .eyebrow.light { color: #FFDDE1; }
  .final-cta h2 { color: var(--white); max-width: 720px; margin: 0 auto 14px; }
  .final-cta p { color: #F5DADD; max-width: 62ch; margin: 0 auto 28px; }

  @media (max-width: 900px) {
    .hero-grid, .split, .coach-grid { grid-template-columns: 1fr; gap: 34px; }
    .three-grid { grid-template-columns: 1fr; }
    .process-grid { grid-template-columns: repeat(2, 1fr); }
    .hero-copy h1 { max-width: none; }
  }

  @media (max-width: 620px) {
    .online-hero { padding: 48px 0 56px; }
    .hero-copy h1 { font-size: clamp(2rem, 9.6vw, 2.75rem); }
    .hero-copy .lead { font-size: 1rem; }
    .hero-actions { display: grid; grid-template-columns: 1fr; }
    .hero-actions .btn { width: 100%; }
    .trust-row { display: grid; grid-template-columns: 1fr 1fr; }
    .trust-row span { text-align: center; }
    .process-grid, .results-grid { grid-template-columns: 1fr; }
  }
</style>

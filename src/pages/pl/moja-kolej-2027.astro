---
import BaseLayout from '../../layouts/BaseLayout.astro';

const url = '/pl/moja-kolej-2027/';
const features = [
  { id: 'grupa', icon: 'whatsapp', eyebrow: '01 / SPOŁECZNOŚĆ', title: 'Prywatna grupa WhatsApp', detail: 'Miejsce na pytania, pomysły na posiłki, wspólne sukcesy i wsparcie osób, które też chcą znaleźć czas dla siebie.', items: ['Rozmowy i wymiana doświadczeń', 'Przepisy, zakupy i codzienne pomysły', 'Cotygodniowe sukcesy i wzajemna motywacja'] },
  { id: 'spotkania', icon: 'video', eyebrow: '02 / SPOTKANIA', title: '16 spotkań na żywo', detail: 'Co tydzień spotykamy się po polsku na około 45–60 minut. Omawiamy temat tygodnia, pytania, postępy i codzienne wyzwania.', items: ['Planowane 16 spotkań grupowych', 'Pytania można przesłać wcześniej', 'Termin do ustalenia przed startem'] },
  { id: 'zadania', icon: 'check', eyebrow: '03 / PRAKTYKA', title: 'Jedno zadanie na tydzień', detail: 'Nie tylko słuchasz. Co tydzień wdrażasz jedną prostą rzecz, którą możesz naprawdę wykorzystać w swoim życiu.', items: ['Lista zakupów i porównanie etykiet', 'Przygotowanie posiłków na zapas', 'Plan awaryjny na trudniejszy dzień'] },
  { id: 'warsztaty', icon: 'book', eyebrow: '04 / WIEDZA', title: 'Warsztaty, które się przydają', detail: 'Jedzenie poza domem, czytanie opakowań, gotowanie, regeneracja i planowanie — bez przekombinowanej teorii.', items: ['Posiłki i zakupy w rozsądnym budżecie', 'Sen, regeneracja i codzienne nawyki', 'Samodzielne planowanie treningu i jedzenia'] },
  { id: 'podsumowania', icon: 'chart', eyebrow: '05 / TWÓJ PROGRES', title: 'Dwa ważne przystanki', detail: 'Sprawdzamy nie tylko wyniki, ale też to, co działa, co przeszkadza i co warto zmienić.', items: ['Tydzień 8 — analiza i korekty', 'Tydzień 16 — indywidualna ocena całej drogi', 'Plan dalszego działania'] },
  { id: 'wyroznienia', icon: 'star', eyebrow: '06 / DOCENIENIE', title: 'Nagrody i wyróżnienia', detail: 'Chcemy docenić nie tylko wynik, ale też systematyczność, zaangażowanie i indywidualny progres.', items: ['Rozważana profesjonalna sesja zdjęciowa', 'Wyróżnienie za systematyczność', 'Wyróżnienie za indywidualny postęp'] }
];
const coaching = [
  'Indywidualny plan treningowy dopasowany do celu i możliwości',
  'Plan żywieniowy z konkretnymi posiłkami, przepisami i gramaturami',
  'Aplikacja MyPTHub do treningów i monitorowania postępów',
  'Zapisywanie ciężarów, powtórzeń, pomiarów i wyników',
  'Cotygodniowe raporty i informacje zwrotne',
  'Korekty planów i wskazówki dotyczące techniki',
  'Kontakt z trenerem w uzgodnionych ramach',
  'Możliwość dokupienia sesji 1:1 w Cwmbran na osobnych zasadach'
];
const phases = [
  { number: '01', title: 'Fundamenty', range: 'Tygodnie 1–4', weeks: ['Start, cele i organizacja tygodnia', 'Mądre zakupy i lista produktów', 'Czytanie etykiet i świadome wybory', 'Planowanie i przygotowywanie posiłków'] },
  { number: '02', title: 'Regularność', range: 'Tygodnie 5–8', weeks: ['Białko, błonnik i sytość', 'Jedzenie poza domem i elastyczność', 'Motywacja, dyscyplina i trudniejsze dni', 'Podsumowanie pierwszych ośmiu tygodni'] },
  { number: '03', title: 'Rozwój', range: 'Tygodnie 9–12', weeks: ['Progres treningowy', 'Sen, regeneracja i codzienna aktywność', 'Zakupy i żywienie w określonym budżecie', 'Apetyt, podjadanie i rozpoznawanie nawyków'] },
  { number: '04', title: 'Samodzielność', range: 'Tygodnie 13–16', weeks: ['Ocena postępów i stagnacji', 'Wyjazdy, zmiany planów i trudne tygodnie', 'Plan utrzymania wypracowanych nawyków', 'Końcowa analiza i dalsza droga'] }
];
const week = [
  { day: 'Pon.', title: 'Nowy temat', body: 'Poznajesz temat tygodnia i otrzymujesz praktyczne zadanie.' },
  { day: 'Wt.', title: 'Wskazówka', body: 'Pomysł do wykorzystania w kuchni, sklepie lub podczas treningu.' },
  { day: 'Śr.', title: 'Spotkanie na żywo', body: 'Rozmawiamy, uczymy się i odpowiadamy na pytania.' },
  { day: 'Czw.', title: 'Wdrażanie', body: 'Działasz, sprawdzasz i pytasz, gdy coś wymaga wyjaśnienia.' },
  { day: 'Pt.', title: 'Małe zwycięstwa', body: 'Dzielimy się postępami i wspieramy nawzajem.' },
  { day: 'Weekend', title: 'Raport i przygotowanie', body: 'Podsumowanie tygodnia, indywidualny raport i plan kolejnych dni.' }
];
const people = [
  'Chcesz zmniejszyć ilość tkanki tłuszczowej bez kolejnego zrywu na chwilę.',
  'Chcesz zbudować mięśnie, siłę i poprawić sylwetkę.',
  'Trenujesz, ale brakuje Ci regularnego progresu.',
  'Masz pracę, rodzinę i dużo obowiązków — potrzebujesz sensownego planu.',
  'Nie wiesz, jak planować jedzenie bez ciągłego zaczynania od nowa.',
  'Chcesz indywidualnego prowadzenia, ale też ludzi, którzy rozumieją Twoją sytuację.'
];
const faqs = [
  ['Czy program jest tylko dla osób, które chcą schudnąć?', 'Nie. Cele mogą być różne: redukcja tkanki tłuszczowej, budowa mięśni, poprawa sprawności, regularności lub nawyków. Plan będzie dopasowany do Twojego celu.'],
  ['Czy muszę mieć doświadczenie na siłowni?', 'Nie. Poziom i dobór ćwiczeń dostosujemy do Twojego doświadczenia oraz możliwości.'],
  ['Czy program jest odpowiedni dla początkujących?', 'Tak, również dla osób zaczynających od podstaw. Przed rozpoczęciem współpracy sprawdzimy, czy ten format będzie dla Ciebie odpowiedni.'],
  ['Czy potrzebuję karnetu na siłownię?', 'To zależy od indywidualnego planu treningowego i dostępnego sprzętu. Nie każdy musi trenować na siłowni; wymagania ustalimy podczas wdrożenia.'],
  ['Czy dostanę indywidualny plan treningowy?', 'Tak. Każdy uczestnik otrzymuje indywidualny plan i jego korekty wynikające z raportów oraz postępów.'],
  ['Czy dostanę indywidualny jadłospis?', 'Tak. Plan żywieniowy będzie dopasowany do ustalonego celu i obejmie posiłki, przepisy oraz gramatury.'],
  ['Jak działa grupa WhatsApp?', 'To zamknięta grupa uczestników służąca wymianie doświadczeń, pytaniom i wzajemnemu wsparciu. Przed dołączeniem wyjaśnimy zasady, w tym widoczność numerów telefonów dla innych członków. Nie oznacza to całodobowej dostępności trenera.'],
  ['Czy muszę uczestniczyć w każdym spotkaniu na żywo?', 'Warto uczestniczyć regularnie, ale rozumiemy, że zdarzają się obowiązki i zmiany. Zasady nieobecności oraz ewentualnych materiałów zastępczych podamy przed rozpoczęciem zapisów. Nie obiecujemy nagrań wszystkich spotkań.'],
  ['Co, jeśli pracuję zmianowo?', 'Indywidualny trening i żywienie można dopasować do grafiku. Dzień spotkań grupowych pozostaje propozycją i będzie potwierdzony przed startem.'],
  ['Jak wyglądają cotygodniowe raporty?', 'Przekazujesz informacje o realizacji treningów, żywieniu, pomiarach i trudnościach. Na tej podstawie otrzymujesz informację zwrotną i w razie potrzeby zmiany planu.'],
  ['Czy mogę dokupić treningi personalne w Cwmbran?', 'Tak, w miarę dostępności terminów. Sesje 1:1 w JD Gyms Cwmbran są odrębną usługą i podlegają osobnym warunkom oraz wymaganiom dostępu do klubu.'],
  ['Ile kosztuje udział?', 'Robocza cena pierwszej edycji wynosi £450 za 16 tygodni. To propozycja do ostatecznego potwierdzenia przed zapisami.'],
  ['Jak będzie wyglądać płatność w dwóch blokach?', 'Proponujemy £50 na etapie rezerwacji (zaliczane na cenę), następnie £175 przed pierwszym blokiem i £225 przed drugim. Terminy, rezygnacje i zwroty podamy po zatwierdzeniu regulaminu. Teraz nie przyjmujemy wpłat ani rezerwacji.'],
  ['Co dzieje się po 16 tygodniach?', 'Otrzymujesz końcowe podsumowanie i plan dalszego działania. Ewentualna współpraca po zakończeniu tej edycji będzie ustalana osobno.'],
  ['Czy udział w programie gwarantuje określony efekt?', 'Nie. Efekty zależą m.in. od indywidualnej sytuacji, regularności, zdrowia i realizacji planu. Nie gwarantujemy konkretnych zmian masy ciała ani sylwetki.']
];
---
<BaseLayout
  lang="pl"
  path={url}
  noindex={true}
  title="MOJA KOLEJ 2027 — 16 tygodni prowadzenia | KK Coaching"
  description="MOJA KOLEJ 2027: 16 tygodni indywidualnego prowadzenia, spotkania na żywo, grupa wsparcia i praktyczne zadania. Podgląd programu — zapisy jeszcze nie ruszyły."
  socialImage="/images/kacper.jpg"
  socialImageAlt="Kacper Kaszowski — trener KK Coaching"
>
  <!-- Unpublished programme preview: no checkout, no live sign-up form, no internal promotion. -->
  <svg class="svg-definitions" aria-hidden="true" width="0" height="0" xmlns="http://www.w3.org/2000/svg">
    <symbol id="mk-whatsapp" viewBox="0 0 24 24"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></symbol>
    <symbol id="mk-video" viewBox="0 0 24 24"><rect x="2" y="5" width="14" height="14" rx="3"/><path d="m16 10 6-4v12l-6-4"/></symbol>
    <symbol id="mk-check" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="m8 12 3 3 5-6"/></symbol>
    <symbol id="mk-book" viewBox="0 0 24 24"><path d="M12 6c-3-2-6-2-10-1v14c4-1 7-1 10 1 3-2 6-2 10-1V5c-4-1-7-1-10 1Zm0 0v14"/></symbol>
    <symbol id="mk-chart" viewBox="0 0 24 24"><path d="M3 20h18M5 16l5-5 4 3 5-8"/><path d="M16 6h3v3"/></symbol>
    <symbol id="mk-star" viewBox="0 0 24 24"><path d="m12 2 3.1 6.3 7 .9-5.1 5 .9 7-5.9-3.3-5.9 3.3.9-7-5.1-5 7-.9Z"/></symbol>
  </svg>

  <div class="mk">
    <section class="mk-hero" aria-labelledby="mk-title">
      <div class="container mk-hero-grid">
        <div class="hero-text">
          <p class="mk-eyebrow"><span class="mk-dot"></span> KK COACHING PRZEDSTAWIA <span class="preview-tag">PODGLĄD PROGRAMU</span></p>
          <h1 id="mk-title"><span>MOJA</span><span>KOLEJ<span class="period">.</span></span><em>2027</em></h1>
          <p class="hero-slogan">16 tygodni. 10 osób.<br/><strong>Teraz czas na Ciebie.</strong></p>
          <p class="hero-intro">Praca, rodzina, obowiązki… Zawsze jest coś ważniejszego. A kiedy ostatnio zrobiłeś coś dla siebie?</p>
          <p class="hero-description">Indywidualny trening i żywienie, cotygodniowe spotkania na żywo, zamknięta grupa wsparcia, praktyczne zadania i wiedza, dzięki której łatwiej zadbasz o siebie również po zakończeniu programu.</p>
          <a class="mk-button" href="#poznaj-program">Poznaj program <span aria-hidden="true">↓</span></a>
          <p class="hero-note">Zapisy jeszcze nie ruszyły. To podgląd planowanej edycji.</p>
        </div>
        <div class="hero-photo">
          <img src="/images/kacper.jpg" width="960" height="1200" fetchpriority="high" alt="Kacper Kaszowski, prowadzący KK Coaching" />
          <div class="photo-shadow" aria-hidden="true"></div>
          <div class="photo-caption"><span>KK / 2027</span><strong>TWÓJ RUCH.</strong></div>
        </div>
      </div>
      <div class="container stats-row" aria-label="Najważniejsze informacje">
        <div><strong>16</strong><span>tygodni pracy</span></div>
        <div><strong>10</strong><span>miejsc w pierwszej edycji</span></div>
        <div><strong>04.01</strong><span>planowany start 2027</span></div>
      </div>
    </section>

    <section class="mk-intro" id="poznaj-program" aria-labelledby="mk-intro-title">
      <div class="container intro-grid">
        <div><p class="mk-label">ODŁÓŻ „KIEDYŚ” NA BOK</p><h2 id="mk-intro-title">Ile razy stawiałeś siebie <span>na końcu listy?</span></h2></div>
        <div><p>Nie potrzebujesz idealnego momentu. Potrzebujesz sposobu, który da się pogodzić z normalnym życiem.</p><p><strong>MOJA KOLEJ 2027</strong> to 16 tygodni indywidualnego prowadzenia, praktycznej nauki i pracy w niewielkiej grupie. Bez obietnic cudownej przemiany w kilka dni.</p><blockquote>16 tygodni prowadzenia.<br/>Wiedza i nawyki na znacznie dłużej.</blockquote></div>
      </div>
    </section>

    <section class="mk-community" aria-labelledby="mk-community-title">
      <div class="container">
        <div class="mk-section-heading centered">
          <p class="mk-label">RAZEM ŁATWIEJ WYTRWAĆ</p>
          <h2 id="mk-community-title">Tym razem <span>nie działasz sam.</span></h2>
          <p>Masz swój indywidualny plan, ale obok Ciebie jest trener i grupa osób, które również postanowiły w końcu znaleźć czas dla siebie.</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => (
            <article class:list={['feature-card', { 'feature-whatsapp': feature.id === 'grupa', 'feature-live': feature.id === 'spotkania' }]}>
              <div class="feature-top">
                <span class="feature-icon"><svg class:list={{ 'brand-whatsapp': feature.icon === 'whatsapp' }} aria-hidden="true" viewBox="0 0 24 24"><use href={'#mk-' + feature.icon} /></svg></span>
                <span class="feature-index">{feature.eyebrow}</span>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.detail}</p>
              {feature.id === 'zadania' ? (
                <div class="mock-task" aria-label="Przykładowa lista zadań, nie jest interaktywna">
                  <span class="task-title">PRZYKŁAD ZADANIA · TYDZIEŃ 2</span>
                  <span><span aria-hidden="true" class="fake-check checked">✓</span> Przygotuj listę zakupów</span>
                  <span><span aria-hidden="true" class="fake-check"></span> Porównaj dwie etykiety</span>
                  <span><span aria-hidden="true" class="fake-check"></span> Zaplanuj 3 posiłki</span>
                </div>
              ) : feature.id === 'podsumowania' ? (
                <div class="milestone-mini"><div><b>08</b><span>Sprawdzamy postępy</span></div><div><b>16</b><span>Podsumowujemy drogę</span></div></div>
              ) : <ul>{feature.items.map(item => <li>{item}</li>)}</ul>}
              {feature.id === 'grupa' && <p class="small-caution">Przed dołączeniem wyjaśnimy zasady prywatności, w tym widoczność numerów telefonów dla członków grupy. Bez obietnicy kontaktu 24/7.</p>}
              {feature.id === 'wyroznienia' && <p class="small-caution">Planujemy również nagrody i wyróżnienia. Szczegóły podamy po zatwierdzeniu zasad.</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mk-coaching" aria-labelledby="mk-coaching-title">
      <div class="container coaching-grid">
        <div class="coaching-lead">
          <p class="mk-label">TWÓJ PLAN. TWÓJ CEL.</p>
          <h2 id="mk-coaching-title">A do tego pełne, <span>indywidualne prowadzenie.</span></h2>
          <p>Nie dostajesz planu skopiowanego dla dziesięciu osób. Każdy uczestnik pracuje nad własnym celem, w swoim tempie i z programem dopasowanym do możliwości.</p>
          <div class="app-preview" aria-label="Przykładowy widok postępów, grafika poglądowa">
            <div class="app-header"><span class="app-mark">KK</span><span>TWÓJ PROGRES</span><span class="app-status">● PLAN</span></div>
            <div class="app-chart" aria-hidden="true"><span style="height:38%"></span><span style="height:52%"></span><span style="height:48%"></span><span style="height:68%"></span><span style="height:62%"></span><span style="height:83%"></span><span style="height:93%"></span></div>
            <div class="app-footer"><span>Tydzień 01</span><strong>Systematyczność, nie perfekcja.</strong><span>Tydzień 16</span></div>
          </div>
        </div>
        <div class="coaching-list">
          {coaching.map((item, index) => <div class="coaching-point"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{item}</p><b aria-hidden="true">✓</b></div>)}
          <p class="coaching-footnote">Indywidualne prowadzenie jest częścią standardowej pracy KK Coaching. W tej edycji uzupełniają je spotkania, społeczność, warsztaty i wspólny harmonogram.</p>
        </div>
      </div>
    </section>

    <section class="mk-roadmap" id="program-16-tygodni" aria-labelledby="mk-roadmap-title">
      <div class="container">
        <div class="mk-section-heading">
          <p class="mk-label">OD PIERWSZEGO DNIA DO SAMODZIELNOŚCI</p>
          <h2 id="mk-roadmap-title">16 tygodni.<br/><span>Cztery etapy.</span></h2>
          <p>Każdy etap ma swój temat. Wiedzę od razu przekładasz na praktykę, a indywidualny trening i żywienie towarzyszą Ci przez cały program.</p>
        </div>
        <div class="phase-grid">
          {phases.map((phase, phaseIndex) => (
            <article class="phase">
              <div class="phase-head"><span class="phase-n">{phase.number}</span><div><span class="phase-range">{phase.range}</span><h3>{phase.title}</h3></div></div>
              <ol start={phaseIndex * 4 + 1}>
                {phase.weeks.map((entry, weekIndex) => (
                  <li><span class="week-index">{String(phaseIndex * 4 + weekIndex + 1).padStart(2, '0')}</span><span>{entry}</span></li>
                ))}
              </ol>
            </article>
          ))}
        </div>
        <div class="timeline-end"><strong>04 STYCZNIA 2027</strong><span aria-hidden="true"></span><strong>25 KWIETNIA 2027</strong></div>
      </div>
    </section>

    <section class="mk-rhythm" aria-labelledby="mk-week-title">
      <div class="container">
        <div class="mk-section-heading centered"><p class="mk-label">PRZYKŁADOWY RYTM</p><h2 id="mk-week-title">Jak wygląda <span>Twój tydzień?</span></h2><p>Małe działania, które łatwiej zmieścić w codzienności. Dzień spotkania i ostateczny harmonogram zostaną ustalone przed zapisami.</p></div>
        <div class="week-grid">
          {week.map((entry, index) => (
            <div class:list={['day-card', { 'day-live': index === 2 }]}>
              <span class="day-name">{entry.day}</span><div class="day-dot" aria-hidden="true"></div><h3>{entry.title}</h3><p>{entry.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mk-fit" aria-labelledby="mk-fit-title">
      <div class="container fit-grid">
        <div><p class="mk-label">RÓŻNE CELE. WSPÓLNA DECYZJA.</p><h2 id="mk-fit-title">To może być <span>Twój moment.</span></h2><p>Nie musisz mieć tego samego celu co pozostali. Ważniejsze, żebyś chciał pracować nad swoim i wiedział, dlaczego to robisz.</p><p class="fit-note">Program przeznaczony jest dla osób dorosłych. Przy szczególnych potrzebach zdrowotnych może być potrzebna indywidualna ocena i wsparcie odpowiedniego specjalisty.</p></div>
        <ul class="fit-list">{people.map((item, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{item}</li>)}</ul>
      </div>
    </section>

    <section class="mk-coach" aria-labelledby="mk-coach-title">
      <div class="container coach-grid">
        <div class="coach-photo"><img src="/images/kacper.jpg" width="760" height="900" loading="lazy" alt="Kacper Kaszowski, trener personalny i założyciel KK Coaching" /><span>KK COACHING / KACPER KASZOWSKI</span></div>

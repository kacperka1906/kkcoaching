---
import BaseLayout from '../../layouts/BaseLayout.astro';

const features = [
  { number:'01', symbol:'◉', title:'Prywatna grupa WhatsApp', kicker:'Ludzie, którzy rozumieją Twój cel', body:'Zamknięta grupa do wymiany doświadczeń, pytań i codziennego wsparcia. Rozmawiamy o posiłkach, zakupach, treningu i tym, jak poradzić sobie z trudniejszym tygodniem.', points:['Pomysły na przepisy i zakupy','Pytania, dyskusje i cotygodniowe sukcesy','Wsparcie innych uczestników'], note:'Przed dołączeniem wyjaśnimy, że członkowie grupy mogą widzieć wzajemnie swoje numery telefonu.' },
  { number:'02', symbol:'▣', title:'Spotkania na żywo', kicker:'16 spotkań na żywo', body:'Raz w tygodniu spotykamy się na grupowej wideorozmowie po polsku. Około 45–60 minut na pytania, praktyczne przykłady, edukację i omówienie postępów.', points:['Planowanych 16 spotkań w całym programie','Możesz wcześniej przesłać pytanie','Dzień i godzina do potwierdzenia'] },
  { number:'03', symbol:'☑', title:'Zadania tygodniowe', kicker:'Małe działania, które zostają na dłużej', body:'Co tydzień dostajesz jedno konkretne zadanie, żeby wiedza nie kończyła się na przeczytaniu kolejnej porady.', points:['Lista zakupów i porównanie etykiet','Przygotowanie posiłków i plan aktywności','Plan awaryjny na trudniejszy dzień'] },
  { number:'04', symbol:'✦', title:'Warsztaty i praktyczna wiedza', kicker:'Wiedza do wykorzystania poza programem', body:'Uczymy się robić sensowne zakupy, czytać etykiety, planować jedzenie i trening w realnym grafiku. Bez szukania idealnych warunków.', points:['Budżet, przepisy i zamienniki produktów','Regeneracja, sen i jedzenie na mieście','Samodzielne prowadzenie treningu i żywienia'] },
  { number:'05', symbol:'↗', title:'Indywidualne podsumowania', kicker:'Sprawdzamy, co naprawdę działa', body:'Nie tylko odhaczamy kolejne tygodnie. Dwa ważne momenty pozwolą spojrzeć na dane, trudności i wnioski.', points:['Tydzień 8 — analiza realizacji, pomiarów i korekty','Tydzień 16 — osiągnięcia, nawyki i dalszy plan'] },
  { number:'06', symbol:'★', title:'Nagrody i wyróżnienia', kicker:'Doceniamy drogę, nie tylko wynik', body:'Rozważamy sesję fotograficzną jako nagrodę główną oraz wyróżnienia za systematyczność i indywidualny postęp.', points:['Szczegóły po zatwierdzeniu zasad'], note:'Planujemy również nagrody i wyróżnienia. Szczegóły podamy po zatwierdzeniu zasad.' },
];
const coaching = [
'Indywidualny plan treningowy dopasowany do Twojego celu i możliwości',
'Plan żywieniowy z konkretnymi posiłkami, przepisami i gramaturami',
'Dostęp do MyPTHub, zapis treningów i monitorowanie postępów',
'Cotygodniowe raporty, pomiary i bieżące korekty programu',
'Informacje zwrotne o technice i kontakt z trenerem w ustalonych ramach',
'Możliwość dokupienia treningów 1:1 w Cwmbran na odrębnych zasadach'
];
const stages = [
  {number:'01',name:'Fundamenty',range:'Tygodnie 1–4',weeks:[
    'Start, cele i organizacja tygodnia','Mądre zakupy i lista produktów','Czytanie etykiet i świadome wybory','Planowanie i przygotowywanie posiłków']},
  {number:'02',name:'Regularność',range:'Tygodnie 5–8',weeks:[
    'Białko, błonnik i sytość','Jedzenie poza domem i elastyczność','Motywacja, dyscyplina i trudniejsze dni','Indywidualne podsumowanie pierwszych ośmiu tygodni']},
  {number:'03',name:'Rozwój',range:'Tygodnie 9–12',weeks:[
    'Progres treningowy','Sen, regeneracja i aktywność codzienna','Zakupy i żywienie w ustalonym budżecie','Apetyt, podjadanie i rozpoznawanie nawyków']},
  {number:'04',name:'Samodzielność',range:'Tygodnie 13–16',weeks:[
    'Ocena postępów i stagnacji','Elastyczność podczas wyjazdów i trudnych tygodni','Plan utrzymania wypracowanych nawyków','Końcowa analiza, podsumowanie i dalsza droga']}
];
const rhythm = [
['Poniedziałek','Nowy temat i zadanie'],
['Wtorek','Praktyczna wskazówka w grupie'],
['Środa','Planowane spotkanie na żywo'],
['Czwartek','Zadania, pytania i rozmowy'],
['Piątek','Sukcesy tygodnia i wzajemne wsparcie'],
['Weekend','Przygotowanie i indywidualny raport']
];
const audiences = [
'Chcesz zredukować tkankę tłuszczową, ale trudno Ci utrzymać wcześniejsze zmiany.',
'Chcesz budować mięśnie, siłę lub po prostu poprawić sylwetkę.',
'Trenujesz, ale brakuje Ci jasnego planu i mierzalnego progresu.',
'Łączysz pracę, rodzinę i obowiązki, więc potrzebujesz realnego systemu.',
'Chcesz nauczyć się planować zakupy, posiłki i treningi.',
'Potrzebujesz indywidualnego prowadzenia oraz ludzi, z którymi łatwiej zachować regularność.'
];
const faq = [
['Czy program jest tylko dla osób, które chcą schudnąć?','Nie. Możesz pracować nad redukcją, budową mięśni, sprawnością, siłą lub regularnością. Plan jest dobierany indywidualnie.'],
['Czy muszę mieć doświadczenie na siłowni?','Nie. Plan treningowy dostosowujemy do Twojego poziomu i możliwości.'],
['Czy program jest odpowiedni dla początkujących?','Tak, założeniem programu jest praca zarówno z osobami początkującymi, jak i z tymi, które już trenują.'],
['Czy potrzebuję karnetu na siłownię?','To zależy od ustalonego planu i dostępnego sprzętu. Omówimy to przed rozpoczęciem współpracy.'],
['Czy dostanę indywidualny plan treningowy?','Tak. Treningi będą dopasowane do Twojego celu, poziomu i dostępnego czasu.'],
['Czy dostanę indywidualny jadłospis?','Tak. Plan żywieniowy obejmie konkretne posiłki, gramatury i przepisy dobrane do ustaleń.'],
['Jak działa grupa WhatsApp?','Będzie to prywatna grupa uczestników do rozmów, pytań i wsparcia. Numery telefonów mogą być widoczne dla pozostałych członków. Nie oznacza to całodobowej dostępności trenera.'],
['Czy muszę uczestniczyć w każdym spotkaniu na żywo?','Zachęcamy do udziału, ale rozumiemy pracę i obowiązki. Zasady nieobecności i ewentualnych materiałów podamy przed rozpoczęciem zapisów.'],
['Co, jeśli pracuję zmianowo?','Indywidualny trening i żywienie uwzględniają Twój grafik. Terminy spotkań grupowych zostaną potwierdzone przed zapisami.'],
['Jak wyglądają cotygodniowe raporty?','Przekazujesz ustalone informacje o treningach, pomiarach, realizacji planu i trudnościach. Na tej podstawie omawiamy postępy i potrzebne zmiany.'],
['Czy mogę dokupić treningi personalne w Cwmbran?','Tak, taka możliwość jest planowana na odrębnych zasadach i według dostępnych terminów.'],
['Ile kosztuje udział?','Robocza cena wynosi £450 za cały 16-tygodniowy program. Warunki wymagają jeszcze ostatecznego potwierdzenia.'],
['Jak będzie wyglądać płatność w dwóch blokach?','Propozycja to £50 zaliczone na poczet całej ceny, następnie £175 przed pierwszym blokiem i £225 przed drugim. Na razie nie przyjmujemy wpłat ani rezerwacji.'],
['Co dzieje się po 16 tygodniach?','Otrzymasz indywidualne podsumowanie i plan dalszego działania. Ewentualna dalsza współpraca jest osobną decyzją.'],
['Czy udział w programie gwarantuje określony efekt?','Nie. Rezultaty zależą m.in. od indywidualnych warunków, regularności i realizacji planu. Nie obiecujemy konkretnej zmiany masy ciała ani sylwetki.']
];
---
<BaseLayout
  title="MOJA KOLEJ 2027 | 16 tygodni z KK Coaching"
  description="MOJA KOLEJ 2027: 16 tygodni indywidualnego prowadzenia online, 16 spotkań na żywo i kameralna grupa 10 osób. Podgląd programu — zapisy jeszcze nie ruszyły."
  lang="pl"
  path="/pl/moja-kolej-2027/"
  noindex={true}
  socialImage="/images/kacper-gym-physique.webp"
  socialImageAlt="Kacper Kaszowski, trener personalny KK Coaching"
>
  <div class="mk-preview" role="status"><span class="mk-pulse" aria-hidden="true"></span> PODGLĄD PROGRAMU · Zapisy jeszcze nie ruszyły</div>
  <section class="mk-hero" aria-labelledby="mk-heading">
    <div class="container mk-hero-grid">
      <div class="mk-hero-copy">
        <span class="mk-overline">KK COACHING PRZEDSTAWIA</span>
        <h1 id="mk-heading"><span>MOJA</span> <span>KOLEJ<span class="mk-dot">.</span></span> <em>2027</em></h1>
        <p class="mk-motto">16 tygodni. 10 osób.<br /><strong>Teraz czas na Ciebie.</strong></p>
        <p class="mk-hero-desc">Indywidualny trening i żywienie, cotygodniowe spotkania na żywo, zamknięta grupa wsparcia, praktyczne zadania i wiedza, dzięki której łatwiej zadbasz o siebie również po zakończeniu programu.</p>
        <a href="#poznaj-program" class="mk-button mk-button-red">Poznaj program <span aria-hidden="true">↗</span></a>
        <p class="mk-hero-status">Pierwsza edycja w przygotowaniu. Bez zapisów i płatności.</p>
      </div>
      <div class="mk-hero-visual">
        <div class="mk-photo-frame">
          <img src="/images/kacper-gym-physique.webp" alt="Kacper Kaszowski, trener prowadzący KK Coaching" width="760" height="940" fetchpriority="high" decoding="async" />
          <div class="mk-photo-caption"><span>KK COACHING</span><strong>PROWADZENIE Z PLANEM.</strong></div>
        </div>
      </div>
    </div>
    <div class="container"><div class="mk-stats" aria-label="Najważniejsze informacje o programie">
      <div><strong>16</strong><span>tygodni</span></div>
      <div><strong>10</strong><span>miejsc w pierwszej edycji</span></div>
      <div><strong>04.01</strong><span>start w 2027 roku</span></div>
    </div></div>
  </section>

  <section class="mk-intro" id="poznaj-program" aria-labelledby="mk-intro-title">
    <div class="container mk-intro-grid">
      <div><span class="mk-kicker">CZAS NA ZMIANĘ</span><h2 id="mk-intro-title">Zawsze jest coś <em>ważniejszego.</em></h2></div>
      <div><p>Praca, rodzina, obowiązki… Zawsze znajdzie się coś, co trzeba zrobić najpierw. A kiedy ostatnio zrobiłeś coś dla siebie?</p><p class="mk-answer">MOJA KOLEJ.</p><p>Przez 16 tygodni pracujemy nad Twoim celem, ale też uczymy się planowania, regularności i podejmowania lepszych decyzji na co dzień. <strong>16 tygodni prowadzenia. Wiedza i nawyki na znacznie dłużej.</strong></p></div>
    </div>
  </section>

  <section class="mk-community" aria-labelledby="mk-community-title">
    <div class="container">
      <div class="mk-section-head"><span class="mk-kicker">NAJWIĘKSZA RÓŻNICA</span><h2 id="mk-community-title">Tym razem <em>nie działasz sam.</em></h2><p>Masz swój indywidualny plan, ale obok Ciebie jest trener i grupa osób, które również postanowiły w końcu znaleźć czas dla siebie.</p></div>
      <div class="mk-feature-grid">
        {features.map((f, index) => (
          <article class:list={['mk-feature', {'mk-whatsapp': index === 0, 'mk-meet': index === 1}]}>
            <div class="mk-feature-top"><span class="mk-symbol" aria-hidden="true">{f.symbol}</span><span class="mk-number">{f.number} / 06</span></div>
            <span class="mk-feature-kicker">{f.kicker}</span>
            <h3>{f.title}</h3><p>{f.body}</p>
            {index === 2 && <div class="mk-check-preview" aria-label="Przykładowe zadania, bez możliwości odznaczania">
              <div><span aria-hidden="true">☑</span> Ułóż listę zakupów</div><div><span aria-hidden="true">☐</span> Porównaj dwie etykiety</div><div><span aria-hidden="true">☐</span> Zaplanuj jeden posiłek</div>
              <small>Przykład, nie panel uczestnika</small>
            </div>}
            <ul>{f.points.map(point => <li>{point}</li>)}</ul>
            {f.note && <p class="mk-feature-note">{f.note}</p>}
          </article>
        ))}
      </div>
      <p class="mk-trademark-note">WhatsApp jest zewnętrzną usługą komunikacyjną. Program nie jest sponsorowany ani organizowany przez WhatsApp.</p>
    </div>
  </section>

  <section class="mk-coaching" aria-labelledby="mk-coaching-title">
    <div class="container mk-coaching-grid">
      <div><span class="mk-kicker">TWÓJ WŁASNY PLAN</span><h2 id="mk-coaching-title">A do tego pełne, <em>indywidualne prowadzenie.</em></h2><p>Każdy uczestnik pracuje nad swoim celem. Nie ma jednej diety ani jednego treningu dla całej grupy.</p>
        <div class="mk-app-note"><strong>MyPTHub</strong><span>Twój plan, zapis treningów i pomiar postępów w jednym miejscu.</span></div>
      </div>
      <div class="mk-coaching-list"><ul>{coaching.map((item,i) => <li><span class="mk-list-num">{String(i+1).padStart(2,'0')}</span><span>{item}</span></li>)}</ul><p>Indywidualne prowadzenie jest częścią standardowej pracy KK Coaching. Tę edycję wyróżniają dodatkowo wspólny harmonogram, mała grupa, zadania, spotkania i warsztaty.</p></div>
    </div>
  </section>

  <section class="mk-roadmap" id="plan-16-tygodni" aria-labelledby="mk-roadmap-title">
    <div class="container">
      <div class="mk-section-head"><span class="mk-kicker">OD PIERWSZEGO DO OSTATNIEGO TYGODNIA</span><h2 id="mk-roadmap-title">16 tygodni. <em>Cztery etapy.</em></h2><p>Jasny kierunek od pierwszego dnia, bez przypadkowych tematów. To plan edukacyjny — indywidualne treningi i żywienie odbywają się równolegle.</p></div>
      <div class="mk-timeline">
        {stages.map((stage, i) => (
          <article class="mk-stage">
            <div class="mk-stage-label"><span>ETAP {stage.number}</span><h3>{stage.name}</h3><p>{stage.range}</p></div>
            <ol start={i*4+1}>{stage.weeks.map((week,j) => <li class:list={{'mk-checkpoint': (i===1&&j===3)||(i===3&&j===3)}}><span class="mk-week">T{String(i*4+j+1).padStart(2,'0')}</span><span>{week}</span></li>)}</ol>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mk-rhythm" aria-labelledby="mk-rhythm-title">
    <div class="container">
      <div class="mk-section-head"><span class="mk-kicker">PRAKTYKA, NIE TEORIA</span><h2 id="mk-rhythm-title">Jak wygląda <em>Twój tydzień?</em></h2><p>Proponowany rytm, który pomaga zorganizować działanie. Dokładne terminy spotkań potwierdzimy przed zapisami.</p></div>
      <div class="mk-rhythm-grid">{rhythm.map(([day,detail],i)=><div class="mk-day"><span class="mk-day-number">{String(i+1).padStart(2,'0')}</span><strong>{day}</strong><p>{detail}</p></div>)}</div>
    </div>
  </section>

  <section class="mk-audience" aria-labelledby="mk-audience-title">
    <div class="container mk-audience-grid">
      <div><span class="mk-kicker">DLA KOGO?</span><h2 id="mk-audience-title">Nie musisz zaczynać z tego samego miejsca co inni.</h2><p>Program dla dorosłych osób o różnych celach. Liczy się dopasowanie do Twojej sytuacji, nie jeden wspólny wynik na wadze.</p></div>
      <div><ul>{audiences.map(item=><li>{item}</li>)}</ul><p class="mk-health-note">Przy szczególnych potrzebach zdrowotnych może być potrzebna dodatkowa ocena i wsparcie odpowiedniego specjalisty przed rozpoczęciem programu.</p></div>
    </div>
  </section>

  <section class="mk-coach" aria-labelledby="mk-coach-title">
    <div class="container mk-coach-grid">
      <div class="mk-coach-image"><img src="/images/kacper-story-dscf1102.webp" alt="Kacper Kaszowski, trener personalny i twórca KK Coaching" width="680" height="720" loading="lazy" decoding="async" /></div>
      <div><span class="mk-kicker">KTO CIĘ POPROWADZI?</span><h2 id="mk-coach-title">Nie uczę czegoś, czego sam nie musiałem się nauczyć.</h2><p>Jestem Kacper Kaszowski i prowadzę KK Coaching. Sam przeszedłem drogę od około 117 kg do 76 kg, a później stopniowo przebudowałem sylwetkę. Wiem, jak łatwo pogubić się w sprzecznych poradach i ciągle zaczynać od nowa.</p><p>Dziś pracuję z podopiecznymi nad treningiem, żywieniem i regularnością. Mam kwalifikacje Level 2 Gym Instructor i Level 3 Personal Trainer. Zależy mi, żebyś nie tylko realizował plan, ale też rozumiał, dlaczego coś robimy.</p><p class="mk-coach-disclaimer">To nowy program. Dotychczasowe doświadczenia i przemiany podopiecznych KK Coaching nie są wynikami tej edycji.</p><a class="mk-text-link" href="/pl/about/">Poznaj moją historię <span aria-hidden="true">↗</span></a><p class="mk-coach-reviews">Chcesz poznać wcześniejsze efekty i opinie podopiecznych? <a href="/pl/transformations/">Zobacz autentyczne historie klientów KK Coaching</a>. To nie są rezultaty programu MOJA KOLEJ 2027.</p></div>
    </div>
  </section>

  <section class="mk-price" aria-labelledby="mk-price-title">
    <div class="container mk-price-grid">
      <div><span class="mk-kicker">CENA ROBOCZA · DO POTWIERDZENIA</span><h2 id="mk-price-title">Jedna edycja.<br /><em>16 tygodni razem.</em></h2><p>Proponowane warunki pierwszej edycji. Pełne zasady konsumenckie, rezygnacji, zwrotów i ewentualnych nagród opublikujemy przed rozpoczęciem zapisów.</p></div>
      <div class="mk-price-card"><span>Planowana cena za całość</span><strong>£450</strong><small>16 tygodni · 10 planowanych miejsc</small>
        <div class="mk-payment-steps"><div><b>£50</b><span>Planowana wpłata wliczona w cenę</span></div><div><b>£175</b><span>Przed pierwszym blokiem</span></div><div><b>£225</b><span>Przed drugim blokiem</span></div></div>
        <p class="mk-price-note">To propozycja, nie oferta płatności ani możliwość rezerwacji. Aktualnie nie przyjmujemy wpłat.</p></div>
    </div>
  </section>

  <section class="mk-signup" id="zgloszenie" aria-labelledby="mk-signup-title">
    <div class="container mk-signup-grid">
      <div><span class="mk-kicker">PIERWSZA EDYCJA</span><h2 id="mk-signup-title">Twoja kolej.<br /><em>Już wkrótce.</em></h2><p>Start programu zaplanowano na 4 stycznia 2027 roku, zakończenie na 25 kwietnia 2027 roku. Na razie oglądasz podgląd — zapisy jeszcze nie ruszyły.</p><div class="mk-signup-state" role="status">Zapisy jeszcze nie ruszyły. Przygotowujemy pierwszą edycję programu.</div></div>
      <div class="mk-form-card"><h3>Formularz zgłoszeniowy</h3><p>Podgląd pól. Formularz jest wyłączony i niczego nie wysyła.</p>
        <form aria-label="Nieaktywny formularz zgłoszeniowy — podgląd" onsubmit="return false">
          <fieldset disabled><legend class="mk-visually-hidden">Przyszły formularz zgłoszeniowy</legend>
            <label>Imię<input type="text" name="firstName" placeholder="Twoje imię" /></label>
            <label>E-mail<input type="email" name="email" placeholder="adres@email.com" /></label>
            <label>Telefon <small>(opcjonalnie)</small><input type="tel" name="phone" placeholder="+44…" /></label>
            <label>Główny cel<select name="goal"><option value="">Wybierz cel</option><option>Redukcja tkanki tłuszczowej</option><option>Budowanie mięśni</option><option>Poprawa siły i sprawności</option><option>Regularność i nawyki</option><option>Inny cel</option></select></label>
            <label>Dlaczego chcesz wziąć udział?<textarea name="reason" rows="3" placeholder="Kilka zdań o Twojej motywacji"></textarea></label>
            <button type="button" disabled>Zapisy jeszcze nie ruszyły</button>
          </fieldset>
        </form><p class="mk-form-foot">Nie zbieramy tutaj żadnych danych. Informacje zdrowotne będą omawiane dopiero w odpowiednim procesie wdrożenia.</p>
      </div>
    </div>
  </section>

  <section class="mk-faq" aria-labelledby="mk-faq-title">
    <div class="container mk-faq-grid"><div><span class="mk-kicker">DOBRZE WIEDZIEĆ</span><h2 id="mk-faq-title">Najczęstsze pytania.</h2><p>Bez niedomówień. Jeśli jakieś zasady nie są jeszcze zatwierdzone, napiszemy o tym wprost.</p></div>
    <div class="mk-faq-items">{faq.map(([question,answer],i)=><details><summary><span class="mk-faq-index">{String(i+1).padStart(2,'0')}</span>{question}<span class="mk-faq-plus" aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></div>
  </section>
  <section class="mk-bottom"><div class="container"><span>KK COACHING · PODGLĄD PROGRAMU</span><h2>MOJA KOLEJ<span>.</span> 2027</h2><p>16 tygodni. 10 osób. Teraz czas na Ciebie.</p><a href="#mk-heading">Wróć na początek ↑</a></div></section>
</BaseLayout>

<style>
.mk-preview {background:#3a171c;color:#fff;text-align:center;font-size:.77rem;font-weight:800;letter-spacing:.08em;padding:11px 16px;position:relative;z-index:2}
.mk-pulse {display:inline-block;width:7px;height:7px;background:#ff8895;border-radius:50%;margin-right:7px}

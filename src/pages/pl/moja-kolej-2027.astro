---
import BaseLayout from '../../layouts/BaseLayout.astro';
import programme from '../../data/moja-kolej-2027.json';

const url = '/pl/moja-kolej-2027/';
const {seo, media, pricing, features, coaching, phases, week, people, faqs, copy} = programme;
const formatPrice = (amount: number) => `£${amount}`;
const formatAnswer = (answer: string) => answer.replace(/\{\{(total|reservation|firstBlock|secondBlock)\}\}/g, (_, field: string) => formatPrice(pricing[field]));
---
<BaseLayout
  lang="pl"
  path={url}
  noindex={true}
  title={seo.title}
  description={seo.description}
  socialImage={seo.socialImage}
  socialImageAlt={seo.socialImageAlt}
>
  <!-- Unpublished programme preview: no checkout, no live sign-up form, no internal promotion. -->
  <svg class="svg-definitions" aria-hidden="true" width="0" height="0" xmlns="http://www.w3.org/2000/svg">
    <symbol id="mk-whatsapp" viewBox="0 0 24 24"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></symbol>
    <symbol id="mk-video" viewBox="0 0 24 24"><rect x="2" y="5" width="14" height="14" rx="3"/><path d="m16 10 6-4v12l-6-4"/></symbol>
    <symbol id="mk-check" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="m8 12 3 3 5-6"/></symbol>
    <symbol id="mk-book" viewBox="0 0 24 24"><path d="M12 6c-3-2-6-2-10-1v14c4-1 7-1 10 1 3-2 6-2 10-1V5c-4-1-7-1-10 1Zm0 0v14"/></symbol>
    <symbol id="mk-chart" viewBox="0 0 24 24"><path d="M3 20h18M5 16l5-5 4 3 5-8"/><path d="M16 6h3v3"/></symbol>
    <symbol id="mk-star" viewBox="0 0 24 24"><path d="m12 2 3.1 6.3 7 .9-5.1 5 .9 7-5.9-3.3-5.9 3.3.9-7-5.1-5 7-.9Z"/></symbol>
  </svg>

  <div class="mk">
    <section class="mk-hero" aria-labelledby="mk-title">
      <div class="container mk-hero-grid">
        <div class="hero-text">
          <p class="mk-eyebrow"><span class="mk-dot"></span> {copy.sections.hero.text001} <span class="preview-tag">{copy.sections.hero.text002}</span></p>
          <h1 id="mk-title"><span>{copy.sections.hero.text003}</span><span>{copy.sections.hero.text004}<span class="period">.</span></span><em>2027</em></h1>
          <p class="hero-slogan">{copy.sections.hero.text005}<br/><strong>{copy.sections.hero.text006}</strong></p>
          <p class="hero-intro">{copy.sections.hero.text007}</p>
          <p class="hero-description">{copy.sections.hero.text008}</p>
          <a class="mk-button" href="#poznaj-program">{copy.sections.hero.text009} <span aria-hidden="true">↓</span></a>
          <p class="hero-note">{copy.sections.hero.text010}</p><p class="hero-note">{copy.sections.hero.text011}</p>
        </div>
        <div class="hero-photo">
          <img src={media.heroImage} width="960" height="1200" fetchpriority="high" alt={copy.attributes.alt001} />
          <div class="photo-shadow" aria-hidden="true"></div>
          <div class="photo-caption"><span>{copy.sections.hero.text012}</span><strong>{copy.sections.hero.text013}</strong></div>
        </div>
      </div>
      <div class="container stats-row" aria-label={copy.attributes.aria_label002}>
        <div><strong>16</strong><span>{copy.sections.hero.text014}</span></div>
        <div><strong>10</strong><span>{copy.sections.hero.text015}</span></div>
        <div><strong>04.01</strong><span>{copy.sections.hero.text016}</span></div>
      </div>
    </section>

    <section class="mk-intro" id="poznaj-program" aria-labelledby="mk-intro-title">
      <div class="container intro-grid">
        <div><p class="mk-label">{copy.sections.intro.text001}</p><h2 id="mk-intro-title">{copy.sections.intro.text002} <span>{copy.sections.intro.text003}</span></h2></div>
        <div><p>{copy.sections.intro.text004}</p><p><strong>{copy.sections.intro.text005}</strong> {copy.sections.intro.text006}</p><blockquote>{copy.sections.intro.text007}<br/>{copy.sections.intro.text008}</blockquote></div>
      </div>
    </section>

    <section class="mk-community" aria-labelledby="mk-community-title">
      <div class="container">
        <div class="mk-section-heading centered">
          <p class="mk-label">{copy.sections.community.text001}</p>
          <h2 id="mk-community-title">{copy.sections.community.text002} <span>{copy.sections.community.text003}</span></h2>
          <p>{copy.sections.community.text004}</p>
        </div>
        <div class="feature-grid">
          {features.map((feature) => {copy.sections.community.text005}
            <article class:list={['feature-card', { 'feature-whatsapp': feature.id === 'grupa', 'feature-live': feature.id === 'spotkania' }]}>
              <div class="feature-top">
                <span class="feature-icon"><svg class:list={{ 'brand-whatsapp': feature.icon === 'whatsapp' }} aria-hidden="true" viewBox="0 0 24 24"><use href={'#mk-' + feature.icon} /></svg></span>
                <span class="feature-index">{feature.eyebrow}</span>
              </div>
              <h3>{feature.title}</h3>
              <p>{feature.detail}</p>
              {feature.id === 'zadania' ? (
                <div class="mock-task" aria-label={copy.attributes.aria_label003}>
                  <span class="task-title">{copy.sections.community.text006}</span>
                  <span><span aria-hidden="true" class="fake-check checked">✓</span> {copy.sections.community.text007}</span>
                  <span><span aria-hidden="true" class="fake-check"></span> {copy.sections.community.text008}</span>
                  <span><span aria-hidden="true" class="fake-check"></span> {copy.sections.community.text009}</span>
                </div>
              {copy.sections.community.text010}
                <div class="milestone-mini"><div><b>08</b><span>{copy.sections.community.text011}</span></div><div><b>16</b><span>{copy.sections.community.text012}</span></div></div>
              {copy.sections.community.text013} <ul>{feature.items.map(item => <li>{item}</li>{copy.sections.community.text014}</ul>}
              {feature.id === 'grupa' && <p class="small-caution">{copy.sections.community.text015}</p>}
              {feature.id === 'wyroznienia' && <p class="small-caution">{copy.sections.community.text016}</p>{copy.sections.community.text017}
            </article>
          {copy.sections.community.text018}
        </div>
      </div>
    </section>

    <section class="mk-coaching" aria-labelledby="mk-coaching-title">
      <div class="container coaching-grid">
        <div class="coaching-lead">
          <p class="mk-label">{copy.sections.coaching.text001}</p>
          <h2 id="mk-coaching-title">{copy.sections.coaching.text002} <span>{copy.sections.coaching.text003}</span></h2>
          <p>{copy.sections.coaching.text004}</p>
          <div class="app-preview" aria-label={copy.attributes.aria_label004}>
            <div class="app-header"><span class="app-mark">{copy.sections.coaching.text005}</span><span>{copy.sections.coaching.text006}</span><span class="app-status">{copy.sections.coaching.text007}</span></div>
            <div class="app-chart" aria-hidden="true"><span style="height:38%"></span><span style="height:52%"></span><span style="height:48%"></span><span style="height:68%"></span><span style="height:62%"></span><span style="height:83%"></span><span style="height:93%"></span></div>
            <div class="app-footer"><span>{copy.sections.coaching.text008}</span><strong>{copy.sections.coaching.text009}</strong><span>{copy.sections.coaching.text010}</span></div>
          </div>
        </div>
        <div class="coaching-list">
          {coaching.map((item, index) => <div class="coaching-point"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{item}</p><b aria-hidden="true">✓</b></div>{copy.sections.coaching.text011}
          <p class="coaching-footnote">{copy.sections.coaching.text012}</p>
        </div>
      </div>
    </section>

    <section class="mk-roadmap" id="program-16-tygodni" aria-labelledby="mk-roadmap-title">
      <div class="container">
        <div class="mk-section-heading">
          <p class="mk-label">{copy.sections.roadmap.text001}</p>
          <h2 id="mk-roadmap-title">{copy.sections.roadmap.text002}<br/><span>{copy.sections.roadmap.text003}</span></h2>
          <p>{copy.sections.roadmap.text004}</p>
        </div>
        <div class="phase-grid">
          {phases.map((phase, phaseIndex) => {copy.sections.roadmap.text005}
            <article class="phase">
              <div class="phase-head"><span class="phase-n">{phase.number}</span><div><span class="phase-range">{phase.range}</span><h3>{phase.title}</h3></div></div>
              <ol start={phaseIndex * 4 + 1}>
                {phase.weeks.map((entry, weekIndex) => {copy.sections.roadmap.text006}
                  <li><span class="week-index">{String(phaseIndex * 4 + weekIndex + 1).padStart(2, '0')}</span><span>{entry}</span></li>
                {copy.sections.roadmap.text007}
              </ol>
            </article>
          {copy.sections.roadmap.text008}
        </div>
        <div class="timeline-end"><strong>{copy.sections.roadmap.text009}</strong><span aria-hidden="true"></span><strong>{copy.sections.roadmap.text010}</strong></div>
      </div>
    </section>

    <section class="mk-rhythm" aria-labelledby="mk-week-title">
      <div class="container">
        <div class="mk-section-heading centered"><p class="mk-label">{copy.sections.rhythm.text001}</p><h2 id="mk-week-title">{copy.sections.rhythm.text002} <span>{copy.sections.rhythm.text003}</span></h2><p>{copy.sections.rhythm.text004}</p></div>
        <div class="week-grid">
          {week.map((entry, index) => {copy.sections.rhythm.text005}
            <div class:list={['day-card', { 'day-live': index === 6 }]}>
              <span class="day-name">{entry.day}</span><div class="day-dot" aria-hidden="true"></div><h3>{entry.title}</h3><p>{entry.body}</p>
            </div>
          {copy.sections.rhythm.text006}
        </div>
      </div>
    </section>

    <section class="mk-fit" aria-labelledby="mk-fit-title">
      <div class="container fit-grid">
        <div><p class="mk-label">{copy.sections.fit.text001}</p><h2 id="mk-fit-title">{copy.sections.fit.text002} <span>{copy.sections.fit.text003}</span></h2><p>{copy.sections.fit.text004}</p><p class="fit-note">{copy.sections.fit.text005}</p></div>
        <ul class="fit-list">{people.map((item, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{item}</li>{copy.sections.fit.text006}</ul>
      </div>
    </section>

    <section class="mk-coach" aria-labelledby="mk-coach-title">
      <div class="container coach-grid">
        <div class="coach-photo"><img src={media.coachImage} width="760" height="900" loading="lazy" alt={copy.attributes.alt005} /><span>{copy.sections.coach.text001}</span></div>
        <div><p class="mk-label">{copy.sections.coach.text002}</p><h2 id="mk-coach-title">{copy.sections.coach.text003} <span>{copy.sections.coach.text004}</span></h2><p>{copy.sections.coach.text005}</p><p>{copy.sections.coach.text006}</p><div class="coach-credential"><strong>{copy.sections.coach.text007}</strong><span>{copy.sections.coach.text008}</span></div><p class="coach-quiet">{copy.sections.coach.text009}</p></div>
      </div>
    </section>

    <section class="mk-price" aria-labelledby="mk-price-title">
      <div class="container price-grid">
        <div><p class="mk-label">{copy.sections.price.text001}</p><h2 id="mk-price-title">{copy.sections.price.text002} <span>{copy.sections.price.text003}</span></h2><p>{copy.sections.price.text004}</p><p class="price-alert">{copy.sections.price.text005}</p></div>
        <div class="price-panel">
          <p>{copy.sections.price.text006}</p><div class="price-amount">{formatPrice(pricing.total)} <span>{copy.sections.price.text007}</span></div>
          <div class="price-lines"><div><span>{copy.sections.price.text008}<br/><small>{copy.sections.price.text009}</small></span><strong>{formatPrice(pricing.reservation)}</strong></div><div><span>{copy.sections.price.text010}</span><strong>{formatPrice(pricing.firstBlock)}</strong></div><div><span>{copy.sections.price.text011}</span><strong>{formatPrice(pricing.secondBlock)}</strong></div></div>
          <span class="price-final">{copy.sections.price.text012}</span>
        </div>
      </div>
    </section>

    <section class="mk-apply" id="zapisy" aria-labelledby="mk-apply-title">
      <div class="container apply-grid">
        <div><p class="mk-label">{copy.sections.application.text001}</p><h2 id="mk-apply-title">{copy.sections.application.text002} <span>{copy.sections.application.text003}</span></h2><p>{copy.sections.application.text004}</p><p class="apply-status" role="status"><span aria-hidden="true">●</span> {copy.sections.application.text005}</p></div>
        <div class="apply-form-preview" aria-label={copy.attributes.aria_label006}>
          <div class="form-top"><span>{copy.sections.application.text006}</span><b>{copy.sections.application.text007}</b></div>
          <fieldset disabled>
            <label>{copy.sections.application.text008} <input type="text" placeholder={copy.attributes.placeholder007} autocomplete="off" /></label>
            <label>{copy.sections.application.text009} <input type="email" placeholder={copy.attributes.placeholder008} autocomplete="off" /></label>
            <label>{copy.sections.application.text010} <span class="optional">{copy.sections.application.text011}</span><input type="tel" placeholder={copy.attributes.placeholder009} autocomplete="off" /></label>
            <label>{copy.sections.application.text012}<select><option>{copy.sections.application.text013}</option><option>{copy.sections.application.text014}</option><option>{copy.sections.application.text015}</option><option>{copy.sections.application.text016}</option><option>{copy.sections.application.text017}</option></select></label>
            <label>{copy.sections.application.text018}<textarea rows="3" placeholder={copy.attributes.placeholder010} autocomplete="off"></textarea></label>
            <button type="button" disabled aria-disabled="true">{copy.sections.application.text019}</button>
          </fieldset>
          <p class="form-help">{copy.sections.application.text020}</p>
        </div>
      </div>
    </section>

    <section class="mk-faq" aria-labelledby="mk-faq-title">
      <div class="container faq-container"><div class="mk-section-heading centered"><p class="mk-label">{copy.sections.faq.text001}</p><h2 id="mk-faq-title">{copy.sections.faq.text002} <span>{copy.sections.faq.text003}</span></h2><p>{copy.sections.faq.text004}</p></div>
        <div class="faq-list">{faqs.map(({question, answer}) => <details><summary>{question}<span aria-hidden="true">+</span></summary><div class="faq-answer"><p>{formatAnswer(answer)}</p></div></details>{copy.sections.faq.text005}</div>
      </div>
    </section>

    <section class="mk-outro" aria-labelledby="mk-outro-title"><div class="container"><p class="mk-label">{copy.sections.final.text001}</p><h2 id="mk-outro-title">{copy.sections.final.text002}<br/><span>{copy.sections.final.text003}</span></h2><p>{copy.sections.final.text004}</p><a class="mk-button outline" href="#poznaj-program">{copy.sections.final.text005}</a><small>{copy.sections.final.text006}</small></div></section>
  </div>
</BaseLayout>

<style>
  .svg-definitions { position:absolute;width:0;height:0;overflow:hidden; }
  .mk { --mk-ink:#17191d;--mk-red:#a51f2e;--mk-muted:#626872;--mk-paper:#f5f5f3;color:var(--mk-ink);background:var(--mk-paper);overflow:clip; }
  .mk section { padding-block:clamp(72px,9vw,126px); }
  .mk .container { max-width:1190px; }
  .mk h1,.mk h2,.mk h3 { letter-spacing:-.045em;line-height:1.08; }
  .mk h2 { font-size:clamp(2.15rem,5vw,4.2rem);font-weight:850; }
  .mk h2 span { color:var(--mk-red); }
  .mk p { line-height:1.68; }
  .mk-label { font-size:.74rem;font-weight:850;letter-spacing:.18em;color:var(--mk-red);text-transform:uppercase;margin:0 0 24px; }
  .mk-section-heading { max-width:740px;margin-bottom:46px; }
  .mk-section-heading.centered { margin-left:auto;margin-right:auto;text-align:center; }
  .mk-section-heading>p:last-child {font-size:1.06rem;color:var(--mk-muted);margin-top:22px;}
  .mk-hero { background:radial-gradient(circle at 80% 15%,#35373c 0%,#17191d 58%,#101114 100%);color:#fff;position:relative;padding-top:74px!important;padding-bottom:32px!important; }
  .mk-hero:before {content:"";position:absolute;inset:0;background:linear-gradient(110deg,transparent 40%,rgba(165,31,46,.13));pointer-events:none;}
  .mk-hero-grid { display:grid;grid-template-columns:minmax(0,1.22fr) minmax(0,.78fr);gap:clamp(24px,4vw,66px);align-items:center;position:relative;z-index:1;}
  .hero-text {padding-bottom:18px;}
  .mk-eyebrow {display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-weight:850;letter-spacing:.17em;font-size:.68rem;color:#ffdee1;margin-bottom:32px;}
  .mk-dot {width:9px;height:9px;border-radius:100%;background:#d5394a;box-shadow:0 0 0 5px rgba(213,57,74,.16);}
  .preview-tag {font-size:.61rem;border:1px solid #805761;border-radius:99px;padding:6px 9px;color:#fff;letter-spacing:.1em;}
  .mk-hero h1 {font-weight:950;font-size:clamp(4.6rem,9vw,8.7rem);line-height:.81;letter-spacing:-.087em;margin-bottom:33px;overflow-wrap:normal;}
  .mk-hero h1>span {display:block;}
  .mk-hero h1 .period {color:#d83146;}
  .mk-hero h1 em {display:block;color:transparent;-webkit-text-stroke:2px #d83146;font-style:normal;font-size:.7em;letter-spacing:-.045em;line-height:1.05;margin-top:7px;}
  .hero-slogan {font-size:clamp(1.28rem,2.8vw,1.85rem);line-height:1.3!important;font-weight:750;margin-bottom:24px;}
  .hero-slogan strong {color:#ffb5bf;}
  .hero-intro {font-size:clamp(1.06rem,1.75vw,1.22rem);max-width:49ch;font-weight:650;margin-bottom:14px;}
  .hero-description {font-size:.94rem;color:#d2d5d9;max-width:57ch;margin-bottom:31px;}
  .mk-button {display:inline-flex;justify-content:space-between;align-items:center;gap:36px;min-height:54px;background:var(--mk-red);color:white;text-decoration:none;font-weight:800;padding:15px 23px;border:2px solid var(--mk-red);border-radius:3px;transition:background .15s ease,transform .15s ease;}
  .mk-button:hover {background:#851726;border-color:#851726;transform:translateY(-2px);}
  .mk a:focus-visible,.mk summary:focus-visible {outline:3px solid #f5a1af;outline-offset:5px;}
  .hero-note {font-size:.77rem;color:#b8bdc4;margin-top:16px;}
  .hero-photo {position:relative;min-height:500px;aspect-ratio:4/5;max-height:620px;overflow:hidden;isolation:isolate;border:1px solid #45474b;background:#26282d;}
  .hero-photo img {width:100%;height:100%;object-fit:cover;object-position:center top;filter:grayscale(25%) contrast(1.08);max-height:none;}
  .photo-shadow {position:absolute;inset:40% 0 0;background:linear-gradient(transparent,rgba(10,10,12,.9));z-index:1;pointer-events:none;}
  .photo-caption {position:absolute;bottom:26px;left:25px;right:25px;z-index:2;display:flex;justify-content:space-between;align-items:end;border-top:1px solid rgba(255,255,255,.35);padding-top:14px;gap:12px;}
  .photo-caption span {font-size:.7rem;letter-spacing:.2em;}
  .photo-caption strong {font-size:clamp(1rem,2.4vw,1.6rem);letter-spacing:-.04em;}
  .stats-row {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;margin-top:36px!important;background:#414349;border:1px solid #414349;padding:0!important;position:relative;z-index:2;}
  .stats-row>div {background:#202227;display:flex;align-items:center;gap:18px;padding:19px 26px;}
  .stats-row strong {font-weight:900;font-size:clamp(2rem,3vw,3rem);letter-spacing:-.07em;color:#fff;line-height:1;}
  .stats-row span {font-size:.74rem;line-height:1.3;color:#ccd1d6;text-transform:uppercase;letter-spacing:.06em;}
  .intro-grid {display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(30px,7vw,110px);}
  .mk-intro {background:#fff;}
  .mk-intro h2 {max-width:11ch;}
  .intro-grid>div:last-child>p {font-size:1.06rem;color:#444950;margin-bottom:18px;}
  .intro-grid blockquote {border-left:4px solid var(--mk-red);padding:10px 0 10px 22px;font-size:clamp(1.25rem,2vw,1.65rem);font-weight:800;line-height:1.4;margin-top:28px;}
  .mk-community {background:#17191d;color:#fff;}
  .mk-community .mk-label,.mk-coach .mk-label,.mk-price .mk-label,.mk-outro .mk-label {color:#ffaeba;}
  .mk-community h2 span,.mk-coach h2 span,.mk-price h2 span,.mk-outro h2 span {color:#ff8fa1;}
  .mk-community .mk-section-heading>p:last-child {color:#c3c6cc;}
  .feature-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;}
  .feature-card {background:#25282e;border:1px solid #3d4148;border-top:3px solid #9d3342;padding:clamp(22px,2.5vw,30px);display:flex;flex-direction:column;min-height:390px;position:relative;}
  .feature-card.feature-whatsapp {border-top-color:#25d366;background:linear-gradient(155deg,#24372e,#25282e 52%);}
  .feature-card.feature-live {border-top-color:#f77789;}
  .feature-top {display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:26px;}
  .feature-icon {width:54px;height:54px;display:grid;place-items:center;border:1px solid #54565b;border-radius:50%;color:#ff9caa;}
  .feature-whatsapp .feature-icon {color:#25d366;border-color:#417b58;}

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactMethods from '../../components/ContactMethods.astro';
import pages from '../../data/pages-v2.json';
import admin from '../../data/admin-v2.json';

const lang = 'pl';
const copy = pages.contact;
const formCopy = copy.form;
const languageOptions = [...formCopy.languageOptions].reverse();
---
<BaseLayout title={copy.seo.title[lang]} description={copy.seo.description[lang]} lang="pl" path="/pl/contact" altPath="/contact">
  <section class="page-hero on-dark">
    <div class="container">
      <span class="eyebrow">{copy.hero.eyebrow[lang]}</span>
      <h1>{copy.hero.heading[lang]}</h1>
      <p class="lead">{copy.hero.body[lang]}</p>
    </div>
  </section>

  <section class="on-white">
    <div class="container contact-grid">
      <form id="contact-form" data-track-as="contact_enquiry" data-sending={formCopy.sending[lang]} data-error={formCopy.error[lang]} data-thank-you="/pl/thank-you" data-lead-language="pl" novalidate>
        <div class="field"><label for="name">{formCopy.name[lang]} <span aria-hidden="true">*</span></label><input type="text" id="name" name="name" required autocomplete="name" /></div>
        <div class="field"><label for="email">{formCopy.email[lang]} <span aria-hidden="true">*</span></label><input type="email" id="email" name="email" required autocomplete="email" /></div>
        <div class="field"><label for="phone">{formCopy.phone[lang]} <span aria-hidden="true">*</span></label><input type="tel" id="phone" name="phone" required autocomplete="tel" /></div>
        <div class="field"><label for="location">{formCopy.location[lang]}</label><input type="text" id="location" name="location" placeholder={formCopy.locationPlaceholder[lang]} /></div>
        <div class="field">
          <label for="language">{formCopy.language[lang]}</label>
          <select id="language" name="language">{languageOptions.map(option => <option value={option.value}>{option.label[lang]}</option>)}</select>
        </div>
        <div class="field">
          <label for="interest">{formCopy.interest[lang]}</label>
          <select id="interest" name="interest">{formCopy.interestOptions.map(option => <option>{option[lang]}</option>)}</select>
        </div>
        <div class="field"><label for="goal">{formCopy.goal[lang]} <span aria-hidden="true">*</span></label><textarea id="goal" name="goal" rows="3" required placeholder={formCopy.goalPlaceholder[lang]}></textarea></div>
        <div class="field"><label for="blocker">{formCopy.blocker[lang]}</label><textarea id="blocker" name="blocker" rows="3" placeholder={formCopy.blockerPlaceholder[lang]}></textarea></div>
        <div class="field honeypot" aria-hidden="true"><label for="company">Firma</label><input type="text" id="company" name="company" tabindex="-1" autocomplete="off" /></div>
        <div class="field checkbox-field">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">{formCopy.consentBefore[lang]} <a href={formCopy.privacyHref[lang]}>{formCopy.privacyLabel[lang]}</a>. <span aria-hidden="true">*</span></label>
        </div>
        <button type="submit" class="btn btn-primary">{formCopy.submit[lang]}</button>
        <p class="form-note">{formCopy.note[lang]}</p>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <ContactMethods lang="pl" whatsappNumber={admin.contact.whatsapp} contactEmail={admin.contact.email} instagramUrl={admin.contact.instagramUrl} facebookUrl={admin.contact.facebookUrl} />
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const formData = new FormData(form);
    const thankYou = form.dataset.thankYou || '/pl/thank-you';
    if (formData.get('company')) { window.location.href = thankYou; return; }
    status.textContent = form.dataset.sending || 'Wysyłanie...';
    try {
      const res = await fetch('/.netlify/functions/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(formData)) });
      if (!res.ok) throw new Error('Request failed');
      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') gtag('event', 'generate_lead', { form_name: 'contact_enquiry', lead_language: form.dataset.leadLanguage || 'pl', interest: String(formData.get('interest') ?? '') });
      window.location.href = thankYou;
    } catch (err) {
      status.textContent = form.dataset.error || 'Coś poszło nie tak podczas wysyłania.';
    }
  });
</script>

<style>
  .page-hero { padding: 64px 0; }
  .page-hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 14px; }
  .page-hero .lead { color: #C7CBD1; max-width: 64ch; }
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; gap: 34px; } }
  .field { margin-bottom: 18px; }
  .field label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.92rem; }
  .field input, .field select, .field textarea { width: 100%; border: 1px solid #D8DBDE; border-radius: var(--radius); padding: 12px 14px; font-size: 1rem; font-family: inherit; background: var(--white); }
  .field textarea { resize: vertical; }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .checkbox-field { display: flex; align-items: flex-start; gap: 10px; }
  .checkbox-field input { width: auto; margin-top: 4px; }
  .checkbox-field label { font-weight: 400; font-size: 0.88rem; color: var(--steel); }
  .checkbox-field a { color: var(--red); }
  .form-note { margin-top: 12px; font-size: 0.85rem; color: var(--steel); }
  .form-status { margin-top: 8px; font-size: 0.9rem; color: var(--steel); }
  @media (max-width: 620px) { .page-hero { padding: 48px 0; } form > .btn { width: 100%; } }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactMethods from '../../components/ContactMethods.astro';
import site from '../../data/site.pl.json';
---
<BaseLayout
  title="Bezpłatna konsultacja | KK Coaching Cwmbran"
  description="Napisz do KK Coaching w sprawie treningu personalnego 1:1 w Cwmbran, coachingu online, coachingu hybrydowego lub indywidualnego planu treningowego."
  lang="pl"
  path="/pl/contact"
  altPath="/contact"
>
  <section class="page-hero on-dark">
    <div class="container">
      <span class="eyebrow">Zacznijmy od rozmowy</span>
      <h1>Umów bezpłatną konsultację</h1>
      <p class="lead">Opisz krótko swój cel i to, z czym masz teraz największy problem. Odpowiem, zadam kilka konkretnych pytań i podpowiem, która forma współpracy ma w Twojej sytuacji najwięcej sensu.</p>
    </div>
  </section>

  <section class="on-white">
    <div class="container contact-grid">
      <form id="contact-form" data-track-as="contact_enquiry" novalidate>
        <div class="field">
          <label for="name">Imię <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">E-mail <span aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="phone">Telefon / WhatsApp <span aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel" />
        </div>
        <div class="field">
          <label for="location">Gdzie mieszkasz?</label>
          <input type="text" id="location" name="location" placeholder="np. Cwmbran, Cardiff, Londyn albo poza UK" />
        </div>
        <div class="field">
          <label for="language">Preferowany język</label>
          <select id="language" name="language">
            <option value="Polish">Polski</option>
            <option value="English">English</option>
          </select>
        </div>
        <div class="field">
          <label for="interest">Jaka forma współpracy Cię interesuje?</label>
          <select id="interest" name="interest">
            <option>Trening personalny 1:1 w Cwmbran</option>
            <option>Coaching online</option>
            <option>Coaching hybrydowy</option>
            <option>Indywidualny plan treningowy</option>
            <option>Jeszcze nie wiem</option>
          </select>
        </div>
        <div class="field">
          <label for="goal">Jaki jest Twój główny cel? <span aria-hidden="true">*</span></label>
          <textarea id="goal" name="goal" rows="3" required placeholder="np. redukcja, budowanie mięśni, powrót do regularnych treningów..."></textarea>
        </div>
        <div class="field">
          <label for="blocker">Co najbardziej utrudnia Ci osiągnięcie tego celu?</label>
          <textarea id="blocker" name="blocker" rows="3" placeholder="np. brak regularności, problem z dietą, brak planu, mało czasu..."></textarea>
        </div>

        <div class="field honeypot" aria-hidden="true">
          <label for="company">Firma</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field checkbox-field">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">
            Zgadzam się na kontakt w sprawie mojego zapytania i zapoznałem/am się z <a href="/pl/privacy">Polityką prywatności</a>. <span aria-hidden="true">*</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Wyślij zgłoszenie</button>
        <p class="form-note">Zwykle odpowiadam w ciągu 24 godzin. Jeśli wolisz, możesz też od razu napisać do mnie na WhatsApp.</p>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <ContactMethods
        lang="pl"
        whatsappNumber={site.meta.whatsappNumber}
        contactEmail={site.meta.contactEmail}
        instagramUrl={site.meta.instagramUrl}
      />
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const formData = new FormData(form);
    if (formData.get('company')) {
      window.location.href = '/pl/thank-you';
      return;
    }

    status.textContent = 'Wysyłanie...';

    try {
      const res = await fetch('/.netlify/functions/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData))
      });

      if (!res.ok) throw new Error('Request failed');

      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          form_name: 'contact_enquiry',
          lead_language: 'pl',
          interest: String(formData.get('interest') ?? '')
        });
      }

      window.location.href = '/pl/thank-you';
    } catch (err) {
      status.textContent = 'Coś poszło nie tak podczas wysyłania. Spróbuj przez WhatsApp lub e-mail.';
    }
  });
</script>

<style>
  .page-hero { padding: 64px 0; }
  .page-hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 14px; }
  .page-hero .lead { color: #C7CBD1; max-width: 64ch; }
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; gap: 34px; } }
  .field { margin-bottom: 18px; }
  .field label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.92rem; }
  .field input, .field select, .field textarea {
    width: 100%; border: 1px solid #D8DBDE; border-radius: var(--radius);
    padding: 12px 14px; font-size: 1rem; font-family: inherit; background: var(--white);
  }
  .field textarea { resize: vertical; }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .checkbox-field { display: flex; align-items: flex-start; gap: 10px; }
  .checkbox-field input { width: auto; margin-top: 4px; }
  .checkbox-field label { font-weight: 400; font-size: 0.88rem; color: var(--steel); }
  .checkbox-field a { color: var(--red); }
  .form-note { margin-top: 12px; font-size: 0.85rem; color: var(--steel); }
  .form-status { margin-top: 8px; font-size: 0.9rem; color: var(--steel); }

  @media (max-width: 620px) {
    .page-hero { padding: 48px 0; }
    form > .btn { width: 100%; }
  }
</style>

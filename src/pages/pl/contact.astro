---
import BaseLayout from '../../layouts/BaseLayout.astro';
import site from '../../data/site.pl.json';
---
<BaseLayout
  title="Bezpłatna Konsultacja Personal Training Cwmbran | KK Coaching"
  description="Umów bezpłatną konsultację z KK Coaching w sprawie treningu personalnego w Cwmbran, coachingu online lub prowadzenia hybrydowego. Opisz swój cel i zobaczmy, jak mogę Ci pomóc."
  lang="pl"
  path="/pl/contact"
  altPath="/contact"
>
  <section class="page-hero on-dark">
    <div class="container">
      <span class="eyebrow">Zacznij tutaj</span>
      <h1>Umów bezpłatną konsultację</h1>
      <p class="lead">Napisz, gdzie jesteś teraz, jaki efekt chcesz osiągnąć i co do tej pory najbardziej Ci przeszkadzało. Bez presji i bez sprzedażowego skryptu - sprawdzimy po prostu, czy mogę Ci pomóc i jaka forma współpracy będzie najlepsza.</p>
    </div>
  </section>

  <section class="on-white">
    <div class="container contact-grid">
      <form id="contact-form" data-track-as="contact_enquiry" novalidate>
        <div class="field">
          <label for="name">Imię <span aria-hidden="true">*</span></label>
          <input type="text" id="name" name="name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email <span aria-hidden="true">*</span></label>
          <input type="email" id="email" name="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="phone">Telefon / WhatsApp <span aria-hidden="true">*</span></label>
          <input type="tel" id="phone" name="phone" required autocomplete="tel" />
        </div>
        <div class="field">
          <label for="location">Lokalizacja</label>
          <input type="text" id="location" name="location" placeholder="np. Cwmbran, Cardiff albo online" />
        </div>
        <div class="field">
          <label for="language">Preferowany język</label>
          <select id="language" name="language">
            <option value="Polish">Polski</option>
            <option value="English">English</option>
          </select>
        </div>
        <div class="field">
          <label for="interest">Interesuje mnie</label>
          <select id="interest" name="interest">
            <option>Trening personalny</option>
            <option>Coaching online</option>
            <option>Coaching hybrydowy</option>
            <option>Plan treningowy</option>
            <option>Jeszcze nie wiem</option>
          </select>
        </div>
        <div class="field">
          <label for="goal">Co chcesz osiągnąć? <span aria-hidden="true">*</span></label>
          <textarea id="goal" name="goal" rows="3" required placeholder="Redukcja, budowanie mięśni, siła, większa pewność siebie na siłowni..."></textarea>
        </div>
        <div class="field">
          <label for="blocker">Co obecnie najbardziej Ci przeszkadza?</label>
          <textarea id="blocker" name="blocker" rows="3" placeholder="Brak czasu, regularności, dieta, brak konkretnego planu, wcześniejsze urazy..."></textarea>
        </div>

        <div class="field honeypot" aria-hidden="true">
          <label for="company">Firma</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field checkbox-field">
          <input type="checkbox" id="consent" name="consent" required />
          <label for="consent">
            Zgadzam się na kontakt i zapoznałem/am się z <a href="/pl/privacy">Polityką prywatności</a>. <span aria-hidden="true">*</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Wyślij zgłoszenie</button>
        <p class="form-note">Bez presji i bez sprzedażowego skryptu. Zwykle odpowiadam w ciągu 24 godzin.</p>
        <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
      </form>

      <aside class="contact-side">
        <h2>Wolisz napisać bezpośrednio?</h2>
        <p>Wybierz najwygodniejszą opcję. Najszybciej zwykle odpowiadam na WhatsApp.</p>
        <ul class="contact-list">
          <li>
            <a href={`https://wa.me/${site.meta.whatsappNumber.replace(/\D/g, '')}`} target="_blank" rel="noopener">
              WhatsApp
            </a>
          </li>
          <li><a href={`mailto:${site.meta.contactEmail}`}>{site.meta.contactEmail}</a></li>
          <li><a href={site.meta.instagramUrl} target="_blank" rel="noopener">Instagram</a></li>
          {site.meta.facebookUrl && <li><a href={site.meta.facebookUrl} target="_blank" rel="noopener">Facebook</a></li>}
        </ul>
        <p class="response-time">Orientacyjny czas odpowiedzi: do 24 godzin.</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status) return;

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const formData = new FormData(form);
    if (formData.get('company')) {
      window.location.href = '/pl/thank-you';
      return;
    }

    status.textContent = 'Wysyłanie...';

    try {
      const res = await fetch('/.netlify/functions/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData))
      });

      if (!res.ok) throw new Error('Request failed');

      const gtag = (window as any).gtag;
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', {
          form_name: 'contact_enquiry',
          lead_language: 'pl',
          interest: String(formData.get('interest') ?? '')
        });
      }

      window.location.href = '/pl/thank-you';
    } catch (err) {
      status.textContent = 'Coś poszło nie tak podczas wysyłania. Spróbuj przez WhatsApp lub e-mail.';
    }
  });
</script>

<style>
  .page-hero { padding: 64px 0; }
  .page-hero h1 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); margin: 12px 0 14px; }
  .page-hero .lead { color: #C7CBD1; max-width: 64ch; }
  .contact-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 56px; align-items: start; }
  @media (max-width: 860px) { .contact-grid { grid-template-columns: 1fr; } }
  .field { margin-bottom: 18px; }
  .field label { display: block; font-weight: 600; margin-bottom: 6px; font-size: 0.92rem; }
  .field input, .field select, .field textarea {
    width: 100%; border: 1px solid #D8DBDE; border-radius: var(--radius);
    padding: 12px 14px; font-size: 1rem; font-family: inherit; background: var(--white);
  }
  .field textarea { resize: vertical; }
  .honeypot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .checkbox-field { display: flex; align-items: flex-start; gap: 10px; }
  .checkbox-field input { width: auto; margin-top: 4px; }
  .checkbox-field label { font-weight: 400; font-size: 0.88rem; color: var(--steel); }
  .checkbox-field a { color: var(--red); }
  .form-note { margin-top: 12px; font-size: 0.85rem; color: var(--steel); }
  .form-status { margin-top: 8px; font-size: 0.9rem; color: var(--steel); }
  .contact-side { background: var(--white); border: 1px solid #E3E5E8; border-radius: var(--radius); padding: 28px; }
  .contact-side h2 { font-size: 1.2rem; margin-bottom: 8px; }
  .contact-side > p { color: var(--steel); font-size: 0.92rem; margin-bottom: 18px; }
  .contact-list { list-style: none; }
  .contact-list li { margin-bottom: 12px; }
  .contact-list a { color: var(--red); text-decoration: none; font-weight: 600; }
  .contact-list a:hover { text-decoration: underline; }
  .response-time { margin-top: 18px; font-size: 0.85rem; color: var(--steel); }
</style>

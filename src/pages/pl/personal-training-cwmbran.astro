---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrainingLocation from '../../components/TrainingLocation.astro';
import details from '../../data/service-details-v2.json';
import admin from '../../data/admin-v2.json';

const lang = 'pl';
const copy = details.personalTraining;
const faqs = copy.faq.items.map(item => ({ q: item.q[lang], a: item.a[lang] }));
const trustPoints = copy.hero.trustPoints.map(item => item[lang]).filter(Boolean);
const location = admin.location;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://kkcoaching.fit/pl/personal-training-cwmbran#service',
      name: copy.hero.heading[lang],
      serviceType: 'Personal Training',
      description: copy.seo.description[lang],
      url: 'https://kkcoaching.fit/pl/personal-training-cwmbran',
      areaServed: { '@type': 'AdministrativeArea', name: `${location.city}, Torfaen, South Wales` },
      provider: { '@type': 'Organization', '@id': 'https://kkcoaching.fit/#business', name: admin.brand.siteName, url: 'https://kkcoaching.fit' },
      availableChannel: {
        '@type': 'ServiceChannel',
        serviceLocation: {
          '@type': 'Place',
          '@id': 'https://kkcoaching.fit/#jd-gyms-cwmbran-training-location',
          name: location.venueName,
          address: { '@type': 'PostalAddress', streetAddress: location.addressLine1, addressLocality: location.city, postalCode: location.postcode, addressCountry: location.country }
        }
      }
    },
    { '@type': 'FAQPage', mainEntity: faqs.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) }
  ]
};
---
<BaseLayout title={copy.seo.title[lang]} description={copy.seo.description[lang]} lang="pl" path="/pl/personal-training-cwmbran" altPath="/personal-training-cwmbran" structuredData={structuredData}>
  <section class="local-hero on-dark">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{copy.hero.eyebrow[lang]}</span>
        <h1>{copy.hero.heading[lang]}</h1>
        <p class="lead">{copy.hero.lead[lang]}</p>
        <div class="hero-actions"><a href={copy.hero.primaryHref[lang]} class="btn btn-primary">{copy.hero.primaryCta[lang]}</a><a href={copy.hero.secondaryHref[lang]} class="btn btn-secondary">{copy.hero.secondaryCta[lang]}</a></div>
        <div class="trust-row" aria-label={copy.hero.trustAria[lang]}>{trustPoints.map(item => <span>{item}</span>)}</div>
      </div>
      <div class="hero-media"><img src={copy.hero.fallbackImage} alt={copy.hero.imageAlt[lang]} width="720" height="540" /></div>
    </div>
  </section>

  <section class="on-white" aria-labelledby="fit-heading"><div class="container"><div class="section-head"><span class="eyebrow">{copy.fit.eyebrow[lang]}</span><h2 id="fit-heading">{copy.fit.heading[lang]}</h2><p>{copy.fit.body[lang]}</p></div><div class="three-grid">{copy.fit.cards.map(item => <article class="info-card"><h3>{item.title[lang]}</h3><p>{item.body[lang]}</p></article>)}</div></div></section>

  <section class="on-dark" aria-labelledby="included-heading"><div class="container split"><div><span class="eyebrow">{copy.included.eyebrow[lang]}</span><h2 id="included-heading">{copy.included.heading[lang]}</h2><p class="dark-copy">{copy.included.body[lang]}</p></div><ul class="check-list">{copy.included.items.map(item => <li>{item[lang]}</li>)}</ul></div></section>

  <section aria-labelledby="process-heading"><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.process.eyebrow[lang]}</span><h2 id="process-heading">{copy.process.heading[lang]}</h2><p>{copy.process.body[lang]}</p></div><div class="process-grid">{copy.process.steps.map(item => <article class="process-card"><span class="num">{item.num}</span><h3>{item.title[lang]}</h3><p>{item.body[lang]}</p></article>)}</div></div></section>

  <section class="coach-proof on-white" aria-labelledby="coach-heading"><div class="container proof-grid"><img src={copy.coachProof.image} alt={copy.coachProof.imageAlt[lang]} width="650" height="520" loading="lazy" /><div><span class="eyebrow">{copy.coachProof.eyebrow[lang]}</span><h2 id="coach-heading">{copy.coachProof.heading[lang]}</h2>{copy.coachProof.paragraphs.map(item => <p>{item[lang]}</p>)}<div class="mini-stats">{copy.coachProof.stats.map(item => <div><strong>{item.value}</strong><span>{item.label[lang]}</span></div>)}</div><a href={copy.coachProof.href[lang]} class="text-link">{copy.coachProof.cta[lang]}</a></div></div></section>

  <section aria-labelledby="results-heading"><div class="container"><div class="section-head centered"><span class="eyebrow">{copy.results.eyebrow[lang]}</span><h2 id="results-heading">{copy.results.heading[lang]}</h2><p>{copy.results.body[lang]}</p></div><div class="results-grid">{copy.results.items.map(item => <article class="result-card"><img src={item.image} alt={item.imageAlt[lang]} width="600" height="750" loading="lazy" /><div class="result-copy"><span>{item.meta[lang]}</span><h3>{item.heading[lang]}</h3><p>{item.body[lang]}</p></div></article>)}</div><div class="center-cta"><a href={copy.results.href[lang]} class="btn btn-outline-dark">{copy.results.cta[lang]}</a></div></div></section>

  <TrainingLocation lang="pl" />

  <section class="on-white" aria-labelledby="faq-heading"><div class="container faq-wrap"><div class="section-head centered"><span class="eyebrow">{copy.faq.eyebrow[lang]}</span><h2 id="faq-heading">{copy.faq.heading[lang]}</h2></div><div class="faq-list">{faqs.map(item => <details class="faq-item"><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></div></section>

  <section class="final-cta"><div class="container"><span class="eyebrow light">{copy.finalCta.eyebrow[lang]}</span><h2>{copy.finalCta.heading[lang]}</h2><p>{copy.finalCta.body[lang]}</p><a href={copy.finalCta.href[lang]} class="btn btn-secondary">{copy.finalCta.cta[lang]}</a></div></section>
</BaseLayout>

<style>
  .local-hero { padding: 72px 0; }
  .hero-grid, .proof-grid, .split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .hero-copy h1 { color: var(--white); font-size: clamp(2.2rem, 5vw, 4.1rem); max-width: 12ch; margin-bottom: 18px; }
  .hero-copy .lead { color: #D3D6DA; font-size: 1.12rem; max-width: 58ch; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 30px 0 24px; }
  .trust-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .trust-row span { border: 1px solid #3B4048; border-radius: 999px; padding: 7px 11px; color: #D9DCE0; font-size: 0.78rem; }
  .hero-media img { width: 100%; max-height: 620px; object-fit: cover; object-position: center top; border-radius: var(--radius); border: 1px solid #363A40; }
  .three-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .info-card, .process-card { background: var(--white); border: 1px solid #E2E4E7; border-radius: var(--radius); padding: 28px 24px; }
  .info-card { border-top: 3px solid var(--red); }
  .info-card h3, .process-card h3 { font-size: 1.08rem; margin-bottom: 10px; }
  .info-card p, .process-card p { color: var(--steel); font-size: 0.94rem; }
  .dark-copy { color: #C0C4CA; max-width: 58ch; }
  .check-list { list-style: none; display: grid; gap: 12px; }
  .check-list li { position: relative; padding: 13px 16px 13px 44px; background: #202329; border: 1px solid #333840; border-radius: var(--radius); color: #F1F2F4; }
  .check-list li::before { content: '✓'; position: absolute; left: 16px; color: #E25766; font-weight: 800; }
  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .process-card .num { display: block; color: var(--red); font-weight: 800; font-size: 0.82rem; margin-bottom: 12px; letter-spacing: 0.08em; }
  .coach-proof img { width: 100%; border-radius: var(--radius); }
  .proof-grid p { color: var(--steel); margin-bottom: 14px; }
  .mini-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 24px 0 18px; }
  .mini-stats div { border-top: 3px solid var(--red); background: #F3F4F6; padding: 14px 10px; text-align: center; }
  .mini-stats strong { display: block; color: var(--red); font-size: clamp(1rem, 2vw, 1.35rem); white-space: normal; line-height: 1.1; }
  .mini-stats span { display: block; color: var(--steel); text-transform: uppercase; font-size: 0.64rem; margin-top: 7px; letter-spacing: 0.04em; }
  .text-link { color: var(--red); font-weight: 700; text-decoration: none; }
  .results-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 920px; margin: 0 auto; }
  .result-card { background: var(--white); border: 1px solid #E2E4E7; border-radius: var(--radius); overflow: hidden; }
  .result-card img { width: 100%; height: auto; }
  .result-copy { padding: 22px; }
  .result-copy > span { color: var(--red); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; }
  .result-copy h3 { margin: 8px 0; font-size: 1.05rem; }
  .result-copy p { color: var(--steel); font-size: 0.9rem; }
  .center-cta { text-align: center; margin-top: 34px; }
  .faq-wrap { max-width: 860px; }
  .faq-list { border-top: 1px solid #D8DBDE; }
  .faq-item { border-bottom: 1px solid #D8DBDE; padding: 18px 0; }
  .faq-item summary { font-weight: 700; cursor: pointer; list-style: none; padding-right: 34px; position: relative; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; position: absolute; right: 4px; color: var(--red); font-size: 1.25rem; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { color: var(--steel); margin-top: 10px; padding-right: 34px; }
  .final-cta { background: var(--red); color: var(--white); text-align: center; padding: 88px 0; }
  .final-cta .eyebrow.light { color: #FFDDE1; }
  .final-cta h2 { color: var(--white); max-width: 720px; margin: 0 auto 14px; }
  .final-cta p { color: #F5DADD; max-width: 62ch; margin: 0 auto 28px; }
  @media (max-width: 900px) { .hero-grid, .proof-grid, .split { grid-template-columns: 1fr; gap: 34px; } .three-grid { grid-template-columns: 1fr; } .process-grid { grid-template-columns: repeat(2, 1fr); } .hero-copy h1 { max-width: none; } }
  @media (max-width: 620px) { .local-hero { padding: 48px 0 56px; } .hero-copy h1 { font-size: clamp(2.05rem, 10vw, 2.8rem); } .hero-copy .lead { font-size: 1rem; } .hero-actions { display: grid; grid-template-columns: 1fr; } .hero-actions .btn { width: 100%; } .trust-row { display: grid; grid-template-columns: 1fr; } .trust-row span { text-align: center; } .process-grid, .results-grid { grid-template-columns: 1fr; } .mini-stats { gap: 6px; } .mini-stats div { padding: 12px 5px; } .mini-stats strong { font-size: 0.96rem; } .mini-stats span { font-size: 0.56rem; } }
</style>

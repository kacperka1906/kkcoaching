---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ResourceArticleBody from '../../../components/ResourceArticleBody.astro';
import resources from '../../../data/resources-v1.json';

export function getStaticPaths() {
  return resources.articles
    .filter(article => article.enabled)
    .map(article => ({ params: { slug: article.slug.pl }, props: { article } }));
}

const { article } = Astro.props;
const path = `/pl/resources/${article.slug.pl}`;
const altPath = `/resources/${article.slug.en}`;
const url = `https://kkcoaching.fit${path}`;
const image = article.image.startsWith('http') ? article.image : `https://kkcoaching.fit${article.image}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      '@id': `${url}#article`,
      headline: article.title.pl,
      description: article.seoDescription.pl,
      image: [image],
      datePublished: article.published,
      dateModified: article.updated,
      mainEntityOfPage: { '@type': 'WebPage', '@id': url },
      author: {
        '@type': 'Person',
        '@id': 'https://kkcoaching.fit/#kacper-kaszowski',
        name: 'Kacper Kaszowski',
        url: 'https://kkcoaching.fit/pl/about'
      },
      publisher: {
        '@type': 'Organization',
        '@id': 'https://kkcoaching.fit/#business',
        name: 'KK Coaching',
        url: 'https://kkcoaching.fit/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://kkcoaching.fit/pl' },
        { '@type': 'ListItem', position: 2, name: 'Poradniki', item: 'https://kkcoaching.fit/pl/resources' },
        { '@type': 'ListItem', position: 3, name: article.title.pl }
      ]
    }
  ]
};
---
<BaseLayout
  title={article.seoTitle.pl}
  description={article.seoDescription.pl}
  lang="pl"
  path={path}
  altPath={altPath}
  structuredData={structuredData}
  socialImage={article.image}
  socialImageAlt={article.imageAlt.pl}
  ogType="article"
  articlePublishedTime={article.published}
  articleModifiedTime={article.updated}
>
  <ResourceArticleBody lang="pl" article={article} />
</BaseLayout>
